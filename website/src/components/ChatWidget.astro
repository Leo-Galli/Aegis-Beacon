  /** Answer a question from the curated bank when it matches; null otherwise. */
  function bankAnswer(query: string): { text: string; sources: string[] } | null {
    const lower = query.toLowerCase();
    for (const entry of ANSWER_BANK) {
      if (!entry.match.test(lower)) continue;
      const isItalian = IT_WORDS_RE.test(query);
      return { text: isItalian ? entry.it : entry.en, sources: entry.sources };
    }
    return null;
  }

