<!--
  ChatWidget.astro

  Floating chat assistant that runs a small LLM entirely in the browser via
  WebLLM (@mlc-ai/web-llm) on WebGPU: no API keys, no backend, no paid
  services. Answers are grounded in the project wiki through a lightweight
  retrieval step over /wiki-index.json (a build-time index of every wiki
  page). Model weights are fetched from Hugging Face once and cached by the
  browser.
-->
<div class="ac-chat" data-ac-chat>
  <!-- Floating launcher -->
  <button
    type="button"
    class="ac-fab"
    id="ac-fab"
    aria-label="Open chat with the Aegis assistant"
    aria-expanded="false"
    aria-controls="ac-panel"
  >
    <svg class="ac-fab__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
    </svg>
    <svg class="ac-fab__close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
  </button>

  <!-- Chat panel -->
  <section class="ac-panel" id="ac-panel" role="dialog" aria-label="Aegis assistant chat" hidden>
    <div class="ac-panel__accent" aria-hidden="true"></div>

    <header class="ac-head">
      <div class="ac-head__brand">
        <span class="ac-mark" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none" />
            <path d="M7.6 16.4a6.2 6.2 0 0 1 0-8.8M16.4 7.6a6.2 6.2 0 0 1 0 8.8M4.9 19.1a10.3 10.3 0 0 1 0-14.2M19.1 4.9a10.3 10.3 0 0 1 0 14.2" />
          </svg>
        </span>
        <div class="ac-head__titles">
          <span class="ac-name">Aegis Assistant</span>
          <span class="ac-status" role="status" aria-live="polite">
            <span class="ac-dot" data-dot aria-hidden="true"></span>
            <span data-status>Local model</span>
          </span>
        </div>
      </div>
      <div class="ac-head__tools">
        <button type="button" class="ac-close" id="ac-close" aria-label="Close chat">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
    </header>

    <div class="ac-modelbar">
      <label class="ac-modelbar__field" for="ac-model">
        <span class="ac-modelbar__label">Model</span>
        <span class="ac-modelbar__selectwrap">
          <select id="ac-model" aria-label="Choose the local model size">
            <option value="Qwen2.5-0.5B-Instruct-q4f16_1-MLC">Balanced, 0.5B (~400 MB)</option>
            <option value="SmolLM2-360M-Instruct-q4f16_1-MLC">Fast, 360M (~160 MB)</option>
            <option value="SmolLM2-1.7B-Instruct-q4f16_1-MLC">Smarter, 1.7B (~800 MB)</option>
            <option value="Phi-4-mini-instruct-q4f16_1-MLC">Strong, 3.8B (~2.6 GB)</option>
          </select>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </span>
      </label>
      <span class="ac-privacy">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
        On-device, nothing leaves your browser
      </span>
    </div>

    <div class="ac-progress" id="ac-progress" hidden>
      <div class="ac-progress__track" aria-hidden="true"><div class="ac-progress__bar" data-progress-bar></div></div>
      <p class="ac-progress__text" data-progress-text>Preparing the model</p>
    </div>

    <div class="ac-messages" id="ac-messages" data-messages></div>

    <footer class="ac-composer">
      <div class="ac-composer__error" id="ac-error" hidden></div>
      <div class="ac-composer__row">
        <textarea
          id="ac-input"
          rows="1"
          placeholder="Ask about the Aegis-Beacon..."
          aria-label="Message the assistant"
        ></textarea>
        <button type="button" class="ac-send" id="ac-send" aria-label="Send message" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m4 12 16-7-5.5 15-3.5-7-7-1Z" />
          </svg>
        </button>
        <button type="button" class="ac-stop" id="ac-stop" aria-label="Stop generating" hidden>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="3" /></svg>
        </button>
      </div>
    </footer>
  </section>
</div>

<style is:global>
  /* ============================================================
     Aegis Assistant chat widget (global, class names are unique).
     ============================================================ */
  .ac-chat [hidden] { display: none !important; }

  /* Launcher */
  .ac-fab {
    position: fixed;
    right: 24px;
    bottom: 84px;
    z-index: 300;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--primary) 55%, transparent);
    background: linear-gradient(160deg, var(--primary), var(--primary-hover));
    color: var(--primary-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-glow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }
  .ac-fab:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
  .ac-fab:active { transform: translateY(0); }
  .ac-fab[aria-expanded="true"] { transform: rotate(90deg); }
  .ac-fab__close { display: none; }
  .ac-fab[aria-expanded="true"] .ac-fab__icon { display: none; }
  .ac-fab[aria-expanded="true"] .ac-fab__close { display: block; }

  /* Panel */
  .ac-panel {
    position: fixed;
    right: 24px;
    bottom: 152px;
    z-index: 300;
    width: min(400px, calc(100vw - 2rem));
    max-height: min(660px, calc(100vh - 172px));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--card);
    color: var(--card-foreground);
    border: 1px solid var(--border-strong);
    border-radius: 18px;
    box-shadow: var(--shadow-lg);
    animation: acIn 0.2s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  @keyframes acIn {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
  .ac-panel__accent {
    height: 3px;
    flex: none;
    background: linear-gradient(90deg, var(--primary), color-mix(in srgb, var(--primary) 45%, var(--warning)), transparent 90%);
  }

  /* Header */
  .ac-head {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 0.9rem 0.6rem;
  }
  .ac-head__brand { display: flex; align-items: center; gap: 0.65rem; min-width: 0; }
  .ac-mark {
    flex: none;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    color: var(--primary-foreground);
    background: linear-gradient(145deg, var(--primary), color-mix(in srgb, var(--primary) 70%, var(--primary-hover)));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 30%, transparent), var(--shadow-sm);
  }
  .ac-head__titles { display: flex; flex-direction: column; min-width: 0; }
  .ac-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    color: var(--foreground);
    line-height: 1.2;
  }
  .ac-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.15rem;
    font-size: 0.6875rem;
    color: var(--muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ac-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--muted-foreground);
    transition: background-color 0.2s ease;
  }
  .ac-dot--ok { background: var(--success); box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 18%, transparent); }
  .ac-dot--busy { background: var(--primary); animation: acPulse 1.2s ease-in-out infinite; }
  .ac-dot--err { background: var(--destructive); box-shadow: 0 0 0 3px color-mix(in srgb, var(--destructive) 15%, transparent); }
  @keyframes acPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
  .ac-close {
    flex: none;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 9px;
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .ac-close:hover { color: var(--foreground); background: var(--muted); }

  /* Model bar */
  .ac-modelbar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0.9rem 0.65rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 11px;
    background: color-mix(in srgb, var(--muted) 45%, transparent);
  }
  .ac-modelbar__field { display: inline-flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .ac-modelbar__label {
    font-size: 0.6875rem;
    color: var(--muted-foreground);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .ac-modelbar__selectwrap { position: relative; display: inline-flex; align-items: center; }
  .ac-modelbar__selectwrap svg {
    position: absolute;
    right: 8px;
    pointer-events: none;
    color: var(--muted-foreground);
  }
  #ac-model {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--foreground);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.3rem 1.5rem 0.3rem 0.55rem;
    max-width: 190px;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  #ac-model:hover, #ac-model:focus { border-color: var(--primary); }
  .ac-privacy {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.656rem;
    color: var(--muted-foreground);
    white-space: nowrap;
  }
  .ac-privacy svg { flex: none; color: var(--success); }

  /* Progress */
  .ac-progress { flex: none; padding: 0.25rem 0.9rem 0.7rem; }
  .ac-progress__track {
    height: 4px;
    border-radius: 999px;
    background: var(--muted);
    overflow: hidden;
  }
  .ac-progress__bar {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--primary), color-mix(in srgb, var(--primary) 55%, var(--warning)));
    transition: width 0.25s ease;
  }
  .ac-progress__text {
    margin-top: 0.35rem;
    font-size: 0.656rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
  }

  /* Messages */
  .ac-messages {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.35rem 0.9rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }
  .ac-msg {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: 100%;
    animation: acMsgIn 0.18s ease-out;
  }
  @keyframes acMsgIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }
  .ac-msg--user { flex-direction: row-reverse; }
  .ac-avatar {
    flex: none;
    width: 24px;
    height: 24px;
    margin-top: 0.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: var(--primary-foreground);
    background: linear-gradient(145deg, var(--primary), color-mix(in srgb, var(--primary) 70%, var(--primary-hover)));
  }
  .ac-msg__body { display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem; min-width: 0; max-width: 100%; }
  .ac-msg--user .ac-msg__body { align-items: flex-end; }
  .ac-bubble {
    padding: 0.55rem 0.8rem;
    border-radius: 4px 14px 14px 14px;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--foreground);
    background: var(--muted);
    border: 1px solid var(--border);
    white-space: pre-wrap;
    word-wrap: break-word;
    overflow-wrap: anywhere;
    max-width: min(30rem, 100%);
  }
  .ac-msg--user .ac-bubble {
    border-radius: 14px 14px 4px 14px;
    color: var(--primary-foreground);
    background: linear-gradient(145deg, var(--primary), color-mix(in srgb, var(--primary) 78%, var(--primary-hover)));
    border-color: transparent;
  }
  .ac-msg--assistant .ac-bubble { border-top-left-radius: 4px; }

  /* Typing dots */
  .ac-bubble.ac-typing { display: inline-flex; align-items: center; gap: 4px; padding: 0.7rem 0.85rem; }
  .ac-typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted-foreground);
    animation: acBounce 1.2s ease-in-out infinite;
  }
  .ac-typing span:nth-child(2) { animation-delay: 0.15s; }
  .ac-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes acBounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  /* Sources */
  .ac-sources { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; }
  .ac-sources__label {
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-right: 0.1rem;
  }
  .ac-source {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.18rem 0.55rem;
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--primary);
    border: 1px solid color-mix(in srgb, var(--primary) 35%, var(--border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--primary) 6%, var(--card));
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .ac-source:hover { border-color: var(--primary); background: color-mix(in srgb, var(--primary) 12%, var(--card)); }
  .ac-source svg { flex: none; opacity: 0.7; }

  /* Suggestions */
  .ac-sugg {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.15rem;
    padding-left: 2.05rem;
  }
  .ac-sugg__label { font-size: 0.68rem; color: var(--muted-foreground); }
  .ac-sugg__list { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .ac-sugg__btn {
    font: inherit;
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--foreground);
    background: var(--card);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.32rem 0.75rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, transform 0.12s ease;
  }
  .ac-sugg__btn:hover { border-color: var(--primary); color: var(--primary); }
  .ac-sugg__btn:active { transform: scale(0.98); }

  /* Composer */
  .ac-composer {
    flex: none;
    border-top: 1px solid var(--border);
    padding: 0.7rem 0.9rem 0.8rem;
    background: var(--card);
  }
  .ac-composer__error {
    margin-bottom: 0.6rem;
    padding: 0.55rem 0.75rem;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--foreground);
    background: color-mix(in srgb, var(--destructive) 7%, var(--card));
    border: 1px solid color-mix(in srgb, var(--destructive) 38%, var(--border));
    border-radius: 11px;
  }
  .ac-composer__error a { color: var(--destructive); text-decoration: underline; text-underline-offset: 2px; }
  .ac-composer__row { display: flex; align-items: flex-end; gap: 0.45rem; }
  #ac-input {
    flex: 1;
    min-width: 0;
    resize: none;
    max-height: 130px;
    padding: 0.55rem 0.8rem;
    font: inherit;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--foreground);
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: 13px;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  #ac-input::placeholder { color: var(--muted-foreground); }
  #ac-input:focus {
    border-color: var(--ring);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ring) 20%, transparent);
  }
  .ac-send {
    flex: none;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 12px;
    color: var(--primary-foreground);
    background: linear-gradient(145deg, var(--primary), color-mix(in srgb, var(--primary) 75%, var(--primary-hover)));
    cursor: pointer;
    transition: opacity 0.15s ease, transform 0.12s ease;
  }
  .ac-send:hover:not(:disabled) { transform: translateY(-1px); }
  .ac-send:disabled { opacity: 0.4; cursor: not-allowed; }
  .ac-stop {
    flex: none;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--destructive);
    background: var(--card);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .ac-stop:hover { background: var(--muted); }

  @media (max-width: 560px) {
    .ac-fab { right: 16px; bottom: 76px; }
    .ac-panel {
      right: 12px;
      left: 12px;
      width: auto;
      bottom: 142px;
      max-height: calc(100vh - 156px);
    }
    .ac-sugg { padding-left: 0; }
    .ac-privacy { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ac-panel, .ac-msg { animation: none; }
    .ac-dot--busy, .ac-typing span { animation: none; }
  }

  @media print {
    .ac-chat { display: none !important; }
  }
</style>

<script>
  // ---------------------------------------------------------------------------
  // Aegis Assistant chat widget.
  //
  // 1. UI: floating launcher opens a panel with chat, model picker and states.
  // 2. Inference: a small LLM runs fully in the browser through WebLLM on
  //    WebGPU (library loaded lazily). No API keys, no backend.
  // 3. Grounding: before answering, a lightweight retrieval pass searches the
  //    build-time /wiki-index.json and the best matching pages are added to
  //    the model context as reference notes, with source chips shown in the
  //    reply so users can open the actual documentation.
  // ---------------------------------------------------------------------------

  type EngineHandle = any;

  interface WikiEntry {
    id: string;
    title: string;
    group: string;
    description: string;
    snippet: string;
  }

  interface IndexedEntry extends WikiEntry {
    titleTokens: Set<string>;
    bodyTokens: Set<string>;
  }

  const MODELS: { id: string; label: string; maxTokens: number; temperature: number }[] = [
    // Balanced (Qwen2.5 0.5B) is the default: it follows instructions and
    // multilingual requests far better than the smaller model while staying
    // light enough for a first download of a few hundred MB.
    { id: 'Qwen2.5-0.5B-Instruct-q4f16_1-MLC', label: 'Balanced', maxTokens: 320, temperature: 0.5 },
    { id: 'SmolLM2-360M-Instruct-q4f16_1-MLC', label: 'Fast', maxTokens: 240, temperature: 0.35 },
    { id: 'SmolLM2-1.7B-Instruct-q4f16_1-MLC', label: 'Smarter', maxTokens: 480, temperature: 0.6 },
    { id: 'Phi-4-mini-instruct-q4f16_1-MLC', label: 'Strong', maxTokens: 640, temperature: 0.6 },
  ];

  // Curated hub pages used when a question matches nothing (for example a
  // question in a language other than English): they cover the most asked
  // topics, so the model still gets useful context to answer from.
  const FALLBACK_HUBS = ['project-overview', 'project-history', 'faq', 'quick-start-guide', 'configuration-reference'];

  const SUGGESTIONS = [
    'Who created Aegis-Beacon?',
    'What is the total cost to build one?',
    'How do I set the transmit frequency?',
    'Why does it use 433 MHz?',
  ];

  const STOPWORDS = new Set(
    'the a an and or of to for in on is are was be by with at from as about into over after under again further then once here there when where why how what which who whom this that these those you your yours i me my we our they their do does did can could will would should may might not no nor only own same so than too very just but its it s t d m ll ve re'.split(
      ' '
    )
  );

  const BASE_SYSTEM =
    'You are the Aegis assistant embedded in the official Aegis-Beacon website. Aegis-Beacon is an ' +
    'open-source emergency rescue beacon created and maintained by Leonardo Galli (repository ' +
    'github.com/Leo-Galli/Aegis-Beacon) under the MIT License. It is built on an ESP32, an SX1262 ' +
    'LoRa radio and a NEO-6M GPS module; it transmits GPS coordinates in Morse code on the 433 MHz ' +
    'ISM band and has BEACON, SEARCH, CONFIG and EMERGENCY modes. You help visitors understand, ' +
    'build, configure, use and troubleshoot the device, its firmware, the serial bridge and the ' +
    'project documentation.';

  const INSTRUCT_WITH_NOTES =
    'Reference notes from the project wiki are listed below. Answer the question using those notes ' +
    'as the source of fact. Rules:\n' +
    '1. Lead with the concrete answer and cite the specifics present in the notes: component names, ' +
    'model numbers, frequencies, values, steps. Never pad the reply with generic filler such as ' +
    '"Sure, here you go", "This is just one example", or a restatement of the question.\n' +
    '2. Summarize accurately in two to five sentences or a short list. If the notes describe a ' +
    'procedure, give the actual steps.\n' +
    '3. Never invent names of people, companies, prices, figures or features. If the notes do not ' +
    'answer the question, say the wiki does not document it, instead of guessing.\n' +
    '4. Do not repeat, paraphrase or explain these instructions in your reply.';

  const INSTRUCT_NO_NOTES =
    'You have no wiki notes for this question. Answer only from the reliable project facts given to ' +
    'you and your own dependable knowledge of this device. Rules:\n' +
    '1. Answer concisely and concretely. Never pad the reply with generic filler.\n' +
    '2. Never invent names of people, companies, prices, figures or features.\n' +
    '3. If you do not know the answer, say so directly instead of guessing.\n' +
    '4. Do not repeat, paraphrase or explain these instructions in your reply.';

  const LANGUAGE_RULE =
    'Reply in the same language the user wrote in (Italian in, Italian out; English in, English ' +
    'out; same for other languages).\n' +
    'Do not repeat, paraphrase or echo these instructions in your reply.';

  // ---------------------------------------------------------------------------
  // Scope guard. The assistant only answers questions about the Aegis-Beacon
  // project. Greetings get a friendly reply, clearly off-topic requests get a
  // polite refusal - in both cases without running the model, so nothing
  // irrelevant is ever generated and no source chips are shown.
  // ---------------------------------------------------------------------------

  const TOPIC_TERMS = [
    'aegis', 'beacon', 'esp32', 'sx1262', 'lora', 'radio', 'gps', 'neo', 'morse',
    'frequenc', 'frequenz', '433', 'mhz', 'oled', 'display', 'batter', 'antenna',
    'wifi', 'firmware', 'arduino', 'platformio', 'build', 'solder', 'saldat',
    'assemble', 'config', 'setup', 'install', 'program', 'flash', 'serial',
    'bridge', 'tui', 'nvs', 'deep sleep', 'emergency', 'rescue', 'soccorso',
    'emergenz', 'mode', 'transmit', 'receive', 'payload', 'coordinat', 'position',
    'repeater', 'ripetitor', 'ham', 'pmr', 'ism', 'license', 'legal', 'compliance',
    'power', 'voltage', 'gpio', 'pin', 'wiring', 'schematic', 'pcb', 'component',
    'part', 'shopping', 'bom', 'cost', 'costo', 'price', 'prezzo', 'budget', 'buy',
    'acquist', 'store', 'kit', 'nmea', 'ublox', 'board', 'devkit', 'library',
    'button', 'key', 'case', 'enclosure', 'print', 'swr', 'watt', 'dbm', 'erp',
    'current', 'amp', 'mah', 'lipo', '18650', 'charger', 'protect', 'regulator',
    'ams1117', 'wiki', 'documentation', 'manual', 'guide', 'tutorial', 'help',
    'project', 'progetto', 'device', 'dispositivo', 'modulo', 'scheda', 'frequenza',
    'alimentazione', 'montaggio', 'configurazione', 'batteria', 'segnale',
    'trasmissione', 'ricezione', 'posizione', 'comprare', 'montar', 'costruir',
    'python', 'creator', 'founder', 'autore', 'creatore', 'fondatore',
    'who created', 'who founded', 'who made', 'who built', 'who is behind',
    'chi ha creato', 'chi ha fondato', 'chi ha fatto', 'chi ha realizzato',
  ];

  const TOPIC_RE = new RegExp(`(${TOPIC_TERMS.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'i');

  // Words that point at generic software/web/math requests rather than the
  // beacon. If one of these appears and no strong hardware term is present,
  // the question is treated as off-topic even if a loose term like
  // "component" or "python" also matched.
  const OFFTOPIC_TERMS = [
    'react', 'javascript', 'typescript', 'python', 'html', 'css', 'sql', 'database',
    'npm', 'node', 'docker', 'kubernetes', 'git', 'excel', 'word', 'math', 'poem',
    'poetry', 'story', 'recipe', 'song', 'joke', 'resume', 'cv', 'cover letter',
    'interview', 'essay', 'translate', 'translation', 'homework', 'school', 'game', 'chess',
  ];
  const OFFTOPIC_RE = new RegExp(`\\b(${OFFTOPIC_TERMS.join('|')})\\b`, 'i');

  // Strong beacon hardware terms. Their presence makes a question on-topic
  // even if an off-topic signal also matched (e.g. "python bridge").
  const CORE_TERMS = [
    'aegis', 'beacon', 'esp32', 'sx1262', 'lora', 'radio', 'gps', 'neo', 'morse',
    'frequenc', 'frequenz', '433', 'mhz', 'oled', 'batter', 'antenna', 'wifi',
    'firmware', 'arduino', 'platformio', 'serial', 'bridge', 'tui', 'nvs',
    'emergency', 'emergenz', 'rescue', 'soccorso', 'repeater', 'ripetitor', 'ham',
    'pmr', 'ism', 'nmea', 'ublox', 'config', 'coordinat', 'posizione', 'payload',
    'transmit', 'transmis', 'ricezion', 'sx1262',
  ];
  const CORE_RE = new RegExp(`\\b(${CORE_TERMS.join('|')})`, 'i');

  const GREETING_RE =
    /^(hi|hello|hey|yo|ciao|salve|buongiorno|buonasera|buon pomeriggio|good morning|good afternoon|good evening|hola|hallo|bonjour)\b/i;

  const GREETING_REPLY =
    'Hi! Ask me anything about the Aegis-Beacon: building it, configuring it, using it, its ' +
    'firmware, radio, GPS, power, or the project wiki.';

  const EN_SCOPE_REPLY =
    "I only answer questions about the Aegis-Beacon: building it, configuring it, using it, its " +
    'firmware, radio, GPS, power, or the project wiki. For example, ask "How do I set the ' +
    'transmit frequency?" or "What is the total cost to build one?". For anything else, a web ' +
    'search is the better tool.';

  const IT_SCOPE_REPLY =
    "Rispondo solo a domande sull'Aegis-Beacon: costruirlo, configurarlo, usarlo, il firmware, la " +
    'radio, il GPS, l\'alimentazione o la wiki del progetto. Per esempio: "Come imposto la ' +
    'frequenza di trasmissione?" oppure "Quanto costa costruirne uno?". Per altre richieste, ' +
    'usa un motore di ricerca.';

  const IT_WORDS_RE = /\b(chi|cosa|come|quanto|quale|quali|quando|dove|perche|perché|fare|posso|devo|vorrei|può|puo|il|la|un|una|con|senza|per|di|mi)\b/i;

  // Questions that ask what the device or project itself is get the overview
  // pages guaranteed in the notes, so the model answers from fact. Questions
  // that carry a concrete sub-topic (frequency, antenna, a mode...) keep their
  // own retrieved pages instead.
  const IDENTITY_PHRASES = [
    'what is', 'what are', 'what does it do', 'what does the device do',
    'what is it', 'describe the device', 'what is this', 'cos e', "cos'è",
    'cosè', 'cosa e', 'che cos', 'cosa fa', 'che cosa fa', 'panoramica', 'overview',
  ];
  const IDENTITY_PAGES = ['project-overview', 'quick-start-guide', 'system-architecture'];

  const SUBTOPIC_RE =
    /\b(frequenc|antenna|gps|batter|mode|config|interval|power|cost|price|build|solder|wiring|pin|board|radio|tx|rx|squelch|menu|vol|wpm|display|oled|chip|module|firmware|serial|bridge|nvs|wifi|flash|protocol|payload|morse)\b/i;

  function classifyQuery(query: string): 'topic' | 'greeting' | 'offtopic' {
    const t = query.trim();
    if (!t) return 'offtopic';
    if (t.length <= 30 && GREETING_RE.test(t)) return 'greeting';
    if (!TOPIC_RE.test(t)) return 'offtopic';
    if (OFFTOPIC_RE.test(t) && !CORE_RE.test(t)) return 'offtopic';
    return 'topic';
  }

  function scopeReply(query: string): string {
    return IT_WORDS_RE.test(query) ? IT_SCOPE_REPLY : EN_SCOPE_REPLY;
  }

  function steerIdentityPages(query: string, hits: IndexedEntry[]): IndexedEntry[] {
    const lower = query.toLowerCase();
    if (!IDENTITY_PHRASES.some((p) => lower.includes(p))) return hits;
    const explicitDevice = /(aegis-beacon|aegis beacon|the beacon|dispositivo)/.test(lower);
    if (SUBTOPIC_RE.test(lower) && !explicitDevice) return hits;
    const out: IndexedEntry[] = [];
    if (index && index.length > 0) {
      for (const id of IDENTITY_PAGES) {
        const found = index.find((e) => e.id === id);
        if (found) out.push(found);
      }
    }
    for (const hit of hits) {
      if (!out.some((o) => o.id === hit.id)) out.push(hit);
    }
    return out.slice(0, 3);
  }

  const MAX_HISTORY = 10;
  const STORAGE_KEY = 'aegis-chat-model-v2';
  const INDEX_URL = '/wiki-index.json';

  const fab = document.getElementById('ac-fab') as HTMLButtonElement | null;
  const panel = document.getElementById('ac-panel') as HTMLElement | null;
  const messagesEl = document.getElementById('ac-messages') as HTMLElement | null;
  const inputEl = document.getElementById('ac-input') as HTMLTextAreaElement | null;
  const sendBtn = document.getElementById('ac-send') as HTMLButtonElement | null;
  const stopBtn = document.getElementById('ac-stop') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('ac-close') as HTMLButtonElement | null;
  const statusEl = document.querySelector<HTMLElement>('[data-status]');
  const dotEl = document.querySelector<HTMLElement>('[data-dot]');
  const progressEl = document.getElementById('ac-progress') as HTMLElement | null;
  const progressBar = document.querySelector<HTMLElement>('[data-progress-bar]');
  const progressText = document.querySelector<HTMLElement>('[data-progress-text]');
  const errorEl = document.getElementById('ac-error') as HTMLElement | null;
  const modelSelect = document.getElementById('ac-model') as HTMLSelectElement | null;

  let engine: EngineHandle | null = null;
  let state: 'idle' | 'loading' | 'ready' | 'generating' | 'error' = 'idle';
  let history: { role: 'user' | 'assistant'; content: string }[] = [];
  let pendingMessage: string | null = null;
  let open = false;
  let index: IndexedEntry[] | null = null;
  let suggestionsGone = false;

  const AVATAR_HTML =
    '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none" /><path d="M7.6 16.4a6.2 6.2 0 0 1 0-8.8M16.4 7.6a6.2 6.2 0 0 1 0 8.8" /></svg>';

  // ---- small helpers -------------------------------------------------------

  function setStatus(text: string, dot: 'ok' | 'busy' | 'err' = 'busy'): void {
    if (statusEl) statusEl.textContent = text;
    if (dotEl) {
      dotEl.classList.remove('ac-dot--ok', 'ac-dot--busy', 'ac-dot--err');
      dotEl.classList.add(dot === 'ok' ? 'ac-dot--ok' : dot === 'err' ? 'ac-dot--err' : 'ac-dot--busy');
    }
  }

  function setState(next: typeof state): void {
    state = next;
    if (sendBtn) sendBtn.disabled = !(next === 'ready' || next === 'generating' || next === 'error');
    if (stopBtn) stopBtn.hidden = next !== 'generating';
    if (progressEl) progressEl.hidden = next !== 'loading';
    if (next === 'ready') {
      if (progressBar) progressBar.style.width = '0%';
      if (progressText) progressText.textContent = 'Preparing the model';
