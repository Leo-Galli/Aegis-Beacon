  // ---- wiki retrieval ------------------------------------------------------

  function tokenize(text: string): string[] {
    const out = new Set<string>();
    for (const token of text
      .toLowerCase()
      .normalize('NFKD')
      .replace(/[^\p{L}\p{N}]+/gu, ' ')
      .split(/\s+/)
      .filter(Boolean)) {
      if (token.length > 2 && !STOPWORDS.has(token)) out.add(token);
    }
    return [...out];
  }

  async function ensureIndex(): Promise<void> {
    if (index) return;
    try {
      const res = await fetch(INDEX_URL, { cache: 'force-cache' });
      if (!res.ok) return;
      const raw = (await res.json()) as WikiEntry[];
      index = raw.map((entry) => ({
        ...entry,
        titleTokens: new Set(tokenize(`${entry.title} ${entry.id.replace(/[-_]/g, ' ')}`)),
        bodyTokens: new Set(tokenize(`${entry.description} ${entry.group} ${entry.snippet}`)),
      }));
    } catch {
      index = [];
    }
  }

  // Questions about who created, founded, maintains or authored the project.
  // When detected, the pages that actually state authorship are added to the
  // reference notes so the model answers from fact instead of guessing names.
  const AUTHOR_PHRASES = [
    'who created', 'who founded', 'who is behind', 'who made', 'who built', 'who maintains',
    'creator of', 'founder of', 'created by', 'founded by', 'authored by', 'made by', 'built by',
    'who started', 'chi ha creato', 'chi ha fondato', 'chi ha fatto', 'chi ha realizzato',
    'chi e dietro', 'chi è dietro', 'creatore di', 'fondatore di', 'creato da', 'fondato da',
  ];
  const AUTHOR_PAGES = ['project-history', 'acknowledgements'];

  function wantsAuthorInfo(query: string): boolean {
    const lower = query.toLowerCase();
    if (AUTHOR_PHRASES.some((p) => lower.includes(p))) return true;
    return /(creat|founder|author|autore|creatore|fondatore)/i.test(lower) && lower.includes('?');
  }

  function steerAuthorPages(hits: IndexedEntry[]): IndexedEntry[] {
    const out: IndexedEntry[] = [];
    if (index && index.length > 0) {
      for (const id of AUTHOR_PAGES) {
        const found = index.find((e) => e.id === id);
        if (found) out.push(found);
      }
    }
    for (const hit of hits) {
      if (!out.some((o) => o.id === hit.id)) out.push(hit);
    }
    return out.slice(0, 3);
  }

  /** True when two words are equal or share a long enough stem (helps matching
   *  across languages, e.g. "frequenza" vs "frequency"). */
  function wordsMatch(a: string, b: string): boolean {
    if (a === b) return true;
    if (a.length < 6 || b.length < 6) return false;
    let n = 0;
    const max = Math.min(a.length, b.length);
    while (n < max && a[n] === b[n]) n += 1;
    return n >= 6;
  }

  function retrieve(query: string): IndexedEntry[] {
    if (!index || index.length === 0) return [];
    const qTokens = tokenize(query);
    if (qTokens.length === 0) return [];
    const scored: { score: number; entry: IndexedEntry }[] = [];
    for (const entry of index) {
      let bodyHits = 0;
      let titleHits = 0;
      for (const qt of qTokens) {
        let body = false;
        let title = false;
        for (const et of entry.bodyTokens) {
          if (wordsMatch(qt, et)) {
            body = true;
            break;
          }
        }
        for (const et of entry.titleTokens) {
          if (wordsMatch(qt, et)) {
            title = true;
            break;
          }
        }
        if (body) bodyHits += 1;
        if (title) titleHits += 1;
      }
      if (bodyHits + titleHits === 0) continue;
      if (bodyHits < 2 && titleHits === 0) continue;
      const score = bodyHits * 2 + titleHits * 4;
      scored.push({ score, entry });
    }
    scored.sort((a, b) => b.score - a.score);
    return scored.slice(0, 3).map((s) => s.entry);
  }

  function buildReferenceNotes(query: string): { notes: string; hits: IndexedEntry[] } {
    let hits = retrieve(query);
    const wantsFacts = query.includes('?') || query.trim().length >= 18;
    if (hits.length === 0 && wantsFacts && index && index.length > 0) {
      const hubs: IndexedEntry[] = [];
      for (const id of FALLBACK_HUBS) {
        const found = index.find((e) => e.id === id);
        if (found) hubs.push(found);
      }
      hits = hubs.slice(0, 3);
    }
    if (hits.length > 0 && wantsAuthorInfo(query)) hits = steerAuthorPages(hits);
    if (hits.length > 0) hits = steerIdentityPages(query, hits);
    if (hits.length === 0) return { notes: '', hits };
    const parts = hits.map((hit, i) => {
      const where = hit.group ? `${hit.group} wiki group` : 'the wiki';
      const head = hit.description ? `${hit.description} ` : '';
      const body = hit.snippet.length > 520 ? `${hit.snippet.slice(0, 519)}...` : hit.snippet;
      return `[${i + 1}] Page "${hit.title}" (${where}). ${head}${body}`;
    });
    return { notes: parts.join('\n\n'), hits };
  }

  // ---- engine lifecycle ----------------------------------------------------

  async function loadEngine(modelId: string): Promise<void> {
    hideError();
    setState('loading');
    const label = MODELS.find((m) => m.id === modelId)?.label.toLowerCase() ?? 'local';
    setStatus(`Loading the ${label} model...`);

    const gpu = (navigator as unknown as { gpu?: unknown }).gpu;
    if (!gpu) {
      setState('error');
      setStatus('WebGPU not available', 'err');
      showError(
        'This chat needs WebGPU to run the model on your device. Open the site in a recent Chrome, ' +
          'Edge or Opera on desktop, or Chrome on Android, then reload. ' +
          '<a href="https://developer.mozilla.org/en-US/docs/Web/API/WebGPU_API" target="_blank" rel="noopener noreferrer">Learn about WebGPU</a>.'
      );
      return;
    }

    try {
      const webllm = await import('@mlc-ai/web-llm');
      if (engine) {
        await engine.reload(modelId);
      } else {
        engine = await webllm.CreateMLCEngine(modelId, {
          initProgressCallback: (report: { progress: number; text: string }) => {
            const pct = Math.min(99, Math.round(report.progress * 100));
            if (progressBar) progressBar.style.width = `${pct}%`;
            const hasText = String(report.text || '').trim().length > 0;
            if (progressText) progressText.textContent = hasText ? `Downloading model ${pct}%` : `Preparing ${pct}%`;
            setStatus(`Downloading model ${pct}%`);
          },
        });
      }
      setState('ready');
      setStatus('Local model ready', 'ok');
      if (progressBar) progressBar.style.width = '100%';
      if (pendingMessage) {
        const msg = pendingMessage;
        pendingMessage = null;
        void send(msg);
      }
    } catch (err) {
      console.error('WebLLM init failed:', err);
      const msg = String((err as Error)?.message ?? err);
      setState('error');
      setStatus('Model unavailable', 'err');
      if (/shader-f16|ShaderF16SupportError/i.test(msg)) {
        showError(
          'This browser exposes WebGPU but lacks the shader-f16 extension the model needs. Use Chrome ' +
            'or Edge 113 or newer on desktop, then reload the page. ' +
            '<a href="https://webllm.mlc.ai/docs/#webgpu-browser-support" target="_blank" rel="noopener noreferrer">WebGPU browser support</a>.'
        );
      } else {
        showError(
          'The local model could not be loaded. The download may have been interrupted or the browser ' +
            'ran out of memory. Try a smaller model from the list, then reload the page.'
        );
      }
    }
  }

  // ---- chat -----------------------------------------------------------------

  async function send(text: string): Promise<void> {
    const trimmed = text.trim();
    if (!trimmed || state === 'generating') return;
    if (inputEl) inputEl.value = '';
    autoSize();
    hideError();

    // Scope guard: greetings and clearly off-topic requests are answered
    // directly without running the model, so the assistant never generates
    // unrelated content and no source chips are shown for them.
    const kind = classifyQuery(trimmed);
    if (kind !== 'topic') {
      if (!suggestionsGone) {
        suggestionsGone = true;
        messagesEl?.querySelector('.ac-sugg')?.remove();
      }
      addUserMessage(trimmed);
      const { bubble } = addAssistantBubble();
      bubble.textContent = kind === 'greeting' ? GREETING_REPLY : scopeReply(trimmed);
      return;
    }

    if (state !== 'ready') {
      pendingMessage = trimmed;
      if (state === 'loading') return;
      if (state === 'idle' || state === 'error') {
        if (!suggestionsGone) {
          suggestionsGone = true;
          messagesEl?.querySelector('.ac-sugg')?.remove();
        }
        addUserMessage(trimmed);
        void loadEngine(modelSelect?.value ?? readModel());
      }
      return;
    }

    if (!suggestionsGone) {
      suggestionsGone = true;
      messagesEl?.querySelector('.ac-sugg')?.remove();
    }
    history = [...history, { role: 'user' as const, content: trimmed }].slice(-MAX_HISTORY);
    addUserMessage(trimmed);

    setState('generating');
    setStatus('Searching the wiki...');
    await ensureIndex();
    const { notes, hits } = buildReferenceNotes(trimmed);

    setStatus('Thinking...');
    const { body, bubble } = addAssistantBubble();
    startTyping(bubble);
    let full = '';

    try {
      const system = notes
        ? `${BASE_SYSTEM}\n\n${INSTRUCT_WITH_NOTES}\n\nReference notes:\n${notes}\n\n${LANGUAGE_RULE}`
        : `${BASE_SYSTEM}\n\n${INSTRUCT_NO_NOTES}\n\n${LANGUAGE_RULE}`;
      const messages = [
        { role: 'system', content: system },
        ...history.map((h) => ({ role: h.role, content: h.content })),
      ];
      const cfg = MODELS.find((m) => m.id === modelSelect?.value) ?? MODELS[0];
      const chunks = await engine.chat.completions.create({
        messages,
        stream: true,
        temperature: cfg.temperature,
        max_tokens: cfg.maxTokens,
      });
      for await (const chunk of chunks) {
        const delta = chunk?.choices?.[0]?.delta?.content;
        if (typeof delta === 'string' && delta.length > 0) {
          full += delta;
          if (bubble.classList.contains('ac-typing')) {
            bubble.classList.remove('ac-typing');
            bubble.textContent = '';
          }
          bubble.textContent = full;
          scrollMessages();
        }
      }
    } catch (err) {
      console.error('Generation failed:', err);
      if (!full) bubble.remove();
    }

    if (full.trim()) {
      history = [...history, { role: 'assistant' as const, content: full }].slice(-MAX_HISTORY);
      if (hits.length > 0) renderSources(body, hits);
    }
    setState('ready');
    setStatus('Local model ready', 'ok');
  }

  function stop(): void {
    try {
      engine?.interruptGenerate();
    } catch {
      /* ignore */
    }
  }

  // ---- open / close ---------------------------------------------------------

  function openChat(): void {
    if (!panel || !fab) return;
    open = true;
    panel.hidden = false;
    fab.setAttribute('aria-expanded', 'true');
    fab.setAttribute('aria-label', 'Close chat with the Aegis assistant');
    if (modelSelect) modelSelect.value = readModel();
    window.setTimeout(() => inputEl?.focus(), 120);
    if (state === 'idle') void loadEngine(modelSelect?.value ?? readModel());
    void ensureIndex();
  }

  function closeChat(): void {
    if (!panel || !fab) return;
    open = false;
    panel.hidden = true;
    fab.setAttribute('aria-expanded', 'false');
    fab.setAttribute('aria-label', 'Open chat with the Aegis assistant');
  }

  // ---- events ---------------------------------------------------------------

  fab?.addEventListener('click', () => (open ? closeChat() : openChat()));
  closeBtn?.addEventListener('click', closeChat);

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && open) closeChat();
  });

  sendBtn?.addEventListener('click', () => {
    void send(inputEl?.value ?? '');
  });

  stopBtn?.addEventListener('click', stop);

  inputEl?.addEventListener('input', autoSize);
  inputEl?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      void send(inputEl.value);
    }
  });

  modelSelect?.addEventListener('change', () => {
    persistModel();
    if (state === 'loading') return;
    void loadEngine(modelSelect.value);
  });

  messagesEl?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Tab' && e.shiftKey && open && inputEl) {
      e.preventDefault();
      inputEl.focus();
    }
  });

  // ---- persistence ------------------------------------------------------------

  function persistModel(): void {
    try {
      localStorage.setItem(STORAGE_KEY, modelSelect?.value ?? MODELS[0].id);
    } catch {
      /* private mode: ignore */
    }
  }

  function readModel(): string {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved && MODELS.some((m) => m.id === saved)) return saved;
    } catch {
      /* ignore */
    }
    return MODELS[0].id;
  }

  // ---- init -----------------------------------------------------------------

  if (modelSelect) modelSelect.value = readModel();
  setState('idle');
  setStatus('Local model', 'busy');
  renderGreeting();
</script>