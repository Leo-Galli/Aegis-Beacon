---
import type { CollectionEntry } from 'astro:content';
import { groupForPage } from '../lib/wiki-nav';

interface Props {
  entries: CollectionEntry<'wiki'>[];
  placeholder?: string;
  size?: 'md' | 'lg';
}

const { entries, placeholder = 'Search all documentation...', size = 'md' } = Astro.props;

const index = entries.map((e) => ({
  id: e.id,
  title: e.data.title,
  description: (e.data.description || '').replace(/\s+/g, ' ').trim(),
  group: groupForPage(e.id)?.label ?? '',
}));
---

<div class:list={['wiki-search', size === 'lg' ? 'wiki-search--lg' : '']} data-wiki-search>
  <svg class="wiki-search__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="11" cy="11" r="7" />
    <path d="M21 21l-4.35-4.35" />
  </svg>
  <input
    class="wiki-search__input"
    type="search"
    role="combobox"
    aria-expanded="false"
    aria-controls="wiki-search-results"
    aria-label="Search the wiki"
    placeholder={placeholder}
    autocomplete="off"
    spellcheck="false"
  />
  <span class="wiki-search__kbd" aria-hidden="true">/</span>
  <div class="wiki-search__results" id="wiki-search-results" role="listbox" hidden></div>
  <script type="application/json" is:inline set:html={JSON.stringify(index)}></script>
</div>

<script>
  const boxes = document.querySelectorAll<HTMLElement>('[data-wiki-search]');
  if (boxes.length) {
    boxes.forEach((box) => {
      const dataScript = box.querySelector<HTMLScriptElement>('script[type="application/json"]');
      let items: { id: string; title: string; description: string; group: string }[] = [];
      try {
        items = JSON.parse(dataScript?.textContent || '[]');
      } catch {
        items = [];
      }

      const input = box.querySelector<HTMLInputElement>('input');
      const results = box.querySelector<HTMLElement>('.wiki-search__results');
      const kbd = box.querySelector<HTMLElement>('.wiki-search__kbd');
      if (!input || !results) return;

      const escapeRx = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

      // Highlight every occurrence of any query term, longest first.
      function hlAll(text: string, terms: string[]): Node {
        const frag = document.createDocumentFragment();
        const live = terms.filter((t) => t.length > 0);
        if (!live.length) return document.createTextNode(text);
        const re = new RegExp(
          live.map(escapeRx).sort((a, b) => b.length - a.length).join('|'),
          'gi'
        );
        let last = 0;
        let m: RegExpExecArray | null;
        while ((m = re.exec(text)) !== null) {
          if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
          const mark = document.createElement('mark');
          mark.textContent = m[0];
          frag.appendChild(mark);
          last = m.index + m[0].length;
        }
        if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
        return frag;
      }

      // A short excerpt around the body match (or the start of the description),
      // always cut on word boundaries so it reads naturally.
      function makeSnippet(desc: string, ql: string): string {
        const d = desc;
        const i = d.toLowerCase().indexOf(ql);
        if (i < 0) {
          return d.length > 150 ? d.slice(0, 150).replace(/\s+\S*$/, '') + ' …' : d;
        }
        let start = Math.max(0, i - 55);
        if (start > 0) {
          const sp = d.indexOf(' ', start);
          start = sp >= 0 ? sp + 1 : start;
        }
        let end = Math.min(d.length, i + ql.length + 95);
        if (end < d.length) {
          const sp = d.lastIndexOf(' ', end);
          if (sp > start) end = sp;
        }
        const prefix = start > 0 ? '… ' : '';
        const suffix = end < d.length ? ' …' : '';
        return prefix + d.slice(start, end).trim() + suffix;
      }

      function render(q: string) {
        const ql = q.trim().toLowerCase();
        if (!ql) {
          results.hidden = true;
          results.innerHTML = '';
          input.setAttribute('aria-expanded', 'false');
          return;
        }
        const qWords = ql.split(/\s+/).filter(Boolean);
        const inBody = (it: { title: string; description: string }, qw: string) =>
          it.description.toLowerCase().includes(qw);
        const inTitle = (it: { title: string; description: string }, qw: string) =>
          it.title.toLowerCase().includes(qw);
        const titleStarts = (it: { title: string; description: string }, qw: string) =>
          it.title.toLowerCase().startsWith(qw);

        const scored = items.map((it) => {
          if (titleStarts(it, ql)) {
            return { ...it, s: inBody(it, ql) ? 110 : 100, why: inBody(it, ql) ? 'title+body' : 'title' };
          }
          if (inTitle(it, ql) && inBody(it, ql)) return { ...it, s: 90, why: 'title+body' };
          if (inBody(it, ql)) return { ...it, s: 70, why: 'body' };
          if (inTitle(it, ql)) return { ...it, s: 50, why: 'title' };
          if (qWords.every((w) => it.title.toLowerCase().includes(w))) return { ...it, s: 40, why: 'title-phrase' };
          if (qWords.some((w) => it.title.toLowerCase().includes(w))) return { ...it, s: 25, why: 'title-word' };
          return { ...it, s: 0, why: '' };
        });

        const ranked = scored
          .filter((it) => it.s > 0)
          .sort((a, b) => b.s - a.s || a.title.localeCompare(b.title));

        if (!ranked.length) {
          results.hidden = false;
          results.innerHTML = '';
          const boxEl = document.createElement('div');
          boxEl.className = 'wiki-search__empty';
          const p = document.createElement('p');
          p.appendChild(document.createTextNode('No pages match "'));
          const strong = document.createElement('strong');
          strong.textContent = q.trim();
          p.appendChild(strong);
          p.appendChild(document.createTextNode('".'));
          const hint = document.createElement('p');
          hint.className = 'wiki-search__hint';
          hint.textContent = 'Check the spelling, or try a broader term such as battery, Morse, GPS, antenna or serial.';
          boxEl.appendChild(p);
          boxEl.appendChild(hint);
          results.appendChild(boxEl);
          input.setAttribute('aria-expanded', 'true');
          return;
        }

        // Total hits per wiki section, so each heading can carry its count.
        const totals = new Map<string, number>();
        for (const r of ranked) {
          const key = r.group || 'Documentation';
          totals.set(key, (totals.get(key) || 0) + 1);
        }

        // Keep relevance order, but group each section's hits under one heading.
        const frag = document.createDocumentFragment();
        let emitted = 0;
        let budget = 24;
        const seen = new Set<string>();
        for (const r of ranked) {
          if (budget <= 0) break;
          const key = r.group || 'Documentation';
          if (!seen.has(key)) {
            seen.add(key);
            if (emitted > 0) {
              const divider = document.createElement('div');
              divider.className = 'wiki-search__divider';
              frag.appendChild(divider);
            }
            const head = document.createElement('div');
            head.className = 'wiki-search__section';
            const label = document.createElement('span');
            label.className = 'wiki-search__section-label';
            label.textContent = key;
            const count = document.createElement('span');
            count.className = 'wiki-search__section-count';
            count.textContent = String(totals.get(key) ?? 0);
            head.appendChild(label);
            head.appendChild(count);
            frag.appendChild(head);
          }
          budget -= 1;
          emitted += 1;

          const a = document.createElement('a');
          a.href = `/wiki/${r.id}`;
          a.className = 'wiki-search__result';
          a.setAttribute('role', 'option');

          const title = document.createElement('span');
          title.className = 'wiki-search__title';
          title.appendChild(hlAll(r.title, qWords));
          a.appendChild(title);

          // Every result shows a short page description, so each entry is a
          // self-contained block you can tell apart from the neighbours.
          if (r.description) {
            // Body matches get an excerpt around the matched words; other
            // matches get the start of the description. Both identify the page.
            const text = makeSnippet(r.description, ql);
            const desc = document.createElement('span');
            desc.className = 'wiki-search__desc';
            desc.appendChild(hlAll(text, qWords));
            a.appendChild(desc);
          }

          frag.appendChild(a);
        }
        results.innerHTML = '';
        results.appendChild(frag);
        results.hidden = false;
        input.setAttribute('aria-expanded', 'true');
      }

      function move(dir: number) {
        const opts = [...results.querySelectorAll<HTMLElement>('.wiki-search__result')];
        if (!opts.length) return;
        const cur = results.querySelector<HTMLElement>('.is-selected');
        let idx = cur ? opts.indexOf(cur) : -1;
        idx = (idx + dir + opts.length) % opts.length;
        opts.forEach((o) => o.classList.remove('is-selected'));
        opts[idx].classList.add('is-selected');
        opts[idx].scrollIntoView({ block: 'nearest' });
      }

      function go() {
        const sel = results.querySelector<HTMLElement>('.is-selected');
        const target = sel || results.querySelector<HTMLElement>('.wiki-search__result');
        if (target) window.location.href = target.getAttribute('href') || '/wiki';
      }

      input.addEventListener('input', () => render(input.value));
      input.addEventListener('focus', () => input.value && render(input.value));
      input.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape') {
          results.hidden = true;
          input.setAttribute('aria-expanded', 'false');
          input.blur();
        } else if (ev.key === 'ArrowDown') {
          ev.preventDefault();
          move(1);
        } else if (ev.key === 'ArrowUp') {
          ev.preventDefault();
          move(-1);
        } else if (ev.key === 'Enter') {
          ev.preventDefault();
          go();
        }
      });

      document.addEventListener('click', (ev) => {
        if (!box.contains(ev.target as Node)) {
          results.hidden = true;
          input.setAttribute('aria-expanded', 'false');
        }
      });

      // Global "/" shortcut focuses the search, unless typing in another field.
      document.addEventListener('keydown', (ev) => {
        const tag = (ev.target as HTMLElement)?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || (ev.target as HTMLElement)?.isContentEditable) return;
        if (ev.key === '/') {
          ev.preventDefault();
          input.focus();
          input.select();
        }
      });

      if (kbd) kbd.textContent = '/';
    });
  }
</script>

<style is:global>
  /* is:global: rows are built at runtime by the script, so scoped
     selectors (which require [data-astro-cid]) would never match them. */
  .wiki-search {
    position: relative;
    width: 100%;
    max-width: 30rem;
  }
  .wiki-search--lg { max-width: 40rem; margin-inline: auto; }
  .wiki-search__icon {
    position: absolute; left: 1rem; top: 50%; transform: translateY(-50%);
    color: var(--muted-foreground); pointer-events: none;
  }
  .wiki-search__input {
    width: 100%; padding: 0.72rem 2.75rem 0.72rem 2.5rem;
    font: inherit; font-size: 0.9rem; color: var(--foreground);
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius-lg); transition: all 0.15s;
  }
  .wiki-search__input::placeholder { color: var(--muted-foreground); }
  .wiki-search__input:focus {
    outline: none; border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 18%, transparent);
  }
  .wiki-search__kbd {
    position: absolute; right: 0.85rem; top: 50%; transform: translateY(-50%);
    font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted-foreground);
    border: 1px solid var(--border); border-radius: var(--radius-sm);
    padding: 0.1rem 0.45rem; background: var(--muted); pointer-events: none;
  }

  .wiki-search__results {
    position: absolute; top: calc(100% + 0.4rem); left: 0; right: 0; z-index: 60;
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);
    overflow-y: auto; max-height: min(460px, 62vh);
    padding: 0.45rem;
  }

  /* Section headings mirror the wiki sidebar taxonomy */
  .wiki-search__section {
    display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem;
    padding: 0.5rem 0.65rem 0.35rem;
    font-size: 0.625rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.07em;
    color: var(--muted-foreground);
  }
  .wiki-search__divider {
    height: 1px; margin: 0.3rem 0.4rem;
    background: color-mix(in srgb, var(--border) 70%, transparent);
  }

  /* One result = one page: a clear title over a short description block.
     A hairline between consecutive results keeps page boundaries obvious
     within a section, so each entry reads as its own block. */
  .wiki-search__result {
    display: block; padding: 0.55rem 0.65rem;
    border-radius: var(--radius-md); text-decoration: none;
    color: var(--foreground); outline: none;
    transition: background 0.12s;
  }
  .wiki-search__result + .wiki-search__result {
    border-top: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
    border-radius: 0;
  }
  .wiki-search__result:hover,
  .wiki-search__result.is-selected { background: var(--muted); }
  .wiki-search__result:hover + .wiki-search__result,
  .wiki-search__result.is-selected + .wiki-search__result { border-top-color: transparent; }
  .wiki-search__result:focus-visible {
    background: var(--muted);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--primary) 55%, transparent);
  }
  .wiki-search__title {
    display: block; font-size: 0.86rem; font-weight: 650; line-height: 1.4;
  }
  .wiki-search__desc {
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
    overflow: hidden; margin-top: 0.2rem;
    font-size: 0.74rem; color: var(--muted-foreground); line-height: 1.55;
    overflow-wrap: break-word;
  }
  .wiki-search mark {
    background: color-mix(in srgb, var(--primary) 26%, transparent);
    color: inherit; border-radius: 2px; padding: 0 1px;
  }

  .wiki-search__empty { padding: 0.75rem 0.85rem; }
  .wiki-search__empty p { margin: 0; font-size: 0.82rem; color: var(--muted-foreground); }
  .wiki-search__empty strong { color: var(--foreground); font-weight: 600; }
  .wiki-search__hint { margin-top: 0.35rem !important; font-size: 0.75rem !important; line-height: 1.5; }
</style>
