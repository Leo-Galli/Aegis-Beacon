---
interface Props {
  variant?: 'dialog' | 'stage'
  chromeTitle?: string
}

const { variant = 'dialog', chromeTitle = 'aegis-serial-bridge.py' } = Astro.props
---

<div class={`demo-laptop-mock demo-laptop-mock--${variant}`}>
  <div class="demo-laptop-mock__unit">
    <div class="demo-laptop-mock__lid">
      <div class="demo-laptop-mock__bezel">
        {variant !== 'stage' && <span class="demo-laptop-mock__webcam" aria-hidden="true"></span>}
        <div class="demo-laptop-mock__screen">
          <div class="demo-laptop__chrome demo-laptop__chrome--host">
            {variant === 'stage' ? (
              <>
                <span class="demo-laptop__chrome-tab" aria-hidden="true">bridge TUI</span>
                <span class="demo-laptop__title">{chromeTitle}</span>
              </>
            ) : (
              <>
                <span class="demo-laptop__chrome-os" aria-hidden="true"></span>
                <span class="demo-laptop__title">{chromeTitle}</span>
                <span class="demo-laptop__chrome-spacer" aria-hidden="true"></span>
              </>
            )}
          </div>
          <div class="demo-laptop-mock__terminal-wrap">
            <div class="demo-bridge-launch" aria-hidden="true">
              <span class="demo-bridge-launch__user">PS C:\Aegis-Beacon\bridge&gt;</span>
              <span class="demo-bridge-launch__cmd">python aegis-serial-bridge.py</span>
              <span class="demo-bridge-launch__flag">:menu · :port COM3</span>
            </div>
            <slot />
          </div>
        </div>
      </div>
    </div>
    {variant === 'stage' ? (
      <div class="demo-laptop-mock__monitor-stand" aria-hidden="true">
        <span class="demo-laptop-mock__neck"></span>
        <span class="demo-laptop-mock__foot"></span>
      </div>
    ) : (
      <>
        <div class="demo-laptop-mock__hinge" aria-hidden="true"></div>
        <div class="demo-laptop-mock__base">
          <div class="demo-laptop-mock__deck">
            <span class="demo-laptop-mock__brand" aria-hidden="true">Host PC · USB serial</span>
            <div class="demo-laptop-mock__keyboard" aria-hidden="true"></div>
            <div class="demo-laptop-mock__trackpad" aria-hidden="true"></div>
          </div>
          <div class="demo-laptop-mock__lip" aria-hidden="true"></div>
        </div>
      </>
    )}
    <span class="demo-laptop-mock__port demo-laptop-mock__port--left" aria-hidden="true">USB-C</span>
  </div>
  <p class="demo-laptop-mock__caption">
    {variant === 'stage'
      ? 'Python serial bridge on your laptop (not on the beacon)'
      : 'Run bridge/aegis-serial-bridge.py on the PC'}
  </p>
</div>
