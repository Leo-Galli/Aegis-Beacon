---
/** Banner-matched handheld shell for the /demo firmware simulation. */
---

<div class="aegis-device-scene" data-rv style="--rv-delay: 0ms">
  <div class="aegis-device-stage">
    <div class="aegis-device-stage__plate" aria-hidden="true"></div>
    <article class="aegis-device" aria-label="Aegis-Beacon hardware simulation">
      <svg class="aegis-device__art" viewBox="0 0 300 540" aria-hidden="true" role="presentation">
        <defs>
          <linearGradient id="ab-shell" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#9ca8b4" stop-opacity="0.92"/>
            <stop offset="35%" stop-color="#7d8996" stop-opacity="0.88"/>
            <stop offset="100%" stop-color="#5c6670" stop-opacity="0.9"/>
          </linearGradient>
          <linearGradient id="ab-shell-hi" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#fff" stop-opacity="0.22"/>
            <stop offset="100%" stop-color="#fff" stop-opacity="0"/>
          </linearGradient>
          <linearGradient id="ab-edge" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#c8d0d8"/>
            <stop offset="100%" stop-color="#3a424a"/>
          </linearGradient>
          <linearGradient id="ab-brass" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f0d080"/>
            <stop offset="45%" stop-color="#c9a227"/>
            <stop offset="100%" stop-color="#8a6914"/>
          </linearGradient>
          <linearGradient id="ab-ant-seg" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#1a1e24"/>
            <stop offset="50%" stop-color="#3a424a"/>
            <stop offset="100%" stop-color="#222830"/>
          </linearGradient>
          <filter id="ab-drop" x="-15%" y="-15%" width="130%" height="130%">
            <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#000" flood-opacity="0.35"/>
          </filter>
        </defs>

        <ellipse cx="150" cy="518" rx="98" ry="9" fill="#000" opacity="0.25"/>

        <!-- Internal PCB ghost (visible through smoke shell) -->
        <g opacity="0.55">
          <rect x="44" y="118" width="212" height="72" rx="4" fill="#142818" stroke="#2a5030" stroke-width="0.6"/>
          <path d="M52 130 H248 M52 145 H220 M52 160 H235 M52 175 H200" stroke="#3d6848" stroke-width="0.5" opacity="0.7"/>
          <rect x="58" y="198" width="36" height="22" rx="2" fill="#1a2428" stroke="#3a4850" stroke-width="0.5"/>
          <rect x="206" y="198" width="36" height="22" rx="2" fill="#1a2428" stroke="#3a4850" stroke-width="0.5"/>
          <circle cx="150" cy="210" r="14" fill="#1a1e22" stroke="#4a525a" stroke-width="0.5"/>
        </g>

        <!-- Side wall -->
        <path d="M30 108 L30 488 Q30 498 40 498 L260 498 Q270 498 270 488 L270 108 Q270 98 260 98 L40 98 Q30 98 30 108 Z" fill="#4a525a" opacity="0.95"/>

        <!-- Front smoke polycarbonate face -->
        <rect x="26" y="102" width="248" height="392" rx="20" ry="20" fill="url(#ab-shell)" filter="url(#ab-drop)"/>
        <rect x="26" y="102" width="248" height="392" rx="20" ry="20" fill="url(#ab-shell-hi)"/>
        <rect x="26" y="102" width="248" height="392" rx="20" ry="20" fill="none" stroke="url(#ab-edge)" stroke-width="1.4"/>

        <!-- Corner reinforcements -->
        <path d="M38 106 Q26 106 26 118" fill="none" stroke="#6a7480" stroke-width="2" opacity="0.5"/>
        <path d="M262 106 Q274 106 274 118" fill="none" stroke="#6a7480" stroke-width="2" opacity="0.5"/>
        <path d="M38 490 Q26 490 26 478" fill="none" stroke="#6a7480" stroke-width="2" opacity="0.5"/>
        <path d="M262 490 Q274 490 274 478" fill="none" stroke="#6a7480" stroke-width="2" opacity="0.5"/>

        <!-- Side grip texture -->
        <g opacity="0.25" fill="#2a3038">
          <rect x="27" y="140" width="3" height="6" rx="0.5"/>
          <rect x="27" y="152" width="3" height="6" rx="0.5"/>
          <rect x="27" y="164" width="3" height="6" rx="0.5"/>
          <rect x="270" y="140" width="3" height="6" rx="0.5"/>
          <rect x="270" y="152" width="3" height="6" rx="0.5"/>
          <rect x="270" y="164" width="3" height="6" rx="0.5"/>
        </g>

        <!-- Stub ribbed antenna + brass SMA (banner style) -->
        <g transform="translate(218 88)">
          <rect x="0" y="18" width="22" height="8" rx="1.5" fill="#2a3038"/>
          <polygon points="2,26 20,26 18,32 4,32" fill="#1a1e24"/>
          <circle cx="11" cy="12" r="10" fill="url(#ab-brass)"/>
          <circle cx="11" cy="12" r="6" fill="#3a3420" stroke="#a08030" stroke-width="0.5"/>
          <g fill="url(#ab-ant-seg)">
            <rect x="9" y="-34" width="4" height="8" rx="1"/>
            <rect x="9" y="-26" width="4" height="8" rx="1" opacity="0.85"/>
            <rect x="9" y="-18" width="4" height="8" rx="1"/>
            <rect x="9" y="-10" width="4" height="8" rx="1" opacity="0.85"/>
            <rect x="9" y="-2" width="4" height="8" rx="1"/>
          </g>
          <ellipse cx="11" cy="-36" rx="2.5" ry="2" fill="#1a1e24"/>
        </g>

        <!-- Top knobs -->
        <circle cx="72" cy="100" r="5" fill="#2a3038" stroke="#4a525a" stroke-width="0.6"/>
        <circle cx="150" cy="98" r="5" fill="#2a3038" stroke="#4a525a" stroke-width="0.6"/>
        <circle cx="188" cy="100" r="4" fill="#2a3038" stroke="#4a525a" stroke-width="0.6"/>

        <!-- OLED recess -->
        <rect x="42" y="128" width="216" height="118" rx="6" fill="#0a0c0e" stroke="#222830" stroke-width="1.2"/>
        <rect x="48" y="134" width="204" height="106" rx="3" fill="#030405"/>
        <rect x="48" y="134" width="204" height="106" rx="3" fill="none" stroke="#fff" stroke-width="0.35" opacity="0.05"/>

        <!-- Button wells -->
        <g fill="#14181c" stroke="#303840" stroke-width="0.8">
          <rect x="40" y="268" width="50" height="50" rx="6"/>
          <rect x="98" y="268" width="50" height="50" rx="6"/>
          <rect x="156" y="268" width="50" height="50" rx="6"/>
          <rect x="214" y="268" width="50" height="50" rx="6"/>
        </g>

        <!-- Speaker grille -->
        <g transform="translate(88 338)">
          <rect x="0" y="0" width="124" height="16" rx="4" fill="#0a0c0e" stroke="#303840" stroke-width="0.7"/>
          <g fill="#252a30">
            <rect x="5" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="10" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="15" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="20" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="25" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="30" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="35" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="40" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="45" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="50" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="55" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="60" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="65" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="70" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="75" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="80" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="85" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="90" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="95" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="100" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="105" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="110" y="5" width="2.5" height="6" rx="0.5"/>
            <rect x="115" y="5" width="2.5" height="6" rx="0.5"/>
          </g>
        </g>

        <!-- LED bezels (TX left, RX right of grille) -->
        <circle cx="68" cy="346" r="7" fill="#0a0c0e" stroke="#303840" stroke-width="0.8"/>
        <circle cx="232" cy="346" r="7" fill="#0a0c0e" stroke="#303840" stroke-width="0.8"/>

        <!-- Hex corner screws -->
        <g fill="#b8c0c8" stroke="#6a7480" stroke-width="0.5">
          <polygon points="44,118 48,116 52,118 52,122 48,124 44,122"/>
          <polygon points="256,118 260,116 264,118 264,122 260,124 256,122"/>
          <polygon points="44,478 48,476 52,478 52,482 48,484 44,482"/>
          <polygon points="256,478 260,476 264,478 264,482 260,484 256,482"/>
        </g>

        <!-- USB-C -->
        <rect x="128" y="486" width="44" height="7" rx="2" fill="#0a0c0e" stroke="#303840" stroke-width="0.6"/>
      </svg>

      <div class="aegis-device__oled-slot">
        <canvas
          id="oled-canvas"
          class="oled-canvas"
          width="512"
          height="256"
          role="img"
          aria-live="polite"
          aria-label="OLED display simulation"
        ></canvas>
        <div class="oled-canvas__glass" aria-hidden="true"></div>
      </div>

      <div class="aegis-device__led-slot aegis-device__led-slot--tx" aria-hidden="true">
        <span class="aegis-device__led aegis-device__led--tx" id="led-tx"></span>
      </div>
      <div class="aegis-device__led-slot aegis-device__led-slot--rx" aria-hidden="true">
        <span class="aegis-device__led aegis-device__led--rx" id="led-rx"></span>
      </div>

      <div class="aegis-device__keys">
        <button class="aegis-key" data-key="mode" type="button" aria-label="MODE button, hold 2 seconds for EMERGENCY">
          <span class="aegis-key__hold" aria-hidden="true"></span>
          <span class="aegis-key__cap">MODE</span>
        </button>
        <button class="aegis-key" data-key="sel" type="button" aria-label="SEL button">
          <span class="aegis-key__cap">SEL</span>
        </button>
        <button class="aegis-key" data-key="up" type="button" aria-label="UP button">
          <span class="aegis-key__cap">UP</span>
        </button>
        <button class="aegis-key" data-key="dn" type="button" aria-label="DN button">
          <span class="aegis-key__cap">DN</span>
        </button>
      </div>

      <p class="aegis-device__toast" id="device-toast" aria-live="polite"></p>
    </article>
  </div>

  <p class="aegis-device__hint">
    MODE short: BEACON / SEARCH toggle (LISTEN/CONFIG to BEACON). <strong>Hold MODE 2 s</strong> for EMERGENCY SOS.
    SEL short: VOL/WPM. SEL hold 3 s: CONFIG.
  </p>
</div>
