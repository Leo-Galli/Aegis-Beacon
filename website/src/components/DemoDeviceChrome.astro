---
import DemoLaptopMockup from './DemoLaptopMockup.astro'

/** Toolbar and mode legend above the handheld mockup on /demo. */
---

<div class="demo-device-column" id="demo-device-column">
  <div class="demo-device-toolbar">
    <div class="demo-device-toolbar__left">
      <span class="demo-device-toolbar__tag">Hardware mockup</span>
      <span class="demo-device-toolbar__live" id="demo-hw-mode-badge">BEACON</span>
    </div>
    <div class="demo-device-toolbar__actions">
      <button
        type="button"
        class="demo-icon-btn demo-toolbar-normal"
        id="demo-listen-pc-btn"
        aria-label="Connect a laptop for LISTEN mode"
        title="LISTEN via USB serial"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2"/>
          <path d="M8 21h8M12 17v4"/>
          <path d="M7 10h2M7 13h6"/>
        </svg>
        <span class="demo-icon-btn__label">LISTEN + PC</span>
      </button>
      <button
        type="button"
        class="demo-icon-btn demo-icon-btn--accent demo-toolbar-normal"
        id="demo-fs-btn"
        aria-label="Open device fullscreen"
        title="Fullscreen"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M8 3H5a2 2 0 00-2 2v3M21 8V5a2 2 0 00-2-2h-3M3 16v3a2 2 0 002 2h3M16 21h3a2 2 0 002-2v-3"/>
        </svg>
        <span class="demo-icon-btn__label">Fullscreen</span>
      </button>
      <button
        type="button"
        class="demo-icon-btn demo-icon-btn--accent demo-toolbar-fs-only"
        id="demo-fs-usb-btn"
        hidden
        aria-label="Connect USB and enter LISTEN mode"
        title="Simulate USB serial bridge"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M12 22v-5"/>
          <path d="M9 17h6"/>
          <rect x="5" y="2" width="14" height="12" rx="2"/>
          <path d="M9 6h.01M12 6h.01M15 6h.01"/>
        </svg>
        <span class="demo-icon-btn__label">Connect USB</span>
      </button>
      <button
        type="button"
        class="demo-icon-btn demo-toolbar-fs-only"
        id="demo-fs-exit"
        hidden
        aria-label="Exit fullscreen"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M8 3v3a2 2 0 01-2 2H3M21 8h-3a2 2 0 01-2-2V3M3 16h3a2 2 0 012 2v3M16 21v-3a2 2 0 012-2h3"/>
        </svg>
        <span class="demo-icon-btn__label">Exit</span>
      </button>
    </div>
  </div>

  <div class="demo-listen-callout" id="demo-listen-callout">
    <div class="demo-listen-callout__icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M12 22a7 7 0 007-7V8l-7-4-7 4v7a7 7 0 007 7z"/>
        <path d="M12 8v4M12 16h.01"/>
      </svg>
    </div>
    <div class="demo-listen-callout__copy">
      <strong>LISTEN is not on the MODE key.</strong>
      <span>Connect USB to a laptop and send <code>MODE LISTEN</code> over serial. MODE short only toggles BEACON / SEARCH.</span>
    </div>
    <button type="button" class="demo-listen-callout__cta" id="demo-listen-callout-btn">Show connection</button>
  </div>

  <div class="demo-fs-body" id="demo-fs-body">
    <div class="demo-device-host" id="demo-device-host">
      <slot />
    </div>

    <div class="demo-fs-connector" id="demo-fs-connector" hidden aria-hidden="true">
      <svg class="demo-fs-connector__cable" viewBox="0 0 120 32" aria-hidden="true">
        <path class="demo-fs-connector__path" d="M8 16 H112" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/>
        <rect class="demo-fs-connector__plug" x="0" y="10" width="10" height="12" rx="2" fill="currentColor"/>
        <rect class="demo-fs-connector__plug" x="110" y="10" width="10" height="12" rx="2" fill="currentColor"/>
      </svg>
      <span class="demo-fs-connector__tag">USB-C · 115200</span>
    </div>

    <aside class="demo-fs-laptop" id="demo-fs-laptop" hidden aria-label="Laptop connected for LISTEN mode">
      <DemoLaptopMockup variant="stage" chromeTitle="PowerShell · aegis-serial-bridge.py">
        <pre class="demo-laptop__terminal demo-laptop__terminal--live" id="demo-fs-terminal"><span class="demo-laptop__line demo-laptop__line--dim">[bridge] COM3 @ 115200 · fw 6.0</span>
<span class="demo-laptop__line demo-laptop__line--dim">AEGIS:HELLO:device=Aegis-Beacon</span>
<span class="demo-laptop__line demo-laptop__line--ok">&gt; MODE LISTEN</span>
<span class="demo-laptop__line">AEGIS:OK:mode=LISTEN</span>
<span class="demo-laptop__line demo-laptop__line--cw" id="demo-fs-cw-stream">AEGIS:CW:...</span></pre>
      </DemoLaptopMockup>
      <p class="demo-fs-laptop__status">Host script sends MODE LISTEN · device decodes CW on OLED + speaker</p>
    </aside>
  </div>
</div>
