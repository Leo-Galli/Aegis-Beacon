---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  slug: string;
}

const { title, description, slug } = Astro.props;

const wikiPages = [
  { id: 'project-overview', title: 'Overview' },
  { id: 'hardware-components', title: 'Hardware' },
  { id: 'gpio-pin-mapping', title: 'GPIO Pin Map' },
  { id: 'rf-design-link-budget', title: 'RF Design' },
  { id: 'antenna-design', title: 'Antenna Design' },
  { id: 'firmware-overview', title: 'Firmware' },
  { id: 'morse-code-engine', title: 'Morse Engine' },
  { id: 'configuration-reference', title: 'Configuration' },
  { id: 'oled-display', title: 'OLED Display' },
  { id: 'gps-integration', title: 'GPS Integration' },
  { id: 'power-management', title: 'Power Management' },
  { id: 'assembly-guide', title: 'Assembly Guide' },
  { id: 'frequency-compatibility', title: 'Frequency Table' },
  { id: 'system-architecture', title: 'System Architecture' },
  { id: 'software-build-process', title: 'Software Build' },
  { id: 'wifi-config-portal', title: 'WiFi Config Portal' },
  { id: 'troubleshooting', title: 'Troubleshooting' },
  { id: 'faq', title: 'FAQ' },
  { id: 'glossary', title: 'Glossary' },
];

const currentIndex = wikiPages.findIndex(p => p.id === slug);
const prevPage = currentIndex > 0 ? wikiPages[currentIndex - 1] : null;
const nextPage = currentIndex < wikiPages.length - 1 ? wikiPages[currentIndex + 1] : null;
---

<Layout title={`${title} | Aegis-Beacon Wiki`} description={description}>
  <div class="wiki-layout">
    <aside class="wiki-sidebar">
      <div class="sidebar-header">Documentation</div>
      <nav class="sidebar-nav">
        {wikiPages.map(page => (
          <a
            href={`/wiki/${page.id}`}
            class:list={['sidebar-link', { active: page.id === slug }]}
          >
            {page.title}
          </a>
        ))}
      </nav>
    </aside>

    <article class="wiki-content">
      <div class="wiki-breadcrumb">
        <a href="/wiki/project-overview">Docs</a>
        <span>/</span>
        <span>{title}</span>
      </div>

      <div class="wiki-header">
        <h1>{title}</h1>
        <a
          href={`https://github.com/Leo-Galli/Aegis-Beacon/edit/main/website/src/content/wiki/${slug}.md`}
          target="_blank"
          rel="noopener"
          class="edit-link"
        >
          Edit on GitHub
        </a>
      </div>

      <div class="prose">
        <slot />
      </div>

      <nav class="wiki-nav">
        {prevPage && (
          <a href={`/wiki/${prevPage.id}`} class="nav-prev">
            <span class="nav-label">Previous</span>
            <span class="nav-title">{prevPage.title}</span>
          </a>
        )}
        {nextPage && (
          <a href={`/wiki/${nextPage.id}`} class="nav-next">
            <span class="nav-label">Next</span>
            <span class="nav-title">{nextPage.title}</span>
          </a>
        )}
      </nav>
    </article>

    <aside class="wiki-toc">
      <div class="toc-header">On this page</div>
      <nav class="toc-list" id="toc"></nav>
    </aside>
  </div>

  <script>
    const toc = document.getElementById('toc');
    if (toc) {
      const headings = document.querySelectorAll('.prose h2, .prose h3');
      headings.forEach(h => {
        if (!h.id) h.id = h.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, '-') || '';
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.className = h.tagName === 'H3' ? 'toc-item toc-indent' : 'toc-item';
        a.textContent = h.textContent || '';
        toc.appendChild(a);
      });

      const items = toc.querySelectorAll('a');
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            items.forEach(l => l.classList.remove('active'));
            const active = toc.querySelector(`a[href="#${entry.target.id}"]`);
            active?.classList.add('active');
          }
        });
      }, { rootMargin: '-80px 0px -80% 0px' });
      headings.forEach(h => observer.observe(h));
    }
  </script>

  <style is:global>
    /* Wiki Prose - Classic Documentation Typography */
    .prose { max-width: 700px; }
    .prose h1 { font-size: 1.75rem; font-weight: 700; line-height: 1.2; margin-bottom: 1rem; padding-bottom: 0.625rem; border-bottom: 1px solid var(--border); }
    .prose h2 { font-size: 1.25rem; font-weight: 700; margin-top: 2rem; margin-bottom: 0.625rem; padding-bottom: 0.375rem; border-bottom: 1px solid var(--border); }
    .prose h3 { font-size: 1rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.5rem; }
    .prose h4 { font-size: 0.9375rem; font-weight: 600; margin-top: 1.25rem; margin-bottom: 0.5rem; }
    .prose p { font-size: 0.9375rem; line-height: 1.75; color: var(--text-secondary); margin-bottom: 0.875rem; }
    .prose strong { color: var(--text); font-weight: 600; }
    .prose a { color: #ea580c; text-decoration: underline; text-decoration-color: rgba(234,88,12,0.3); text-underline-offset: 2px; }
    .dark .prose a { color: #fb923c; }
    .prose a:hover { text-decoration-color: currentColor; }
    .prose ul, .prose ol { padding-left: 1.5rem; margin-bottom: 0.875rem; }
    .prose ul { list-style-type: disc; }
    .prose ol { list-style-type: decimal; }
    .prose li { font-size: 0.9375rem; line-height: 1.7; color: var(--text-secondary); margin-bottom: 0.25rem; }
    .prose li strong { color: var(--text); }
    .prose code { font-family: 'JetBrains Mono', monospace; font-size: 0.8125rem; background: var(--border-subtle); padding: 0.1rem 0.375rem; border-radius: 3px; color: #c2410c; border: 1px solid var(--border); }
    .dark .prose code { background: rgba(30,41,59,0.8); color: #fb923c; }
    .prose pre { background: var(--surface-raised); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; overflow-x: auto; margin: 1rem 0; }
    .prose pre code { background: none; padding: 0; border: none; color: var(--text); font-weight: 400; }
    .prose blockquote { border-left: 3px solid var(--border); padding: 0.625rem 0.875rem; margin: 1rem 0; background: var(--border-subtle); border-radius: 0 6px 6px 0; }
    .prose blockquote p { margin-bottom: 0; font-style: italic; }
    .prose table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.875rem; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .prose thead { background: var(--border-subtle); }
    .prose th { font-weight: 600; text-align: left; padding: 0.625rem 0.875rem; border-bottom: 1px solid var(--border); font-size: 0.8125rem; }
    .prose td { padding: 0.5rem 0.875rem; border-bottom: 1px solid var(--border-subtle); color: var(--text-secondary); }
    .prose tr:last-child td { border-bottom: none; }
    .prose tbody tr:hover td { background: var(--border-subtle); }
    .prose hr { border: none; height: 1px; background: var(--border); margin: 1.5rem 0; }
    .prose img { max-width: 100%; border-radius: 8px; margin: 1rem 0; border: 1px solid var(--border); }
    .prose del { color: var(--text-muted); }
    .prose > :first-child { margin-top: 0; }
    .prose > :last-child { margin-bottom: 0; }

    /* Alerts */
    .prose blockquote:has(strong:first-child) { border-left: 3px solid var(--border); }
  </style>

  <style>
    .wiki-layout {
      display: flex;
      max-width: 1200px;
      margin: 0 auto;
      min-height: calc(100vh - var(--header-h) - 200px);
    }
    .wiki-sidebar {
      display: none;
      width: 220px;
      flex-shrink: 0;
      position: sticky;
      top: var(--header-h);
      height: fit-content;
      max-height: calc(100vh - var(--header-h));
      overflow-y: auto;
      padding: 1.25rem 0;
      border-right: 1px solid var(--border);
    }
    @media (min-width: 1024px) { .wiki-sidebar { display: block; } }
    .sidebar-header {
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      padding: 0 1rem 0.75rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 0.25rem;
    }
    .sidebar-nav { display: flex; flex-direction: column; }
    .sidebar-link {
      display: block;
      padding: 0.375rem 1rem;
      font-size: 0.8125rem;
      color: var(--text-secondary);
      border-left: 2px solid transparent;
      transition: all 0.1s;
    }
    .sidebar-link:hover { color: var(--text); background: var(--border-subtle); }
    .sidebar-link.active { color: var(--text); font-weight: 600; border-left-color: var(--orange); }
    .wiki-content {
      flex: 1;
      min-width: 0;
      padding: 1.5rem 2rem 3rem;
      max-width: 720px;
    }
    @media (max-width: 768px) { .wiki-content { padding: 1rem; } }
    .wiki-breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }
    .wiki-breadcrumb a { color: var(--text-muted); }
    .wiki-breadcrumb a:hover { color: var(--orange); }
    .wiki-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }
    .wiki-header h1 { font-size: 1.75rem; font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; margin: 0; }
    .edit-link {
      font-size: 0.75rem;
      color: var(--text-muted);
      border: 1px solid var(--border);
      padding: 0.375rem 0.75rem;
      border-radius: 6px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .edit-link:hover { color: var(--text); border-color: var(--text-muted); }
    .wiki-toc {
      display: none;
      width: 180px;
      flex-shrink: 0;
      position: sticky;
      top: var(--header-h);
      height: fit-content;
      max-height: calc(100vh - var(--header-h));
      overflow-y: auto;
      padding: 1.5rem 0 1.5rem 1rem;
    }
    @media (min-width: 1280px) { .wiki-toc { display: block; } }
    .toc-header {
      font-size: 0.625rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
    }
    .toc-list { display: flex; flex-direction: column; border-left: 1px solid var(--border); }
    .toc-item {
      display: block;
      padding: 0.25rem 0.625rem;
      font-size: 0.6875rem;
      color: var(--text-muted);
      border-left: 2px solid transparent;
      margin-left: -1px;
      line-height: 1.4;
    }
    .toc-item:hover { color: var(--text); }
    .toc-item.active { color: var(--text); font-weight: 600; border-left-color: var(--orange); }
    .toc-indent { padding-left: 1rem; }
    .wiki-nav {
      display: flex;
      gap: 0.75rem;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
    }
    .nav-prev, .nav-next {
      flex: 1;
      padding: 0.75rem 1rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      transition: border-color 0.15s;
    }
    .nav-prev:hover, .nav-next:hover { border-color: var(--text-muted); }
    .nav-next { text-align: right; }
    .nav-label {
      display: block;
      font-size: 0.625rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 0.125rem;
    }
    .nav-title { font-size: 0.8125rem; font-weight: 600; color: var(--text); }
  </style>
</Layout>
