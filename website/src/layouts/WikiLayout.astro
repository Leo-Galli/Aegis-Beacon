---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  slug: string;
}

const { title, description, slug } = Astro.props;

const wikiPages = [
  { id: 'project-overview', title: 'Overview' },
  { id: 'hardware-components', title: 'Hardware' },
  { id: 'gpio-pin-mapping', title: 'GPIO Pin Map' },
  { id: 'rf-design-link-budget', title: 'RF Design' },
  { id: 'antenna-design', title: 'Antenna Design' },
  { id: 'firmware-overview', title: 'Firmware' },
  { id: 'morse-code-engine', title: 'Morse Engine' },
  { id: 'configuration-reference', title: 'Configuration' },
  { id: 'oled-display', title: 'OLED Display' },
  { id: 'gps-integration', title: 'GPS Integration' },
  { id: 'power-management', title: 'Power Management' },
  { id: 'assembly-guide', title: 'Assembly Guide' },
  { id: 'frequency-compatibility', title: 'Frequency Table' },
  { id: 'system-architecture', title: 'System Architecture' },
  { id: 'software-build-process', title: 'Software Build' },
  { id: 'wifi-config-portal', title: 'WiFi Config Portal' },
  { id: 'troubleshooting', title: 'Troubleshooting' },
  { id: 'faq', title: 'FAQ' },
  { id: 'glossary', title: 'Glossary' },
];

const currentIndex = wikiPages.findIndex(p => p.id === slug);
const prevPage = currentIndex > 0 ? wikiPages[currentIndex - 1] : null;
const nextPage = currentIndex < wikiPages.length - 1 ? wikiPages[currentIndex + 1] : null;
---

<Layout title={`${title} | Aegis-Beacon Wiki`} description={description}>
  <!-- Mobile Nav -->
  <div class="wiki-mobile-nav">
    <div class="wiki-mobile-scroll">
      {wikiPages.map(page => (
        <a
          href={`/wiki/${page.id}`}
          class:list={['wiki-mobile-link', { 'wiki-mobile-active': page.id === slug }]}
        >
          {page.title}
        </a>
      ))}
    </div>
  </div>

  <div class="wiki-layout">
    <!-- Sidebar -->
    <aside class="wiki-sidebar">
      <div class="wiki-sidebar-header">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
        Documentation
      </div>
      <nav class="wiki-nav-list">
        {wikiPages.map(page => (
          <a
            href={`/wiki/${page.id}`}
            class:list={['wiki-nav-link', { 'wiki-nav-active': page.id === slug }]}
          >
            {page.title}
          </a>
        ))}
      </nav>
    </aside>

    <!-- Main Content -->
    <article class="wiki-main">
      <div class="wiki-page-header">
        <div class="wiki-breadcrumb">
          <a href="/wiki/project-overview">Docs</a>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          <span class="wiki-breadcrumb-current">{title}</span>
        </div>
        <div class="wiki-page-title-row">
          <h1 class="wiki-page-title">{title}</h1>
          <a
            href={`https://github.com/Leo-Galli/Aegis-Beacon/edit/main/website/src/content/wiki/${slug}.md`}
            target="_blank"
            rel="noopener"
            class="wiki-edit-link"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Edit on GitHub
          </a>
        </div>
      </div>

      <div class="prose-wiki">
        <slot />
      </div>

      <nav class="wiki-prev-next">
        {prevPage && (
          <a href={`/wiki/${prevPage.id}`} class="wiki-nav-prev">
            <svg class="wiki-nav-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            <div>
              <span class="wiki-nav-label">Previous</span>
              <span class="wiki-nav-title">{prevPage.title}</span>
            </div>
          </a>
        )}
        {nextPage && (
          <a href={`/wiki/${nextPage.id}`} class="wiki-nav-next">
            <div>
              <span class="wiki-nav-label">Next</span>
              <span class="wiki-nav-title">{nextPage.title}</span>
            </div>
            <svg class="wiki-nav-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </a>
        )}
      </nav>
    </article>

    <!-- Right TOC -->
    <aside class="wiki-toc-container">
      <div class="wiki-toc-header">On this page</div>
      <nav class="wiki-toc-list" id="toc"></nav>
    </aside>
  </div>

  <!-- Scroll Progress -->
  <div class="wiki-scroll-progress-bar" id="scroll-progress"></div>

  <script>
    // Build TOC
    const toc = document.getElementById('toc');
    if (toc) {
      const headings = document.querySelectorAll('.prose-wiki h2, .prose-wiki h3');
      headings.forEach(h => {
        if (!h.id) h.id = h.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, '-') || '';
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.className = h.tagName === 'H3' ? 'wiki-toc-item wiki-toc-indent' : 'wiki-toc-item';
        a.textContent = h.textContent || '';
        toc.appendChild(a);
      });
      const items = toc.querySelectorAll('a');
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            items.forEach(l => l.classList.remove('active'));
            const active = toc.querySelector(`a[href="#${entry.target.id}"]`);
            active?.classList.add('active');
          }
        });
      }, { rootMargin: '-80px 0px -80% 0px' });
      headings.forEach(h => observer.observe(h));
    }

    // Scroll progress
    const progressBar = document.getElementById('scroll-progress');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = progress + '%';
      });
    }
  </script>

  <style is:global>
    /* Wiki Layout */
    .wiki-layout { display: flex; gap: 0; max-width: 100%; }

    /* Sidebar */
    .wiki-sidebar {
      display: none; width: 250px; flex-shrink: 0;
      position: sticky; top: var(--header-h); height: calc(100vh - var(--header-h));
      overflow-y: auto; border-right: 1px solid var(--border);
      background: var(--background); padding: 1.25rem 0; z-index: 20;
    }
    @media (min-width: 1024px) { .wiki-sidebar { display: block; } }
    .wiki-sidebar-header {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0 1rem 0.75rem; margin-bottom: 0.25rem;
      border-bottom: 1px solid var(--border);
      font-size: 0.6875rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted-foreground);
    }
    .wiki-nav-list { list-style: none; padding: 0; margin: 0; }
    .wiki-nav-link {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.4rem 1rem; font-size: 0.8125rem;
      color: var(--muted-foreground); text-decoration: none;
      border-left: 2px solid transparent;
      transition: all 0.1s;
    }
    .wiki-nav-link:hover { color: var(--foreground); background: var(--muted); }
    .wiki-nav-active { color: var(--foreground); font-weight: 600; border-left-color: var(--primary); }

    /* Mobile nav */
    .wiki-mobile-nav {
      display: block; position: sticky; top: var(--header-h); z-index: 20;
      background: var(--background); border-bottom: 1px solid var(--border);
      padding: 0.5rem 1rem; overflow-x: auto;
    }
    @media (min-width: 1024px) { .wiki-mobile-nav { display: none; } }
    .wiki-mobile-scroll { display: flex; gap: 0.25rem; width: max-content; }
    .wiki-mobile-link {
      flex-shrink: 0; padding: 0.3rem 0.625rem; font-size: 0.6875rem;
      color: var(--muted-foreground); text-decoration: none; border-radius: var(--radius-sm);
      white-space: nowrap; transition: all 0.1s;
    }
    .wiki-mobile-link:hover { color: var(--foreground); background: var(--muted); }
    .wiki-mobile-active { color: var(--foreground); font-weight: 600; background: var(--muted); }

    /* Main content */
    .wiki-main { flex: 1; min-width: 0; padding: 1.5rem; max-width: 100%; }
    @media (min-width: 768px) { .wiki-main { padding: 2rem 2rem 3rem; } }
    @media (min-width: 1280px) { .wiki-main { padding: 2rem 2.5rem 3rem; } }

    /* Scroll progress */
    .wiki-scroll-progress-bar {
      position: fixed; top: var(--header-h); left: 0; height: 2px;
      background: var(--primary); z-index: 49; transition: width 0.1s linear; width: 0;
    }

    /* Page header */
    .wiki-page-header { margin-bottom: 1.5rem; }
    .wiki-breadcrumb {
      display: flex; align-items: center; gap: 0.375rem;
      font-size: 0.75rem; color: var(--muted-foreground); margin-bottom: 0.75rem;
    }
    .wiki-breadcrumb a { color: var(--muted-foreground); text-decoration: none; transition: color 0.15s; }
    .wiki-breadcrumb a:hover { color: var(--primary); }
    .wiki-breadcrumb-current { color: var(--foreground); font-weight: 500; }
    .wiki-page-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .wiki-page-title { font-size: 1.75rem; font-weight: 700; line-height: 1.2; color: var(--foreground); margin: 0; letter-spacing: -0.02em; }
    .wiki-edit-link {
      display: inline-flex; align-items: center; gap: 0.375rem;
      padding: 0.375rem 0.75rem; font-size: 0.75rem;
      color: var(--muted-foreground); border: 1px solid var(--border);
      border-radius: var(--radius-md); text-decoration: none; white-space: nowrap;
      transition: all 0.15s;
    }
    .wiki-edit-link:hover { color: var(--foreground); border-color: var(--muted-foreground); }

    /* Right TOC */
    .wiki-toc-container {
      display: none; width: 200px; flex-shrink: 0;
      position: sticky; top: var(--header-h);
      height: fit-content; max-height: calc(100vh - var(--header-h) - 2rem);
      overflow-y: auto; padding: 2rem 0 2rem 1.25rem;
    }
    @media (min-width: 1280px) { .wiki-toc-container { display: block; } }
    .wiki-toc-header {
      font-size: 0.625rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; color: var(--muted-foreground); margin-bottom: 0.5rem;
      padding-left: 0.625rem;
    }
    .wiki-toc-list { display: flex; flex-direction: column; border-left: 1px solid var(--border); }
    .wiki-toc-item {
      display: block; padding: 0.25rem 0.625rem; font-size: 0.6875rem;
      color: var(--muted-foreground); text-decoration: none;
      border-left: 2px solid transparent; margin-left: -1px; line-height: 1.4;
      transition: all 0.1s;
    }
    .wiki-toc-item:hover { color: var(--foreground); }
    .wiki-toc-item.active { color: var(--foreground); font-weight: 600; border-left-color: var(--primary); }
    .wiki-toc-indent { padding-left: 1.25rem; }

    /* Prev/Next */
    .wiki-prev-next { display: flex; gap: 0.75rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
    .wiki-nav-prev, .wiki-nav-next {
      display: flex; align-items: center; gap: 0.625rem;
      padding: 0.75rem 1rem; background: var(--card);
      border: 1px solid var(--border); border-radius: var(--radius-lg);
      text-decoration: none; flex: 1; min-width: 0;
      transition: all 0.15s; box-shadow: var(--shadow-sm);
    }
    .wiki-nav-next { justify-content: flex-end; text-align: right; }
    .wiki-nav-prev:hover, .wiki-nav-next:hover { border-color: var(--primary); box-shadow: var(--shadow-md); }
    .wiki-nav-arrow { width: 1rem; height: 1rem; flex-shrink: 0; color: var(--muted-foreground); }
    .wiki-nav-label { display: block; font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted-foreground); }
    .wiki-nav-title { font-size: 0.8125rem; font-weight: 600; color: var(--foreground); }
  </style>
</Layout>
