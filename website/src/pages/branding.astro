---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Branding & Assets | Aegis-Beacon" description="Official Aegis-Beacon logos, colors, typography and usage guidelines for media and documentation">
  <div class="branding-page container">
    <header class="section-head" style="padding-top: clamp(2rem, 4vw, 3rem);">
      <h1 class="section-head__title">Branding & Assets</h1>
      <p class="section-head__lead">
        Official assets and guidelines for referencing Aegis-Beacon. Use these
        when writing about the project, presenting it, or building on the code.
      </p>
    </header>

    <!-- Social banner -->
    <section class="brand-section" data-rv>
      <h2 class="brand-section__title">Social Banner</h2>
      <p class="brand-section__desc">
        The primary banner, used on the repository README, Open Graph cards and
        social sharing. 1376 x 768 px, also available in the repo at
        <code>website/public/banner.png</code>.
      </p>
      <div class="banner-card">
        <img src="/banner.png" width="1376" height="768" alt="Aegis-Beacon banner on a dark graphite background with the beacon mark and signal orange accents" loading="lazy" />
      </div>
      <div class="brand-downloads">
        <a class="btn btn-secondary" href="https://github.com/Leo-Galli/Aegis-Beacon/raw/main/website/public/banner.png" download>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
          Download banner.png
        </a>
        <a class="btn btn-secondary" href="https://github.com/Leo-Galli/Aegis-Beacon/raw/main/website/public/favicon.svg" download>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
          Download favicon.svg
        </a>
      </div>
    </section>

    <!-- Mark -->
    <section class="brand-section" data-rv>
      <h2 class="brand-section__title">Brand Mark</h2>
      <p class="brand-section__desc">
        The mark is a radio beacon mast with an outgoing signal ping. It stands
        for the device's purpose: transmitting a locator signal when no network
        remains. The mark is always drawn in signal orange on the surface it
        sits on; it is never recolored, outlined or rotated.
      </p>

      <div class="mark-grid">
        <div class="mark-card">
          <div class="mark-card__preview mark-card__preview--graphite">
            <svg width="64" height="64" viewBox="0 0 32 32" aria-hidden="true">
              <circle cx="16" cy="12" r="4" fill="currentColor"/>
              <path d="M16 8 L20 14 L12 14 Z" fill="currentColor" opacity="0.6"/>
              <rect x="14.5" y="16" width="3" height="8" rx="1.5" fill="currentColor"/>
              <circle cx="16" cy="12" r="1.5" fill="#0f172a"/>
            </svg>
          </div>
          <div class="mark-card__meta">
            <strong>Primary mark</strong>
            <span>On graphite or dark surfaces</span>
          </div>
        </div>

        <div class="mark-card">
          <div class="mark-card__preview mark-card__preview--signal">
            <svg width="64" height="64" viewBox="0 0 32 32" aria-hidden="true">
              <circle cx="16" cy="12" r="4" fill="#fff"/>
              <path d="M16 8 L20 14 L12 14 Z" fill="#fff" opacity="0.7"/>
              <rect x="14.5" y="16" width="3" height="8" rx="1.5" fill="#fff"/>
              <circle cx="16" cy="12" r="1.5" fill="#e25700"/>
            </svg>
          </div>
          <div class="mark-card__meta">
            <strong>Reversed mark</strong>
            <span>On signal orange or light surfaces</span>
          </div>
        </div>

        <div class="mark-card">
          <div class="mark-card__preview mark-card__preview--light">
            <svg width="64" height="64" viewBox="0 0 32 32" aria-hidden="true">
              <circle cx="16" cy="12" r="4" fill="#e25700"/>
              <path d="M16 8 L20 14 L12 14 Z" fill="#e25700" opacity="0.6"/>
              <rect x="14.5" y="16" width="3" height="8" rx="1.5" fill="#e25700"/>
              <circle cx="16" cy="12" r="1.5" fill="#ffffff"/>
            </svg>
          </div>
          <div class="mark-card__meta">
            <strong>Lockup on light</strong>
            <span>Signal orange on near-white</span>
          </div>
        </div>

        <div class="mark-card">
          <div class="mark-card__preview mark-card__preview--graphite mark-card__preview--word">
            <svg class="mark-card__lockup" viewBox="0 0 120 32" aria-hidden="true">
              <circle cx="16" cy="12" r="4" fill="#fb7500"/>
              <path d="M16 8 L20 14 L12 14 Z" fill="#fb7500" opacity="0.6"/>
              <rect x="14.5" y="16" width="3" height="8" rx="1.5" fill="#fb7500"/>
              <circle cx="16" cy="12" r="1.5" fill="#0c0a09"/>
              <text x="30" y="22" fill="#fafafa" font-family="'Chakra Petch', sans-serif" font-weight="700" font-size="15">Aegis-Beacon</text>
            </svg>
          </div>
          <div class="mark-card__meta">
            <strong>Wordmark lockup</strong>
            <span>Mark + Chakra Petch wordmark</span>
          </div>
        </div>
      </div>

      <div class="brand-alert">
        <p><strong>Usage:</strong> keep clear space around the mark equal to the height of the signal ping. Do not modify, distort, recolor, add shadows to, or place the mark on busy photography.</p>
      </div>
    </section>

    <!-- Colors -->
    <section class="brand-section" data-rv>
      <h2 class="brand-section__title">Color</h2>
      <p class="brand-section__desc">
        The palette is one signal orange plus neutral surfaces. The orange is
        defined in OKLCH in <code>public/css/site.css</code>; the hex values
        below are its sRGB equivalents for use in documents that cannot express
        OKLCH.
      </p>

      <div class="color-grid">
        <div class="color-card">
          <div class="color-swatch" style="background: #e25700;"></div>
          <div class="color-info">
            <strong>Signal orange</strong>
            <code>#E25700</code>
            <code>oklch(0.63 0.2 50)</code>
            <span>Primary accent. Light theme. Buttons, links, active states.</span>
          </div>
        </div>
        <div class="color-card">
          <div class="color-swatch" style="background: #FB7500;"></div>
          <div class="color-info">
            <strong>Signal orange (dark)</strong>
            <code>#FB7500</code>
            <code>oklch(0.71 0.19 50)</code>
            <span>Brightened for dark surfaces. Meets AA on graphite.</span>
          </div>
        </div>
        <div class="color-card">
          <div class="color-swatch" style="background: #0C0A09;"></div>
          <div class="color-info">
            <strong>Graphite</strong>
            <code>#0C0A09</code>
            <code>oklch(0.145 0.004 50)</code>
            <span>Dark theme background. Mission-console surfaces.</span>
          </div>
        </div>
        <div class="color-card">
          <div class="color-swatch" style="background: #FAFAFA;"></div>
          <div class="color-info">
            <strong>Near-white</strong>
            <code>#FAFAFA</code>
            <code>oklch(0.985 0 0)</code>
            <span>Light theme background. Page and card surfaces.</span>
          </div>
        </div>
        <div class="color-card">
          <div class="color-swatch" style="background: #007938;"></div>
          <div class="color-info">
            <strong>Status green</strong>
            <code>#007938</code>
            <span>Success: TX done, fix acquired, OK log lines.</span>
          </div>
        </div>
        <div class="color-card">
          <div class="color-swatch" style="background: #CC2827;"></div>
          <div class="color-info">
            <strong>Status red</strong>
            <code>#CC2827</code>
            <span>Danger: EMERGENCY state, errors, destructive actions.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Typography -->
    <section class="brand-section" data-rv>
      <h2 class="brand-section__title">Typography</h2>
      <p class="brand-section__desc">
        Three self-hosted faces, each with one job. They ship with the site via
        Fontsource, so no external font request is made.
      </p>
      <div class="type-grid">
        <div class="type-card">
          <span class="type-sample type-sample--display">Chakra Petch</span>
          <div class="type-info">
            <strong>Display</strong>
            <span>Headings, brand wordmark, technical UI labels</span>
          </div>
        </div>
        <div class="type-card">
          <span class="type-sample type-sample--body">Manrope</span>
          <div class="type-info">
            <strong>Body</strong>
            <span>Paragraphs, navigation, supporting copy</span>
          </div>
        </div>
        <div class="type-card">
          <span class="type-sample type-sample--mono">JetBrains Mono</span>
          <div class="type-info">
            <strong>Code & data</strong>
            <span>Code blocks, terminal output, frequencies, specs</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Voice -->
    <section class="brand-section" data-rv>
      <h2 class="brand-section__title">Voice</h2>
      <p class="brand-section__desc">
        Write plainly about a serious tool. The beacon is safety equipment for
        mountain and backcountry use; the copy reflects that: direct, specific,
        no hype.
      </p>
      <div class="rules-grid">
        <div class="rule-card rule-card--do">
          <h3>Do</h3>
          <ul>
            <li>Write "Aegis-Beacon" with the hyphen on first reference</li>
            <li>Say what the device does: transmits Morse SOS with position</li>
            <li>Call the firmware a beacon, not a gadget</li>
            <li>Recommend certified PLB/EPIRB gear for life-threatening use</li>
          </ul>
        </div>
        <div class="rule-card rule-card--dont">
          <h3>Do not</h3>
          <ul>
            <li>Shorten to "Aegis" or "Beacon" in prose</li>
            <li>Claim it replaces certified distress beacons</li>
            <li>Use marketing superlatives or emoji</li>
            <li>Imply an endorsement by any SAR organization</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Source -->
    <section class="brand-section" data-rv>
      <h2 class="brand-section__title">Source</h2>
      <p class="brand-section__desc">
        Everything is open source under the MIT license. The banner and mark
        live in the repository; the design tokens live in
        <code>website/public/css/site.css</code>.
      </p>
      <div class="brand-downloads">
        <a class="btn btn-primary" href="https://github.com/Leo-Galli/Aegis-Beacon" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          View the repository
        </a>
        <a class="btn btn-secondary" href="/terms">
          Terms of Service
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .branding-page { padding-bottom: 4rem; }

  .brand-section {
    max-width: 920px;
    margin: 3rem auto 0;
  }
  .brand-section__title {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 0.5rem;
  }
  .brand-section__desc {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }
  .brand-section__desc code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--primary);
    background: var(--muted);
    padding: 0.1rem 0.375rem;
    border-radius: var(--radius-sm);
  }

  /* Banner */
  .banner-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }
  .banner-card img {
    display: block;
    width: 100%;
    height: auto;
  }
  .brand-downloads {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }
  .btn svg { flex-shrink: 0; }

  /* Mark grid */
  .mark-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) { .mark-grid { grid-template-columns: repeat(2, 1fr); } }
  .mark-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .mark-card:hover { border-color: color-mix(in srgb, var(--primary) 35%, var(--border)); box-shadow: var(--shadow-md); }
  .mark-card__preview {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 150px;
    padding: 1.5rem;
    color: #fb7500;
  }
  .mark-card__preview--graphite { background: #0c0a09; }
  .mark-card__preview--signal { background: #e25700; }
  .mark-card__preview--light { background: #fafafa; border-bottom: 1px solid var(--border); }
  .mark-card__lockup { width: 150px; height: auto; }
  .mark-card__meta { padding: 0.75rem 1rem; }
  .mark-card__meta strong {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--foreground);
  }
  .mark-card__meta span {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .brand-alert {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--warning) 6%, var(--background));
    border: 1px solid color-mix(in srgb, var(--warning) 15%, var(--border));
    border-radius: var(--radius-lg);
    font-size: 0.875rem;
    color: var(--warning);
  }
  .brand-alert p { margin: 0; }

  /* Colors */
  .color-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 640px) { .color-grid { grid-template-columns: repeat(2, 1fr); } }
  .color-card {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s;
  }
  .color-card:hover { border-color: color-mix(in srgb, var(--primary) 30%, var(--border)); }
  .color-swatch {
    width: 56px; height: 56px;
    border-radius: var(--radius-md);
    flex-shrink: 0;
    border: 1px solid color-mix(in srgb, var(--foreground) 10%, var(--border));
  }
  .color-info strong {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--foreground);
  }
  .color-info code {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--foreground);
    background: var(--muted);
    padding: 0.1rem 0.375rem;
    border-radius: var(--radius-sm);
    margin-top: 0.125rem;
    margin-right: 0.25rem;
  }
  .color-info span {
    display: block;
    font-size: 0.75rem;
    color: var(--muted-foreground);
    margin-top: 0.125rem;
  }

  /* Typography */
  .type-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) { .type-grid { grid-template-columns: repeat(3, 1fr); } }
  .type-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
  .type-sample { color: var(--foreground); white-space: nowrap; }
  .type-sample--display { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; letter-spacing: 0.01em; }
  .type-sample--body { font-family: var(--font-body); font-weight: 600; font-size: 1.5rem; }
  .type-sample--mono { font-family: var(--font-mono); font-weight: 500; font-size: 1.1rem; }
  .type-info strong {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--foreground);
  }
  .type-info span {
    font-size: 0.75rem;
    color: var(--muted-foreground);
    line-height: 1.5;
  }

  /* Rules */
  .rules-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) { .rules-grid { grid-template-columns: 1fr 1fr; } }
  .rule-card {
    padding: 1.25rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
  }
  .rule-card h3 {
    font-size: 0.9375rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .rule-card ul {
    padding-left: 1.25rem;
    list-style-type: disc;
  }
  .rule-card li {
    font-size: 0.875rem;
    color: var(--muted-foreground);
    line-height: 1.6;
    margin-bottom: 0.25rem;
  }
  .rule-card--do {
    background: color-mix(in srgb, var(--success) 4%, var(--background));
    border-color: color-mix(in srgb, var(--success) 15%, var(--border));
  }
  .rule-card--do h3 { color: var(--success); }
  .rule-card--dont {
    background: color-mix(in srgb, var(--destructive) 4%, var(--background));
    border-color: color-mix(in srgb, var(--destructive) 15%, var(--border));
  }
  .rule-card--dont h3 { color: var(--destructive); }
</style>
