---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Firmware Demo | Aegis-Beacon" description="Interactive simulation of the Aegis-Beacon firmware: cycle BEACON, SEARCH, CONFIG and EMERGENCY modes, adjust WPM and TX power, and watch the OLED update live.">

<div class="demo-page container">
  <!-- Section Head -->
  <header class="section-head" style="padding-top: clamp(2rem, 4vw, 3rem);">
    <h1 class="section-head__title">Firmware Simulation</h1>
    <p class="section-head__lead">
      Terminal-style simulation of the Aegis-Beacon OLED display and firmware behavior.
      Adjust parameters and watch the display update in real time.
    </p>
  </header>

  <div class="demo-layout">
    <!-- ═══ Terminal Window ═══ -->
    <div class="terminal-window" data-rv style="--rv-delay: 0ms">
      <div class="terminal-bar">
        <span class="terminal-dot terminal-dot--red"></span>
        <span class="terminal-dot terminal-dot--yellow"></span>
        <span class="terminal-dot terminal-dot--green"></span>
        <span class="terminal-title">aegis-beacon, firmware v5.4</span>
      </div>
      <div class="terminal-body">
        <!-- OLED Screen -->
        <div class="oled-screen" id="oled" style="padding: 1.25rem; min-height: 160px; display: flex; flex-direction: column; gap: 0.375rem;">
          <div class="oled-line">SOS ... --- ...</div>
          <div class="oled-line dim">N45 53.12 E09 12.45</div>
          <div class="oled-line accent">433.500 MHz</div>
          <div class="oled-line">TX: +17 dBm</div>
          <div class="oled-line dim">BAT: 87% 4.12V</div>
        </div>

        <!-- Device Buttons -->
        <div style="display: flex; gap: 0.5rem; margin-top: 1rem; justify-content: center;">
          <button class="key-btn" data-key="mode" type="button">MODE</button>
          <button class="key-btn" data-key="sel" type="button">SEL</button>
          <button class="key-btn" data-key="up" type="button">UP</button>
          <button class="key-btn" data-key="dn" type="button">DN</button>
        </div>
        <p class="key-hint">MODE cycles modes, SEL selects, UP/DN adjust</p>
      </div>
    </div>

    <!-- ═══ Controls Panel ═══ -->
    <div class="controls-panel" data-rv style="--rv-delay: 120ms">
      <div class="controls-panel__header">
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; color: var(--muted-foreground); text-transform: uppercase; letter-spacing: 0.06em;">$ config --interactive</span>
      </div>

      <div class="control-group">
        <label class="control-label">Operating Mode</label>
        <div class="mode-buttons">
          <button class="mode-btn active" data-mode="beacon">BEACON</button>
          <button class="mode-btn" data-mode="search">SEARCH</button>
          <button class="mode-btn" data-mode="config">CONFIG</button>
          <button class="mode-btn" data-mode="emergency">EMERGENCY</button>
        </div>
      </div>

      <div class="control-group">
        <label class="control-label">Frequency</label>
        <select id="freq-select" class="select-input">
          <option value="433.500">433.500 MHz</option>
          <option value="433.775">433.775 MHz</option>
          <option value="434.050">434.050 MHz</option>
          <option value="434.325">434.325 MHz</option>
          <option value="434.600">434.600 MHz</option>
        </select>
      </div>

      <div class="control-group">
        <label class="control-label">Morse Speed (WPM)</label>
        <input type="range" id="wpm-slider" min="5" max="25" value="12" class="range-input">
        <span id="wpm-value" class="range-value">12 WPM</span>
      </div>

      <div class="control-group">
        <label class="control-label">TX Power</label>
        <input type="range" id="power-slider" min="0" max="22" value="17" class="range-input">
        <span id="power-value" class="range-value">+17 dBm</span>
      </div>

      <div class="control-group">
        <label class="control-label">Battery Level</label>
        <input type="range" id="battery-slider" min="0" max="100" value="87" class="range-input">
        <span id="battery-value" class="range-value">87%</span>
      </div>
    </div>
  </div>
</div>

<script>
  const oled = document.getElementById('oled');
  const modes = document.querySelectorAll('.mode-btn');
  const freqSelect = document.getElementById('freq-select') as HTMLSelectElement;
  const wpmSlider = document.getElementById('wpm-slider') as HTMLInputElement;
  const powerSlider = document.getElementById('power-slider') as HTMLInputElement;
  const batterySlider = document.getElementById('battery-slider') as HTMLInputElement;

  let currentMode = 'beacon';
  let currentFreq = '433.500';
  let wpm = 12;
  let power = 17;
  let battery = 87;
  let selTarget: 'wpm' | 'pwr' = 'wpm';
  let txActive = true;

  const MODES = ['beacon', 'search', 'config', 'emergency'];


  function updateDisplay() {
    if (!oled) return;
    const voltage = (3.0 + (battery / 100) * 1.2).toFixed(2);
    const txLine = txActive ? `TX: +${power} dBm` : 'TX: STANDBY';
    const lines: Record<string, string[]> = {
      beacon: [
        'SOS ... --- ...',
        `N45 53.12 E09 12.45`,
        `${currentFreq} MHz`,
        txLine,
        `BAT: ${battery}% ${voltage}V`,
      ],
      search: [
        'SEARCH MODE',
        `Scanning ${currentFreq} MHz`,
        'RSSI: -67 dBm',
        txActive ? 'SIGNAL DETECTED' : 'PAUSED',
        `BAT: ${battery}% ${voltage}V`,
      ],
      config: [
        'CONFIG MODE',
        'WiFi AP: AEGIS-SETUP',
        '192.168.4.1',
        selTarget === 'wpm' ? `> WPM ${wpm}   PWR +${power}` : `  WPM ${wpm}   > PWR +${power}`,
        `BAT: ${battery}% ${voltage}V`,
      ],
      emergency: [
        'EMERGENCY MODE',
        'MAX POWER TX',
        '+22 dBm CONTINUOUS',
        '1760 Hz TONE',
        `BAT: ${battery}% ${voltage}V`,
      ],
    };
    const lineClasses = ['oled-line', 'oled-line dim', 'oled-line accent', 'oled-line', 'oled-line dim'];
    const data = lines[currentMode] || lines.beacon;
    oled.innerHTML = data.map((text, i) => `<div class="${lineClasses[i] || 'oled-line'}">${text}</div>`).join('');
  }

  function selectMode(mode: string) {
    currentMode = mode;
    modes.forEach((b) => b.classList.toggle('active', (b as HTMLElement).dataset.mode === mode));
    updateDisplay();
  }

  modes.forEach(btn => {
    btn.addEventListener('click', () => {
      selectMode((btn as HTMLElement).dataset.mode || 'beacon');
    });
  });

  // Physical keys: MODE cycles modes, SEL selects the CONFIG target or
  // toggles TX, UP/DN adjust the selected parameter live.
  const keyEls = {
    mode: document.querySelector('.key-btn[data-key="mode"]'),
    sel: document.querySelector('.key-btn[data-key="sel"]'),
    up: document.querySelector('.key-btn[data-key="up"]'),
    dn: document.querySelector('.key-btn[data-key="dn"]'),
  };
  keyEls.mode?.addEventListener('click', () => {
    const idx = MODES.indexOf(currentMode);
    selectMode(MODES[(idx + 1) % MODES.length]);
  });
  keyEls.sel?.addEventListener('click', () => {
    if (currentMode === 'config') {
      selTarget = selTarget === 'wpm' ? 'pwr' : 'wpm';
      updateDisplay();
    } else {
      txActive = !txActive;
      updateDisplay();
    }
  });
  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
  keyEls.up?.addEventListener('click', () => {
    if (currentMode === 'config') {
      if (selTarget === 'wpm') { wpm = clamp(wpm + 1, 5, 25); wpmSlider.value = String(wpm); }
      else { power = clamp(power + 1, 0, 22); powerSlider.value = String(power); }
    } else {
      wpm = clamp(wpm + 1, 5, 25);
      wpmSlider.value = String(wpm);
    }
    updateDisplay();
  });
  keyEls.dn?.addEventListener('click', () => {
    if (currentMode === 'config') {
      if (selTarget === 'wpm') { wpm = clamp(wpm - 1, 5, 25); wpmSlider.value = String(wpm); }
      else { power = clamp(power - 1, 0, 22); powerSlider.value = String(power); }
    } else {
      wpm = clamp(wpm - 1, 5, 25);
      wpmSlider.value = String(wpm);
    }
    updateDisplay();
  });

  freqSelect?.addEventListener('change', () => { currentFreq = freqSelect.value; updateDisplay(); });
  wpmSlider?.addEventListener('input', () => { wpm = parseInt(wpmSlider.value); document.getElementById('wpm-value')!.textContent = wpm + ' WPM'; updateDisplay(); });
  powerSlider?.addEventListener('input', () => { power = parseInt(powerSlider.value); document.getElementById('power-value')!.textContent = '+' + power + ' dBm'; updateDisplay(); });
  batterySlider?.addEventListener('input', () => { battery = parseInt(batterySlider.value); document.getElementById('battery-value')!.textContent = battery + '%'; updateDisplay(); });
</script>

<style>
  .demo-page { padding-bottom: 4rem; }

  .demo-layout {
    display: grid; grid-template-columns: 1fr; gap: 2rem;
    max-width: 900px; margin: 2.5rem auto 0;
  }
  @media (min-width: 768px) { .demo-layout { grid-template-columns: 1fr 1fr; } }

  /* Controls Panel */
  .controls-panel {
    border: 1px solid var(--border); border-radius: var(--radius-xl);
    background: var(--card); overflow: hidden; box-shadow: var(--shadow-sm);
  }
  .controls-panel__header {
    padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--border);
    background: var(--muted);
  }
  .control-group { padding: 1rem 1.25rem; border-bottom: 1px solid color-mix(in srgb, var(--foreground) 5%, var(--background)); }
  .control-group:last-child { border-bottom: none; }
  .control-label {
    display: block; font-size: 0.6875rem; font-weight: 600;
    color: var(--muted-foreground); margin-bottom: 0.5rem;
    text-transform: uppercase; letter-spacing: 0.04em;
  }

  .mode-buttons { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.375rem; }
  .mode-btn {
    padding: 0.5rem; font-size: 0.6875rem; font-weight: 600;
    font-family: 'JetBrains Mono', monospace;
    border: 1px solid var(--border); border-radius: var(--radius-md);
    background: var(--background); color: var(--muted-foreground);
    cursor: pointer; transition: all 0.15s;
  }
  .mode-btn:hover { border-color: var(--primary); color: var(--primary); }
  .mode-btn.active {
    background: var(--primary); border-color: var(--primary);
    color: var(--primary-foreground);
  }

  .select-input {
    width: 100%; padding: 0.5rem 0.75rem; font-size: 0.8125rem;
    border: 1px solid var(--border); border-radius: var(--radius-md);
    background: var(--background); color: var(--foreground);
    font-family: 'JetBrains Mono', monospace;
  }

  .range-input {
    width: 100%; -webkit-appearance: none; height: 6px;
    border-radius: 3px; background: var(--border); padding: 0; cursor: pointer;
  }
  .range-input::-webkit-slider-thumb {
    -webkit-appearance: none; width: 16px; height: 16px;
    background: var(--primary); border-radius: 50%; cursor: pointer;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 20%, transparent);
  }
  .range-input::-moz-range-thumb {
    width: 16px; height: 16px; background: var(--primary);
    border-radius: 50%; border: none; cursor: pointer;
  }

  .range-value {
    display: block; font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    color: var(--muted-foreground); margin-top: 0.375rem;
  }

  .key-hint {
    margin: 0.75rem 0 0; text-align: center;
    font-size: 0.7rem; color: var(--muted-foreground);
    font-family: 'JetBrains Mono', monospace; letter-spacing: 0.02em;
  }
</style>
</Layout>
