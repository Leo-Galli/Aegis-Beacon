---
import Layout from '../layouts/Layout.astro'
import AegisDeviceMockup from '../components/AegisDeviceMockup.astro'
import DemoDeviceChrome from '../components/DemoDeviceChrome.astro'
import DemoListenDialog from '../components/DemoListenDialog.astro'
---

<Layout title="Firmware Demo | Aegis-Beacon" description="Interactive simulation of the Aegis-Beacon firmware v6.0: BEACON, SEARCH, LISTEN, CONFIG and EMERGENCY modes with a realistic device mockup and live SSD1309 OLED.">

<div class="demo-page container">
  <header class="section-head page-head">
    <span class="page-head__meta">Firmware v6.0 | hardware keys</span>
    <h1 class="section-head__title">Firmware Simulation</h1>
    <p class="section-head__lead">
      Handheld mockup with live SSD1309 OLED. Hardware keys match firmware v6.0:
      MODE toggles BEACON / SEARCH only. LISTEN requires a USB serial link to a PC.
    </p>
  </header>

  <div class="demo-layout">
    <div class="demo-column-slot" id="demo-column-slot">
      <DemoDeviceChrome>
        <AegisDeviceMockup />
      </DemoDeviceChrome>
    </div>

    <div class="controls-panel" data-rv style="--rv-delay: 120ms">
      <div class="controls-panel__header">
        <span class="controls-panel__tag">Simulation controls</span>
        <div class="controls-panel__toolbar">
        <button id="sound-toggle-btn" class="sound-toggle-btn" type="button" aria-label="Toggle radio CW audio synthesizer" title="Toggle audio">
          <svg id="sound-icon-on" class="sound-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
          <svg id="sound-icon-off" class="sound-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
          <span id="sound-status-label">AUDIO OFF</span>
        </button>
        </div>
      </div>

      <div class="control-group">
        <span class="control-label">Operating Mode</span>
        <p class="control-hint">Panel shortcuts for bench testing. On hardware, LISTEN is serial-only.</p>
        <div class="mode-buttons">
          <button class="mode-btn active" data-mode="beacon" type="button">BEACON</button>
          <button class="mode-btn" data-mode="search" type="button">SEARCH</button>
          <button class="mode-btn mode-btn--serial" data-mode="listen" type="button" title="Simulates MODE LISTEN over USB">LISTEN</button>
          <button class="mode-btn" data-mode="config" type="button">CONFIG</button>
          <button class="mode-btn" data-mode="emergency" type="button">EMERGENCY</button>
        </div>
      </div>

      <div class="control-group">
        <label class="control-label" for="freq-select">Frequency</label>
        <select id="freq-select" class="select-input">
          <option value="433.500">433.500 MHz (CH1)</option>
          <option value="433.775">433.775 MHz (CH2)</option>
          <option value="434.050">434.050 MHz (CH3)</option>
          <option value="434.325">434.325 MHz (CH4)</option>
          <option value="434.600">434.600 MHz (CH5)</option>
        </select>
      </div>

      <div class="control-group">
        <label class="control-label" for="wpm-slider">Morse Speed (WPM)</label>
        <input type="range" id="wpm-slider" min="5" max="40" value="13" class="range-input">
        <span id="wpm-value" class="range-value">13 WPM</span>
      </div>

      <div class="control-group">
        <label class="control-label" for="power-slider">TX Power</label>
        <input type="range" id="power-slider" min="0" max="22" value="17" class="range-input">
        <span id="power-value" class="range-value">+17 dBm</span>
      </div>

      <div class="control-group">
        <label class="control-label" for="rssi-slider">RSSI (SEARCH/LISTEN)</label>
        <input type="range" id="rssi-slider" min="-120" max="-40" value="-72" class="range-input">
        <span id="rssi-value" class="range-value">-72 dBm</span>
      </div>

      <div class="control-group">
        <label class="control-label" for="battery-slider">Battery Level</label>
        <input type="range" id="battery-slider" min="0" max="100" value="87" class="range-input">
        <span id="battery-value" class="range-value">87%</span>
      </div>
    </div>
  </div>

  <section class="demo-tape" data-rv>
    <header class="section-head">
      <h2 class="section-head__title">Live transmission</h2>
      <p class="section-head__lead">
        Payload as Morse on the carrier. Edit the text or drag WPM and the sweep
        re-times to the real on-air duration (PARIS standard).
      </p>
    </header>
    <div class="hero-tape">
      <div class="hero-tape__top">
        <span class="hero-tape__live">On air</span>
        <span class="hero-tape__meta">Payload <b id="tape-payload-label">SOS LEO-GALLI 46.4983N 11.3558E</b> - CW <b id="tape-wpm-label">13</b> WPM</span>
      </div>
      <div class="hero-tape__signal">
        <div class="hero-tape__trace">
          <span class="hero-tape__carrier" id="tape-carrier"></span>
          <div id="tape-waveform"></div>
        </div>
      </div>
      <div class="demo-tape__controls">
        <label for="payload-input">Payload
          <input type="text" id="payload-input" class="payload-input" value="SOS LEO-GALLI 46.4983N 11.3558E" spellcheck="false" autocomplete="off" />
        </label>
        <span class="demo-tape__time" id="tape-time">On air 36.9 s at 13 WPM</span>
      </div>
    </div>
  </section>
</div>

<DemoListenDialog />

<div class="demo-fs-overlay" id="demo-fs-overlay" hidden aria-hidden="true"></div>

<script>
  import {
    drawOledCanvas,
    OLED_SCALE,
    type DemoMode,
    type DemoState,
    type AdjTarget,
  } from '../lib/demo-oled-canvas'
  import { bindLongPress, bindTap } from '../lib/demo-device-input'
  import { modeShortPressNext, MODE_HOLD_MS, SEL_HOLD_MS } from '../lib/demo-firmware-modes'
  import {
    appendBridgeLog,
    getBridgeTuiRoot,
    renderBridgeTui,
    seedBridgeListenSession,
    updateBridgeCwLine,
  } from '../lib/demo-bridge-tui'
  import {
    toggleSound,
    playKeyClick,
    startCwTone,
    stopCwTone,
    updateRadioNoise,
  } from '../lib/demo-audio'
  import { computeMorseTimeline, isMorseCarrierOn } from '../lib/morse-timing'

  const oledCanvas = document.getElementById('oled-canvas') as HTMLCanvasElement
  const oledCtx = oledCanvas.getContext('2d', { alpha: false })!
  oledCanvas.width = 128 * OLED_SCALE
  oledCanvas.height = 64 * OLED_SCALE
  oledCtx.imageSmoothingEnabled = false
  const ledTx = document.getElementById('led-tx')
  const ledRx = document.getElementById('led-rx')

  const modes = document.querySelectorAll('.mode-btn')
  const freqSelect = document.getElementById('freq-select') as HTMLSelectElement
  const wpmSlider = document.getElementById('wpm-slider') as HTMLInputElement
  const powerSlider = document.getElementById('power-slider') as HTMLInputElement
  const rssiSlider = document.getElementById('rssi-slider') as HTMLInputElement
  const batterySlider = document.getElementById('battery-slider') as HTMLInputElement
  const payloadInput = document.getElementById('payload-input') as HTMLInputElement

  const soundBtn = document.getElementById('sound-toggle-btn')
  const soundIconOn = document.getElementById('sound-icon-on')
  const soundIconOff = document.getElementById('sound-icon-off')
  const soundLabel = document.getElementById('sound-status-label')
  const aegisDevice = document.getElementById('aegis-device')
  const devicePowerInput = document.getElementById('device-power-input') as HTMLInputElement | null

  const deviceColumn = document.getElementById('demo-device-column')
  const columnSlot = document.getElementById('demo-column-slot')
  const fsOverlay = document.getElementById('demo-fs-overlay')
  const fsConnector = document.getElementById('demo-fs-connector')
  const fsBtn = document.getElementById('demo-fs-btn')
  const fsUsbBtn = document.getElementById('demo-fs-usb-btn')
  const fsExit = document.getElementById('demo-fs-exit')
  const fsLaptop = document.getElementById('demo-fs-laptop')
  const hwModeBadge = document.getElementById('demo-hw-mode-badge')
  const listenDialog = document.getElementById('demo-listen-dialog') as HTMLDialogElement | null
  const listenStart = document.getElementById('demo-listen-start') as HTMLButtonElement | null
  const listenCancel = document.getElementById('demo-listen-close')
  const listenCancel2 = document.getElementById('demo-listen-cancel')
  const listenCalloutBtn = document.getElementById('demo-listen-callout-btn')
  const listenPcBtn = document.getElementById('demo-listen-pc-btn')
  const listenScene = document.getElementById('demo-listen-scene')
  const listenCmd = document.getElementById('demo-listen-cmd')
  const listenCursor = document.getElementById('demo-listen-cursor')
  const listenResponse = document.getElementById('demo-listen-response')
  const listenSteps = document.querySelectorAll('.demo-listen-steps__item')
  let listenAnimTimer: number | null = null
  let devicePowered = true
  let usbBenchActive = false
  let bridgeStartedAtMs = 0
  let modeBeforeConfig: DemoMode = 'beacon'

  let currentMode: DemoMode = 'beacon'
  let channelIdx = 0
  let wpm = 13
  let power = 17
  let battery = 87
  let rssi = -72
  let rssiThreshold = -90
  let adjTarget: AdjTarget = 'wpm'
  let vol = 80
  let adjOverlayUntil = 0
  let txActive = true
  let cycleNum = 12
  let hitCount = 3
  let scanPass = 12
  let txProgress = 67
  let sleepRemain = 8
  let gpsFix = true
  let cwText = ''
  let cwDecoded = 0
  let cwCharIdx = 0
  let rssiHistory: number[] = []
  let tickMs = 0

  const tapeWaveform = document.getElementById('tape-waveform')
  const tapeCarrier = document.getElementById('tape-carrier')
  const tapeTime = document.getElementById('tape-time')
  const tapePayloadLabel = document.getElementById('tape-payload-label')
  const tapeWpmLabel = document.getElementById('tape-wpm-label')

  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v))

  let activeTimeline = computeMorseTimeline(payloadInput.value.trim() || 'SOS', wpm)

  const handleToggleSound = () => {
    const on = toggleSound()
    if (soundBtn) soundBtn.classList.toggle('is-active', on)
    if (soundIconOn) soundIconOn.style.display = on ? 'inline-block' : 'none'
    if (soundIconOff) soundIconOff.style.display = on ? 'none' : 'inline-block'
    if (soundLabel) soundLabel.textContent = on ? 'AUDIO ON' : 'AUDIO OFF'
    if (on) playKeyClick(1400)
  }
  soundBtn?.addEventListener('click', handleToggleSound)

  const applyDevicePowerUi = () => {
    if (devicePowerInput) devicePowerInput.checked = devicePowered
    aegisDevice?.setAttribute('data-powered', devicePowered ? 'on' : 'off')
  }

  const setDevicePower = (on: boolean, fromUi = false) => {
    if (on === devicePowered) return
    devicePowered = on
    if (!on) {
      stopCwTone()
      updateRadioNoise(false)
      carrierActive = false
      if (usbBenchActive) {
        usbBenchActive = false
        bridgeStartedAtMs = 0
        setLaptopVisible(false)
      }
      if (fromUi) playKeyClick(520)
      showToast('Device powered off')
    } else {
      if (fromUi) playKeyClick(1080)
      showToast(`Powered on | ${currentMode.toUpperCase()}`)
    }
    applyDevicePowerUi()
    renderOled()
    updateLeds()
    syncBridgeTui()
  }

  devicePowerInput?.addEventListener('change', () => {
    setDevicePower(devicePowerInput.checked, true)
  })

  const buildState = (): DemoState => ({
    poweredOn: devicePowered,
    currentMode,
    currentFreq: freqSelect.value,
    channelIdx,
    wpm,
    power,
    battery,
    rssi,
    rssiThreshold,
    adjTarget,
    vol,
    adjOverlayUntil,
    txActive,
    cycleNum,
    hitCount,
    scanPass,
    txProgress,
    sleepRemain,
    gpsFix,
    cwText,
    cwDecoded,
    rssiHistory,
    tickMs,
    payload: payloadInput.value.trim().toUpperCase() || 'SOS',
  })

  const renderOled = () => {
    drawOledCanvas(oledCtx, buildState())
    updateLeds()
  }

  const deviceToast = document.getElementById('device-toast')
  let toastTimer: ReturnType<typeof setTimeout> | null = null

  const showToast = (msg: string, kind: 'info' | 'emergency' = 'info') => {
    if (!deviceToast) return
    deviceToast.textContent = msg
    deviceToast.dataset.kind = kind
    deviceToast.classList.add('is-visible')
    if (toastTimer) clearTimeout(toastTimer)
    toastTimer = setTimeout(() => deviceToast.classList.remove('is-visible'), kind === 'emergency' ? 4200 : 2600)
  }

  let carrierActive = false

  const updateLeds = () => {
    if (!ledTx || !ledRx) return
    if (!devicePowered) {
      ledTx.classList.remove('aegis-device__led--on')
      ledRx.classList.remove('aegis-device__led--on')
      return
    }
    if (currentMode === 'config') {
      const alt = Math.floor(tickMs / 400) % 2 === 0
      ledTx.classList.toggle('aegis-device__led--on', alt)
      ledRx.classList.toggle('aegis-device__led--on', !alt)
      return
    }

    if (currentMode === 'beacon' || currentMode === 'emergency') {
      ledTx.classList.toggle('aegis-device__led--on', carrierActive)
      ledRx.classList.toggle('aegis-device__led--on', false)
    } else {
      ledTx.classList.toggle('aegis-device__led--on', false)
      const rxDetected = rssi >= rssiThreshold
      ledRx.classList.toggle('aegis-device__led--on', rxDetected)
    }
  }

  const updateTape = () => {
    if (!tapeWaveform || !tapeCarrier || !tapeTime) return
    const payload = payloadInput.value.trim() || 'SOS'
    activeTimeline = computeMorseTimeline(payload, wpm)
    const ms = activeTimeline.totalMs

    const UNIT = 6
    let x = 0
    const rects: string[] = []
    for (let i = 0; i < activeTimeline.intervals.length; i++) {
      const iv = activeTimeline.intervals[i]
      const durUnits = Math.round((iv.endMs - iv.startMs) / activeTimeline.unitMs)
      const w = durUnits * UNIT
      const posX = Math.round((iv.startMs / activeTimeline.totalMs) * 360)
      rects.push(`<rect x="${posX}" y="2" width="${Math.max(2, w)}" height="4"/>`)
      x = Math.max(x, posX + w)
    }

    tapeWaveform.innerHTML = `<svg viewBox="0 0 ${Math.max(x, 360)} 8" preserveAspectRatio="none" role="presentation">${rects.join('')}</svg>`
    tapeCarrier.style.setProperty('--carrier-dur', ms + 'ms')
    tapeTime.textContent = `On air ${(ms / 1000).toFixed(1)} s at ${wpm} WPM`
    if (tapePayloadLabel) tapePayloadLabel.textContent = payload
    if (tapeWpmLabel) tapeWpmLabel.textContent = String(wpm)
  }

  const flashAdj = () => { adjOverlayUntil = tickMs + 2500 }

  const syncBridgeTui = () => {
    const nowMs = Date.now()
    const snap = {
      connected: usbBenchActive,
      mode: currentMode,
      freqMhz: parseFloat(freqSelect.value) || 433.5,
      rssi,
      payload: payloadInput.value.trim(),
      cwChar: currentMode === 'listen' ? cwText.slice(-1) || undefined : undefined,
      startedAtMs: bridgeStartedAtMs || nowMs,
      nowMs,
    }
    renderBridgeTui(getBridgeTuiRoot('demo-fs-bridge-tui'), snap)
    if (usbBenchActive) {
      renderBridgeTui(getBridgeTuiRoot('demo-dialog-bridge-tui'), snap)
    }
  }

  const syncFsToolbar = () => {
    const inFs = deviceColumn?.classList.contains('is-fullscreen')
    fsExit?.toggleAttribute('hidden', !inFs)
    if (!inFs) {
      fsUsbBtn?.setAttribute('hidden', '')
      return
    }
    const showUsb = !usbBenchActive
    if (showUsb) fsUsbBtn?.removeAttribute('hidden')
    else fsUsbBtn?.setAttribute('hidden', '')
  }

  const setLaptopVisible = (visible: boolean) => {
    const show = visible && usbBenchActive
    if (show) {
      fsLaptop?.removeAttribute('hidden')
      fsConnector?.removeAttribute('hidden')
      deviceColumn?.classList.add('has-laptop')
    } else {
      fsLaptop?.setAttribute('hidden', '')
      fsConnector?.setAttribute('hidden', '')
      deviceColumn?.classList.remove('has-laptop')
    }
    syncFsToolbar()
  }

  const setFullscreen = (on: boolean, withLaptop = false) => {
    if (!deviceColumn || !fsOverlay || !columnSlot) return

    const alreadyFs = deviceColumn.classList.contains('is-fullscreen')

    if (on && alreadyFs) {
      setLaptopVisible(withLaptop && usbBenchActive)
      syncFsToolbar()
      return
    }

    if (on) {
      fsOverlay.appendChild(deviceColumn)
      fsOverlay.removeAttribute('hidden')
      fsOverlay.setAttribute('aria-hidden', 'false')
      deviceColumn.classList.add('is-fullscreen')
      setLaptopVisible(withLaptop && usbBenchActive)
    } else {
      columnSlot.appendChild(deviceColumn)
      fsOverlay.setAttribute('hidden', '')
      fsOverlay.setAttribute('aria-hidden', 'true')
      deviceColumn.classList.remove('is-fullscreen')
      setLaptopVisible(false)
      usbBenchActive = false
      bridgeStartedAtMs = 0
    }

    document.body.classList.toggle('demo-fs-open', on)
    syncFsToolbar()
  }

  const updateHwBadge = (mode: DemoMode) => {
    if (!hwModeBadge) return
    hwModeBadge.textContent = mode.toUpperCase()
    hwModeBadge.dataset.mode = mode
  }

  const resetListenDialog = () => {
    if (listenAnimTimer) clearTimeout(listenAnimTimer)
    listenScene?.classList.remove('is-connected', 'is-typing', 'is-done')
    listenCmd && (listenCmd.textContent = '')
    listenResponse && (listenResponse.textContent = '')
    listenCursor?.classList.remove('is-hidden')
    listenSteps.forEach((el) => el.classList.remove('is-active', 'is-done'))
  }

  const openListenDialog = () => {
    if (!listenDialog) return
    resetListenDialog()
    listenDialog.showModal()
  }

  const runListenConnectAnim = (): Promise<void> => {
    return new Promise((resolve) => {
      resetListenDialog()
      listenScene?.classList.add('is-connected')
      listenSteps[0]?.classList.add('is-active')

      listenAnimTimer = window.setTimeout(() => {
        listenSteps[0]?.classList.add('is-done')
        listenSteps[0]?.classList.remove('is-active')
        listenSteps[1]?.classList.add('is-active')

        listenAnimTimer = window.setTimeout(() => {
          listenSteps[1]?.classList.add('is-done')
          listenSteps[1]?.classList.remove('is-active')
          listenSteps[2]?.classList.add('is-active')
          listenScene?.classList.add('is-typing')

          const cmd = 'MODE LISTEN'
          let i = 0
          const typeNext = () => {
            if (!listenCmd) return
            listenCmd.textContent = cmd.slice(0, i)
            i += 1
            if (i <= cmd.length) {
              listenAnimTimer = window.setTimeout(typeNext, 70)
            } else {
              listenAnimTimer = window.setTimeout(() => {
                listenCursor?.classList.add('is-hidden')
                if (listenResponse) listenResponse.textContent = 'AEGIS:MODE:LISTEN'
                listenScene?.classList.add('is-done')
                listenSteps[2]?.classList.add('is-done')
                listenSteps[2]?.classList.remove('is-active')
                resolve()
              }, 400)
            }
          }
          typeNext()
        }, 700)
      }, 600)
    })
  }

  const enterListenFromPc = async () => {
    listenStart && (listenStart.disabled = true)
    if (listenDialog && !listenDialog.open) {
      resetListenDialog()
      listenDialog.showModal()
    }
    await runListenConnectAnim()
    listenDialog?.close()
    listenStart && (listenStart.disabled = false)
    usbBenchActive = true
    bridgeStartedAtMs = Date.now()
    selectMode('listen', false)
    const fsTui = getBridgeTuiRoot('demo-fs-bridge-tui')
    seedBridgeListenSession(fsTui)
    syncBridgeTui()
    const inFs = deviceColumn?.classList.contains('is-fullscreen')
    if (inFs) setLaptopVisible(true)
    else setFullscreen(true, true)
    if (soundBtn && !soundBtn.classList.contains('is-active')) handleToggleSound()
    showToast('USB serial | LISTEN mode active', 'info')
  }

  fsBtn?.addEventListener('click', () => setFullscreen(true, false))
  fsUsbBtn?.addEventListener('click', () => { void enterListenFromPc() })
  fsExit?.addEventListener('click', () => setFullscreen(false))
  listenPcBtn?.addEventListener('click', openListenDialog)
  listenCalloutBtn?.addEventListener('click', openListenDialog)
  listenStart?.addEventListener('click', () => { void enterListenFromPc() })
  listenCancel?.addEventListener('click', () => { listenDialog?.close(); resetListenDialog() })
  listenCancel2?.addEventListener('click', () => { listenDialog?.close(); resetListenDialog() })
  listenDialog?.addEventListener('cancel', resetListenDialog)

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && deviceColumn?.classList.contains('is-fullscreen')) {
      setFullscreen(false)
    }
  })

  const selectMode = (mode: DemoMode, fromHardware = false) => {
    if (!devicePowered) return
    const prev = currentMode
    currentMode = mode
    playKeyClick(mode === 'emergency' ? 880 : 1200)

    if (mode === 'emergency') power = 22
    modes.forEach((b) => {
      const el = b as HTMLElement
      el.classList.toggle('active', el.dataset.mode === mode)
      el.classList.toggle('mode-btn--emergency', el.dataset.mode === 'emergency' && mode === 'emergency')
    })
    updateHwBadge(mode)
    if (mode === 'listen') {
      if (!cwText) cwText = ''
      if (deviceColumn?.classList.contains('is-fullscreen') && usbBenchActive) setLaptopVisible(true)
    } else if (deviceColumn?.classList.contains('is-fullscreen')) {
      setLaptopVisible(false)
    }
    if (fromHardware) {
      if (mode === 'emergency') showToast('EMERGENCY | SOS beacon TX (+22 dBm)', 'emergency')
      else if (mode === 'config') showToast('CONFIG | WiFi portal 192.168.4.1')
      else if (prev === 'emergency' && mode === 'beacon') showToast('Emergency cleared | BEACON')
      else if (mode === 'search') showToast('SEARCH | RSSI scan')
      else if (mode === 'beacon' && prev === 'search') showToast('BEACON | Morse TX')
    }
    if (usbBenchActive && prev !== mode) {
      const fsTui = getBridgeTuiRoot('demo-fs-bridge-tui')
      if (fromHardware) {
        appendBridgeLog(fsTui, `[device] AEGIS:MODE:${mode.toUpperCase()}`)
      }
    }
    syncBridgeTui()
    renderOled()
    updateTape()
  }

  const modeShortPress = () => {
    if (!devicePowered) return
    playKeyClick(1100)
    selectMode(modeShortPressNext(currentMode), true)
  }

  const enterEmergency = () => {
    if (!devicePowered) return
    playKeyClick(700)
    selectMode('emergency', true)
  }

  modes.forEach(btn => {
    btn.addEventListener('click', () => {
      if (!devicePowered) return
      playKeyClick(1250)
      const mode = (btn as HTMLElement).dataset.mode as DemoMode || 'beacon'
      if (mode === 'listen') {
        openListenDialog()
        return
      }
      selectMode(mode)
    })
  })

  const keyEls = {
    mode: document.querySelector('.aegis-key[data-key="mode"]'),
    sel: document.querySelector('.aegis-key[data-key="sel"]'),
    up: document.querySelector('.aegis-key[data-key="up"]'),
    dn: document.querySelector('.aegis-key[data-key="dn"]'),
  }

  const pressVisual = (el: Element, on: boolean) => {
    el.classList.toggle('is-pressed', on)
    if (on) playKeyClick(1350)
  }

  const setHoldProgress = (el: Element, ratio: number) => {
    ;(el as HTMLElement).style.setProperty('--hold', String(ratio))
  }

  const adjustUp = () => {
    if (!devicePowered || currentMode === 'config') return
    playKeyClick(1450)
    if (adjTarget === 'wpm') {
      wpm = clamp(wpm + 1, 5, 40)
      wpmSlider.value = String(wpm)
      document.getElementById('wpm-value')!.textContent = wpm + ' WPM'
    } else vol = clamp(vol + 5, 0, 100)
    flashAdj()
    renderOled()
    updateTape()
  }

  const adjustDn = () => {
    if (!devicePowered || currentMode === 'config') return
    playKeyClick(1050)
    if (adjTarget === 'wpm') {
      wpm = clamp(wpm - 1, 5, 40)
      wpmSlider.value = String(wpm)
      document.getElementById('wpm-value')!.textContent = wpm + ' WPM'
    } else vol = clamp(vol - 5, 0, 100)
    flashAdj()
    renderOled()
    updateTape()
  }

  bindLongPress(
    keyEls.mode,
    MODE_HOLD_MS,
    modeShortPress,
    enterEmergency,
    pressVisual,
    setHoldProgress,
  )
  bindLongPress(
    keyEls.sel,
    SEL_HOLD_MS,
    () => {
      if (!devicePowered || currentMode === 'config') return
      playKeyClick(1300)
      adjTarget = adjTarget === 'vol' ? 'wpm' : 'vol'
      flashAdj()
      renderOled()
    },
    () => {
      if (!devicePowered) return
      if (currentMode === 'config') {
        selectMode(modeBeforeConfig, true)
        showToast('CONFIG closed')
        return
      }
      modeBeforeConfig = currentMode === 'emergency' ? 'beacon' : currentMode
      selectMode('config', true)
    },
    pressVisual,
    setHoldProgress,
  )
  bindTap(keyEls.up, adjustUp, pressVisual)
  bindTap(keyEls.dn, adjustDn, pressVisual)

  freqSelect.addEventListener('change', () => {
    channelIdx = freqSelect.selectedIndex
    playKeyClick(1150)
    renderOled()
  })
  wpmSlider.addEventListener('input', () => {
    wpm = parseInt(wpmSlider.value)
    document.getElementById('wpm-value')!.textContent = wpm + ' WPM'
    renderOled()
    updateTape()
  })
  powerSlider.addEventListener('input', () => {
    power = parseInt(powerSlider.value)
    document.getElementById('power-value')!.textContent = '+' + power + ' dBm'
    renderOled()
  })
  rssiSlider.addEventListener('input', () => {
    rssi = parseInt(rssiSlider.value)
    document.getElementById('rssi-value')!.textContent = rssi + ' dBm'
    renderOled()
  })
  batterySlider.addEventListener('input', () => {
    battery = parseInt(batterySlider.value)
    document.getElementById('battery-value')!.textContent = battery + '%'
    renderOled()
  })
  payloadInput.addEventListener('input', () => {
    updateTape()
    if (currentMode === 'beacon' || currentMode === 'emergency') renderOled()
  })

  // Real-time audio & simulation ticker (60ms for smooth 16fps audio keying)
  setInterval(() => {
    tickMs += 60

    if (!devicePowered) {
      renderOled()
      return
    }

    // Synchronize CW Morse sidetone with PARIS timeline
    const isTx = (currentMode === 'beacon' || currentMode === 'emergency') && txActive
    if (isTx) {
      carrierActive = isMorseCarrierOn(activeTimeline, tickMs)
      if (carrierActive) {
        startCwTone(currentMode === 'emergency' ? 820 : 700)
      } else {
        stopCwTone()
      }
    } else {
      carrierActive = false
      stopCwTone()
    }

    // Radio atmospheric background noise in search and listen modes
    if (currentMode === 'search' || currentMode === 'listen') {
      updateRadioNoise(true, rssi)
    } else {
      updateRadioNoise(false)
    }

    rssiHistory.unshift(rssi + Math.round(Math.sin(tickMs / 400) * 4))
    if (rssiHistory.length > 120) rssiHistory.pop()

    if (currentMode === 'beacon' && txActive) {
      txProgress = Math.round(((tickMs % activeTimeline.totalMs) / activeTimeline.totalMs) * 100)
      if (sleepRemain > 0 && tickMs % 1200 === 0) sleepRemain = Math.max(0, sleepRemain - 1)
    }
    if (currentMode === 'search' && tickMs % 3600 === 0) scanPass += 1
    if (currentMode === 'listen' && rssi >= rssiThreshold) {
      const payload = payloadInput.value.trim().toUpperCase() || 'SOS'
      if (cwCharIdx < payload.length && tickMs % 850 === 0) {
        const ch = payload[cwCharIdx]
        cwText += ch
        cwDecoded += 1
        cwCharIdx += 1
        if (usbBenchActive) {
          updateBridgeCwLine(getBridgeTuiRoot('demo-fs-bridge-tui'), ch)
        }
      }
    }
    if (usbBenchActive) syncBridgeTui()
    renderOled()
  }, 60)

  updateTape()
  updateHwBadge(currentMode)
  applyDevicePowerUi()
  renderOled()
</script>

</Layout>
