---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import WikiSearch from '../../components/WikiSearch.astro';
import { WIKI_NAV } from '../../lib/wiki-nav';

const entries: CollectionEntry<'wiki'>[] = await getCollection('wiki');
const meta = new Map(entries.map((e: CollectionEntry<'wiki'>) => [e.id, e.data]));

interface GroupView {
  label: string;
  blurb: string;
  anchor: string;
  pages: { id: string; title: string; description: string }[];
}

const groups: GroupView[] = WIKI_NAV.map((g) => ({
  label: g.label,
  blurb: g.blurb,
  anchor: g.label.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
  pages: g.pages.map((p) => {
    const m = meta.get(p.id);
    return {
      id: p.id,
      title: m?.title ?? p.label,
      description: m?.description ?? '',
    };
  }),
}));

const totalPages = entries.length;
---

<Layout
  title="Documentation | Aegis-Beacon Wiki"
  description="125 in-depth guides for the Aegis-Beacon rescue beacon: hardware, radio and RF design, firmware modes, GPS and Morse payloads, power, and field rescue operations."
>
  <div class="wiki-home">
    <header class="wiki-home__hero container" data-rv="fade">
      <p class="hero-kicker">Aegis-Beacon Documentation</p>
      <h1 class="wiki-home__title">Build, configure and operate the beacon with confidence</h1>
      <p class="wiki-home__lead">
        {totalPages} in-depth guides covering every component, every wire, every
        setting and every field scenario, from first power-up to full-scale
        search and rescue operation.
      </p>
      <div class="wiki-home__search" style="margin-top: 1.75rem;">
        <WikiSearch entries={entries} size="lg" />
      </div>
      <div class="wiki-home__actions">
        <a href="/wiki/project-overview" class="btn btn-primary">Start with the overview</a>
        <a href="/wiki/quick-start-guide" class="btn btn-secondary">Go to the quick start</a>
      </div>
      <div class="wiki-home__stats">
        <div class="wiki-home__stat"><strong>{totalPages}</strong><span>wiki pages</span></div>
        <div class="wiki-home__stat"><strong>{groups.length}</strong><span>guide sections</span></div>
        <div class="wiki-home__stat"><strong>100%</strong><span>open source</span></div>
      </div>
    </header>

    <main class="wiki-home__groups container">
      {groups.map((group) => (
        <section class="wiki-group-card" id={group.anchor}>
          <div class="wiki-group-card__head">
            <div>
              <h2>{group.label}</h2>
              <p>{group.blurb}</p>
            </div>
            <span class="wiki-group-card__count">{group.pages.length}</span>
          </div>
          <div class="wiki-group-card__grid">
            {group.pages.map((page) => (
              <a class="wiki-tile" href={`/wiki/${page.id}`}>
                <span class="wiki-tile__arrow" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                </span>
                <span class="wiki-tile__title">{page.title}</span>
                <span class="wiki-tile__desc">
                  {page.description && page.description.length > 110
                    ? page.description.slice(0, 110).replace(/\s+\S*$/, '') + '...'
                    : page.description}
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </main>

    <section class="cta-section">
      <div class="cta-inner container">
        <h2>Prefer a hands-on approach?</h2>
        <p>Try the interactive firmware simulation or calculate the exact bill of materials for your build.</p>
        <div class="cta-buttons">
          <a href="/demo" class="btn btn-cta">Open the live demo</a>
          <a href="/builder" class="btn btn-cta-ghost">BOM Builder</a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .wiki-home { position: relative; isolation: isolate; overflow: hidden; }

    .wiki-home__hero { text-align: center; padding: clamp(3.5rem, 7vw, 5.5rem) var(--container-px) 2.5rem; }
    .wiki-home__title {
      font-size: clamp(1.9rem, 4.2vw, 3rem); font-weight: 800; line-height: 1.1;
      letter-spacing: -0.03em; margin: 1.25rem 0 0;
    }
    .wiki-home__lead {
      max-width: 42rem; margin: 1rem auto 0; color: var(--muted-foreground);
      font-size: clamp(0.95rem, 1.3vw, 1.1rem); line-height: 1.65;
    }
    .wiki-home__actions { display: flex; gap: 0.75rem; justify-content: center; margin-top: 1.75rem; flex-wrap: wrap; }
    .wiki-home__stats {
      display: flex; gap: 2.5rem; justify-content: center; margin-top: 2.5rem;
      padding-top: 1.5rem; border-top: 1px solid color-mix(in srgb, var(--foreground) 8%, transparent);
    }
    .wiki-home__stat { text-align: center; }
    .wiki-home__stat strong {
      display: block; font-size: 1.6rem; font-weight: 700; font-family: 'JetBrains Mono', monospace;
      font-variant-numeric: tabular-nums; color: var(--primary);
    }
    .wiki-home__stat span {
      font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground);
    }
    @media (max-width: 640px) {
      .wiki-home__stats { gap: 1.5rem; }
      .wiki-home__actions .btn { width: 100%; max-width: 300px; }
    }

    .wiki-home__groups { padding-bottom: 3rem; }
    .wiki-group-card {
      margin: 1.5rem 0; padding: 1.5rem;
      border: 1px solid var(--border); border-radius: var(--radius-xl);
      background: var(--card); box-shadow: var(--shadow-sm);
      scroll-margin-top: calc(var(--header-h) + 1rem);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .wiki-group-card:hover { border-color: color-mix(in srgb, var(--primary) 25%, var(--border)); box-shadow: var(--shadow-md); }
    .wiki-group-card__head {
      display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;
      margin-bottom: 1rem;
    }
    .wiki-group-card__head h2 {
      font-size: 1.125rem; font-weight: 700; margin: 0 0 0.25rem; letter-spacing: -0.01em;
    }
    .wiki-group-card__head p { margin: 0; color: var(--muted-foreground); font-size: 0.875rem; max-width: 46rem; }
    .wiki-group-card__count {
      flex-shrink: 0; font-size: 0.75rem; font-family: 'JetBrains Mono', monospace;
      color: var(--muted-foreground); border: 1px solid var(--border);
      padding: 0.125rem 0.5rem; border-radius: var(--radius-full);
    }
    .wiki-group-card__grid {
      display: grid; grid-template-columns: 1fr; gap: 0.625rem;
    }
    @media (min-width: 640px) { .wiki-group-card__grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1100px) { .wiki-group-card__grid { grid-template-columns: repeat(3, 1fr); } }

    .wiki-tile {
      display: grid; grid-template-columns: auto 1fr; gap: 0.375rem 0.625rem;
      align-items: center; padding: 0.875rem 1rem;
      border: 1px solid var(--border); border-radius: var(--radius-lg);
      text-decoration: none; transition: all 0.18s;
    }
    .wiki-tile:hover {
      border-color: color-mix(in srgb, var(--primary) 45%, var(--border));
      transform: translateY(-2px); box-shadow: var(--shadow-md);
    }
    .wiki-tile__arrow {
      grid-row: 1 / 3; display: flex; align-items: center; justify-content: center;
      width: 30px; height: 30px; border-radius: var(--radius-md);
      background: color-mix(in srgb, var(--primary) 8%, transparent);
      color: var(--primary); transition: all 0.2s;
    }
    .wiki-tile:hover .wiki-tile__arrow { background: var(--primary); color: var(--primary-foreground); }
    .wiki-tile__title { font-size: 0.875rem; font-weight: 600; color: var(--foreground); }
    .wiki-tile__desc {
      font-size: 0.75rem; color: var(--muted-foreground); line-height: 1.5;
    }
  </style>
</Layout>
