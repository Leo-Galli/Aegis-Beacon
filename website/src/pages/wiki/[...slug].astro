---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import WikiLayout from '../../layouts/WikiLayout.astro';

interface Props {
  entry: CollectionEntry<'wiki'>;
}

export async function getStaticPaths() {
  const wikiEntries = await getCollection('wiki');
  return wikiEntries.map((entry: CollectionEntry<'wiki'>) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<WikiLayout
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.id}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description ?? '',
    image: 'https://aegis-beacon.vercel.app/og-banner.png',
    author: { '@type': 'Person', name: 'Leonardo Galli' },
    publisher: {
      '@type': 'Organization',
      name: 'Aegis-Beacon',
      url: 'https://aegis-beacon.vercel.app',
      logo: { '@type': 'ImageObject', url: 'https://aegis-beacon.vercel.app/favicon.svg' }
    },
    mainEntityOfPage: `https://aegis-beacon.vercel.app/wiki/${entry.id}`
  })} />
  <Content />
</WikiLayout>
