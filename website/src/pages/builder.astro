---
import Layout from '../layouts/Layout.astro';
---

<Layout title="BOM Builder | Aegis-Beacon" description="Interactive Bill of Materials calculator for Aegis-Beacon">
  <div class="builder-page container">
    <!-- Section Head -->
    <header class="section-head" style="padding-top: clamp(2rem, 4vw, 3rem);">
      <p class="section-head__eyebrow">Bill of Materials</p>
      <h1 class="section-head__title">BOM Builder</h1>
      <p class="section-head__lead">
        Calculate the total cost of your Aegis-Beacon build. Adjust quantities and see real-time pricing.
      </p>
    </header>

    <div class="builder-layout">
      <!-- Budget Card -->
      <div class="budget-card" data-glow data-rv>
        <div class="budget-label">Target Budget</div>
        <div class="budget-value" id="budget-display">$30</div>
        <input type="range" id="budget-slider" min="15" max="60" value="30" class="range-input">
        <div class="budget-range">
          <span>$15</span>
          <span>$60</span>
        </div>
      </div>

      <!-- Components Table -->
      <div class="components-card" data-glow data-rv style="--rv-delay: 120ms">
        <div class="components-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          Components
        </div>

        <div class="component-row component-header-row">
          <span>Component</span>
          <span>Source</span>
          <span>Price</span>
          <span>Qty</span>
          <span>Total</span>
        </div>

        <div class="component-row" data-price="8.50">
          <div class="comp-info">
            <strong>ESP32-WROOM-32</strong>
            <span>Dual-Core MCU with WiFi/BT</span>
          </div>
          <div class="comp-meta">AliExpress</div>
          <div class="comp-price">$8.50</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$8.50</div>
        </div>

        <div class="component-row" data-price="5.20">
          <div class="comp-info">
            <strong>E22-400M30S</strong>
            <span>SX1262 LoRa Module +30dBm</span>
          </div>
          <div class="comp-meta">AliExpress</div>
          <div class="comp-price">$5.20</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$5.20</div>
        </div>

        <div class="component-row" data-price="3.80">
          <div class="comp-info">
            <strong>SSD1309 OLED 2.42"</strong>
            <span>I2C 128x64 Display</span>
          </div>
          <div class="comp-meta">AliExpress</div>
          <div class="comp-price">$3.80</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$3.80</div>
        </div>

        <div class="component-row" data-price="2.90">
          <div class="comp-info">
            <strong>NEO-6M GPS</strong>
            <span>UART GPS Module</span>
          </div>
          <div class="comp-meta">AliExpress</div>
          <div class="comp-price">$2.90</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$2.90</div>
        </div>

        <div class="component-row" data-price="0.80">
          <div class="comp-info">
            <strong>TP4056 Charger</strong>
            <span>Li-Ion USB-C Charging Board</span>
          </div>
          <div class="comp-meta">AliExpress</div>
          <div class="comp-price">$0.80</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$0.80</div>
        </div>

        <div class="component-row" data-price="2.50">
          <div class="comp-info">
            <strong>18650 Battery</strong>
            <span>3.7V 3000mAh Li-Ion Cell</span>
          </div>
          <div class="comp-meta">Local Store</div>
          <div class="comp-price">$2.50</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$2.50</div>
        </div>

        <div class="component-row" data-price="1.20">
          <div class="comp-info">
            <strong>SMA Connector + Antenna</strong>
            <span>433MHz Rubber Duck Antenna</span>
          </div>
          <div class="comp-meta">AliExpress</div>
          <div class="comp-price">$1.20</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$1.20</div>
        </div>

        <div class="component-row" data-price="0.60">
          <div class="comp-info">
            <strong>Tactile Switches</strong>
            <span>6x6mm Momentary Push Button</span>
          </div>
          <div class="comp-meta">AliExpress</div>
          <div class="comp-price">$0.15</div>
          <div class="comp-qty">
            <input type="number" value="4" min="0" max="20" class="qty-input">
          </div>
          <div class="comp-total">$0.60</div>
        </div>

        <div class="component-row" data-price="0.40">
          <div class="comp-info">
            <strong>Passive Buzzer</strong>
            <span>3V Piezo Buzzer</span>
          </div>
          <div class="comp-meta">AliExpress</div>
          <div class="comp-price">$0.40</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$0.40</div>
        </div>

        <div class="component-row" data-price="0.30">
          <div class="comp-info">
            <strong>Resistors & Capacitors</strong>
            <span>Passive Components Kit</span>
          </div>
          <div class="comp-meta">Local Store</div>
          <div class="comp-price">$0.30</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$0.30</div>
        </div>
      </div>

      <!-- Total Card -->
      <div class="total-card" data-glow data-rv style="--rv-delay: 60ms">
        <div class="total-row">
          <span>Components Total</span>
          <span id="components-total">$26.20</span>
        </div>
        <div class="total-row">
          <span>Enclosure (3D Print)</span>
          <span>$2.00</span>
        </div>
        <div class="total-row total-grand">
          <span>Grand Total</span>
          <span id="grand-total">$28.20</span>
        </div>
        <div class="budget-status budget-ok" id="budget-status">
          Within budget
        </div>
      </div>
    </div>
  </div>

  <script>
    const slider = document.getElementById('budget-slider') as HTMLInputElement;
    const budgetDisplay = document.getElementById('budget-display');
    const componentsTotal = document.getElementById('components-total');
    const grandTotal = document.getElementById('grand-total');
    const budgetStatus = document.getElementById('budget-status');
    const qtyInputs = document.querySelectorAll('.qty-input');

    function updateTotals() {
      let total = 0;
      document.querySelectorAll('.component-row[data-price]').forEach(comp => {
        const price = parseFloat((comp as HTMLElement).dataset.price || '0');
        const qtyInput = comp.querySelector('.qty-input') as HTMLInputElement;
        const qty = parseInt(qtyInput?.value || '1');
        const compTotal = price * qty;
        total += compTotal;
        const totalEl = comp.querySelector('.comp-total');
        if (totalEl) totalEl.textContent = '$' + compTotal.toFixed(2);
      });

      const grand = total + 2.00;
      if (componentsTotal) componentsTotal.textContent = '$' + total.toFixed(2);
      if (grandTotal) grandTotal.textContent = '$' + grand.toFixed(2);
      if (budgetDisplay) budgetDisplay.textContent = '$' + (slider?.value || '30');

      if (budgetStatus) {
        const budget = parseInt(slider?.value || '30');
        if (grand <= budget) {
          budgetStatus.textContent = 'Within budget';
          budgetStatus.className = 'budget-status budget-ok';
        } else {
          budgetStatus.textContent = 'Over budget by $' + (grand - budget).toFixed(2);
          budgetStatus.className = 'budget-status budget-over';
        }
      }
    }

    slider?.addEventListener('input', updateTotals);
    qtyInputs.forEach(input => input.addEventListener('change', updateTotals));
    updateTotals();
  </script>

  <style>
    .builder-page { padding-bottom: 4rem; }
    .builder-layout {
      max-width: 900px; margin: 2.5rem auto 0;
      display: flex; flex-direction: column; gap: 1.5rem;
    }

    /* Budget Card */
    .budget-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: var(--radius-xl); padding: 2rem;
      text-align: center; box-shadow: var(--shadow-sm);
    }
    .budget-label {
      font-size: 0.75rem; font-weight: 600; color: var(--muted-foreground);
      text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.5rem;
    }
    .budget-value {
      font-size: 2.5rem; font-weight: 700;
      font-family: 'JetBrains Mono', monospace; color: var(--foreground);
      margin-bottom: 1.25rem;
      background: linear-gradient(135deg, var(--primary), oklch(0.78 0.15 80deg));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .range-input {
      width: 100%; -webkit-appearance: none; height: 6px;
      border-radius: 3px; background: var(--border); padding: 0; cursor: pointer;
    }
    .range-input::-webkit-slider-thumb {
      -webkit-appearance: none; width: 20px; height: 20px;
      background: var(--primary); border-radius: 50%; cursor: pointer;
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 15%, transparent);
    }
    .budget-range {
      display: flex; justify-content: space-between;
      font-size: 0.75rem; color: var(--muted-foreground); margin-top: 0.5rem;
      font-family: 'JetBrains Mono', monospace;
    }

    /* Components Card */
    .components-card {
      border: 1px solid var(--border); border-radius: var(--radius-xl);
      background: var(--card); overflow: hidden; box-shadow: var(--shadow-sm);
    }
    .components-header {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--border);
      background: var(--muted); font-size: 0.8125rem; font-weight: 600;
      color: var(--foreground);
    }
    .component-row {
      display: grid; grid-template-columns: 2fr 1fr 0.7fr 0.5fr 0.7fr;
      gap: 0.5rem; padding: 0.75rem 1.25rem; align-items: center;
      border-bottom: 1px solid color-mix(in srgb, var(--foreground) 5%, var(--background));
      font-size: 0.8125rem; transition: background 0.1s;
    }
    .component-row:last-child { border-bottom: none; }
    .component-row:not(.component-header-row):hover { background: var(--muted); }
    .component-header-row {
      background: var(--muted); font-size: 0.6875rem; font-weight: 600;
      color: var(--muted-foreground); text-transform: uppercase; letter-spacing: 0.04em;
    }
    .comp-info strong { display: block; font-weight: 600; color: var(--foreground); }
    .comp-info span { font-size: 0.75rem; color: var(--muted-foreground); }
    .comp-meta { font-size: 0.75rem; color: var(--muted-foreground); }
    .comp-price { font-family: 'JetBrains Mono', monospace; font-size: 0.8125rem; }
    .qty-input {
      width: 100%; padding: 0.375rem; font-size: 0.8125rem;
      border: 1px solid var(--border); border-radius: var(--radius-md);
      background: var(--background); color: var(--foreground);
      text-align: center; font-family: 'JetBrains Mono', monospace;
    }
    .qty-input:focus { border-color: var(--primary); outline: none; box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 15%, transparent); }
    .comp-total {
      font-family: 'JetBrains Mono', monospace; font-weight: 600;
      text-align: right; color: var(--foreground);
    }

    /* Total Card */
    .total-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: var(--radius-xl); padding: 1.5rem;
      box-shadow: var(--shadow-sm);
    }
    .total-row {
      display: flex; justify-content: space-between;
      padding: 0.5rem 0; font-size: 0.875rem; color: var(--muted-foreground);
    }
    .total-grand {
      border-top: 1px solid var(--border); margin-top: 0.5rem;
      padding-top: 0.75rem; font-weight: 700; font-size: 1.125rem; color: var(--foreground);
    }
    .budget-status {
      text-align: center; font-size: 0.8125rem; font-weight: 600;
      margin-top: 1rem; padding: 0.625rem; border-radius: var(--radius-lg);
    }
    .budget-ok {
      background: color-mix(in srgb, var(--success) 8%, var(--background));
      color: var(--success);
    }
    .budget-over {
      background: color-mix(in srgb, var(--destructive) 8%, var(--background));
      color: var(--destructive);
    }

    @media (max-width: 640px) {
      .component-header-row { display: none; }
      .component-row { grid-template-columns: 1fr auto; gap: 0.75rem; }
      .comp-meta, .comp-price { display: none; }
    }
  </style>
</Layout>
