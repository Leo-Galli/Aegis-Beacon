---
import Layout from '../layouts/Layout.astro';

interface Part {
  id: string;
  name: string;
  desc: string;
  price: number;
  low: number;
  qty: number;
  max: number;
  essential: boolean;
  source: string;
  query: string;
}

const parts: Part[] = [
  { id: 'esp32', name: 'ESP32-WROOM-32', desc: 'Dual-core MCU with WiFi and BT', price: 8.5, low: 6.0, qty: 1, max: 3, essential: true, source: 'AliExpress', query: 'ESP32 WROOM-32 devkit' },
  { id: 'radio', name: 'E22-400M30S', desc: 'SX1262 LoRa module, +30 dBm', price: 5.2, low: 4.0, qty: 1, max: 3, essential: true, source: 'AliExpress', query: 'E22-400M30S SX1262 433MHz' },
  { id: 'oled', name: 'SSD1309 OLED 2.42"', desc: '7-pin SPI 128 x 64 display', price: 3.8, low: 2.8, qty: 1, max: 2, essential: true, source: 'AliExpress', query: 'SSD1309 OLED 2.42 SPI' },
  { id: 'gps', name: 'NEO-6M GPS', desc: 'UART GPS module with antenna', price: 2.9, low: 2.2, qty: 1, max: 2, essential: true, source: 'AliExpress', query: 'NEO-6M GPS module UART' },
  { id: 'charger', name: 'TP4056 Charger', desc: 'Li-Ion USB-C charging board', price: 0.8, low: 0.6, qty: 1, max: 3, essential: true, source: 'AliExpress', query: 'TP4056 USB-C charger 18650' },
  { id: 'cell', name: '18650 Battery', desc: '3.7 V 3000 mAh protected cell', price: 2.5, low: 1.8, qty: 1, max: 4, essential: true, source: 'Local Store', query: '18650 3000mAh protected battery' },
  { id: 'antenna', name: 'SMA Connector + Antenna', desc: '433 MHz quarter-wave whip', price: 1.2, low: 0.8, qty: 1, max: 2, essential: true, source: 'AliExpress', query: '433MHz SMA antenna whip' },
  { id: 'switches', name: 'Tactile Switches', desc: '6 x 6 mm momentary push buttons', price: 0.15, low: 0.08, qty: 4, max: 20, essential: true, source: 'AliExpress', query: '6x6mm tactile push button' },
  { id: 'buzzer', name: 'Passive Buzzer', desc: 'Piezo for Morse audio feedback', price: 0.4, low: 0.3, qty: 1, max: 3, essential: false, source: 'AliExpress', query: 'passive piezo buzzer 3V' },
  { id: 'passives', name: 'Resistors & Capacitors', desc: 'Pull-ups, decoupling and bias kit', price: 0.3, low: 0.2, qty: 1, max: 5, essential: true, source: 'Local Store', query: 'resistor capacitor assortment kit' },
  { id: 'case', name: '3D-Printed Enclosure', desc: 'Optional rugged case (printed locally)', price: 2.0, low: 1.5, qty: 1, max: 2, essential: false, source: '3D Print', query: 'ESP32 OLED 18650 enclosure STL' },
];

const partById = new Map(parts.map((p) => [p.id, p]));

interface Phase {
  n: number;
  title: string;
  why: string;
  ids: string[];
}

const phases: Phase[] = [
  {
    n: 1,
    title: 'Phase 1: core electronics',
    why: 'Modules with the longest shipping times, usually 7-20+ days from Asia. Order these first: every later step depends on them.',
    ids: ['esp32', 'radio', 'oled', 'gps', 'antenna', 'switches', 'charger', 'buzzer'],
  },
  {
    n: 2,
    title: 'Phase 2: bench and power',
    why: 'Parts you can buy locally or receive quickly. Order them as phase 1 ships, so you can bench-test the day the boards arrive.',
    ids: ['cell', 'passives'],
  },
  {
    n: 3,
    title: 'Phase 3: enclosure and finishing',
    why: 'Print or order the case last, after a successful bench test, so it matches the final wiring layout.',
    ids: ['case'],
  },
];

interface PayPlan {
  n: number;
  tag: string;
  hint: string;
}

const payPlans: PayPlan[] = [
  { n: 1, tag: 'Pay now', hint: 'One payment at checkout.' },
  { n: 3, tag: 'PayPal / Klarna / Scalapay', hint: 'Interest-free where the store offers it.' },
  { n: 4, tag: 'Scalapay Pay in 4', hint: 'One payment now, three more later.' },
  { n: 6, tag: 'Scalapay / Klarna longer plans', hint: 'Six monthly payments at partner stores.' },
  { n: 12, tag: 'Amazon.it financing', hint: 'Monthly instalments on eligible orders.' },
];
---

<Layout
  title="BOM Builder | Aegis-Beacon"
  description="Interactive bill of materials calculator for Aegis-Beacon: live pricing, budget fitting, a phased purchase order, payment plans in instalments and price comparison links across stores."
>
  <div class="builder-page container">
    <header class="section-head page-head">
      <h1 class="section-head__title">BOM Builder</h1>
      <p class="section-head__lead">
        Adjust quantities, compare prices across stores, and fit the build to your budget. Plan
        the payments, follow the recommended purchase order, and know where instalments are
        available before you check out. All figures update live.
      </p>
    </header>

    <div class="builder-layout">
      <div class="budget-card" data-rv>
        <div class="budget-label">Target Budget</div>
        <div class="budget-value" id="budget-display">$30</div>
        <input type="range" id="budget-slider" min="15" max="60" value="30" class="range-input" aria-label="Target budget in dollars">
        <div class="budget-range">
          <span>$15</span>
          <span>$60</span>
        </div>
        <p class="budget-hint" id="budget-hint">
          The essential minimum is <strong id="budget-min">$25.80</strong>.
          Below that, no optional part can be dropped to fit.
        </p>
      </div>

      <div class="components-card" data-rv style="--rv-delay: 120ms">
        <div class="components-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          Components
        </div>

        <div class="component-row component-header-row">
          <span>Component</span>
          <span>Best sources</span>
          <span>Price</span>
          <span>Qty</span>
          <span>Total</span>
        </div>

        {
          parts.map((part, i) => (
            <div
              class="component-row"
              data-price={part.price}
              data-essential={part.essential}
              data-qty={part.qty}
              id={`part-${part.id}`}
              style={`--rv-delay: ${i * 30}ms`}
            >
              <div class="comp-info">
                <strong>
                  {part.name}
                  {!part.essential && <span class="comp-optional-badge" title="Non-essential, can be dropped to fit the budget">optional</span>}
                </strong>
                <span>{part.desc}</span>
                <div class="comp-compare">
                  <span>Compare:</span>
                  <a href={`https://www.trovaprezzi.it/categoria.aspx?id=-1&libera=${encodeURIComponent(part.query)}`} target="_blank" rel="noopener" title="Search Trovaprezzi">Trovaprezzi</a>
                  <a href={`https://www.google.com/search?tbm=shop&q=${encodeURIComponent(part.query)}`} target="_blank" rel="noopener" title="Search Google Shopping">Google</a>
                  <a href={`https://www.ebay.it/sch/i.html?_nkw=${encodeURIComponent(part.query)}`} target="_blank" rel="noopener" title="Search eBay.it">eBay</a>
                  <a href={`https://www.aliexpress.com/wholesale?SearchText=${encodeURIComponent(part.query)}`} target="_blank" rel="noopener" title="Search AliExpress">AliExpress</a>
                  <a href={`https://www.amazon.it/s?k=${encodeURIComponent(part.query)}`} target="_blank" rel="noopener" title="Search Amazon.it">Amazon</a>
                </div>
              </div>
              <div class="comp-meta">
                <span class="comp-source">{part.source}</span>
                {!part.essential && (
                  <label class="comp-toggle">
                    <input type="checkbox" class="include-toggle" checked aria-label={`Include ${part.name}`}>
                    <span>keep</span>
                  </label>
                )}
              </div>
              <div class="comp-price">
                <span class="comp-price-main">${part.price.toFixed(2)}</span>
                {part.low < part.price && <span class="comp-price-low">from ${part.low.toFixed(2)}</span>}
              </div>
              <div class="comp-qty">
                <input type="number" value={part.qty} min={part.essential ? 1 : 0} max={part.max} class="qty-input" aria-label={`Quantity of ${part.name}`}>
              </div>
              <div class="comp-total">${(part.price * part.qty).toFixed(2)}</div>
            </div>
          ))
        }
      </div>

      <div class="budget-fit" id="budget-fit" hidden data-rv style="--rv-delay: 160ms">
        <div class="budget-fit__head">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.01"/></svg>
          <strong>Fit to budget</strong>
        </div>
        <p id="budget-fit-text">
          Over budget by <strong>$0.00</strong>. Drop the optional extras below to stay inside it.
        </p>
        <ul class="budget-fit__list" id="budget-fit-list"></ul>
        <button id="auto-fit-btn" class="btn btn-secondary" type="button">Drop optional extras to fit</button>
      </div>

      <div class="total-card" data-rv>
        <div class="total-row">
          <span>Components Total</span>
          <span id="components-total">$28.20</span>
        </div>
        <div class="total-row total-essentials">
          <span>Essential minimum (always kept)</span>
          <span id="essential-total">$25.80</span>
        </div>
        <div id="aria-live" class="aria-live" aria-live="polite"></div>
        <div class="total-row total-grand">
          <span>Grand Total</span>
          <span id="grand-total">$28.20</span>
        </div>
        <div class="budget-status budget-ok" id="budget-status">
          Within budget
        </div>
        <p class="total-note">
          Street prices are typical, not quotes. Open the Compare links next to each part to find the
          current best offer across stores and price comparators.
        </p>
      </div>

      <section class="plan-card" data-rv>
        <div class="card-title-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          <div>
            <h2>Payment plan</h2>
            <p>Pay the full total now, or split it across several payments. The amounts below update with your quantities and choices above.</p>
          </div>
        </div>

        <div class="plan-layout">
          <div class="plan-controls">
            <div class="plan-label">Number of payments</div>
            <div class="plan-segments" role="group" aria-label="Number of payments">
              {payPlans.map((pl) => (
                <button
                  type="button"
                  class="plan-seg"
                  data-plan={pl.n}
                  aria-pressed={pl.n === 1 ? 'true' : 'false'}
                >
                  <span class="plan-seg-num">{pl.n}</span>
                  <span class="plan-seg-tag">{pl.tag}</span>
                </button>
              ))}
            </div>
          </div>
          <div class="plan-details">
            <div class="plan-total-label">Amount per payment</div>
            <div class="plan-total-row">
              <span id="plan-total-desc">Total to pay</span>
              <strong id="plan-total">$28.20</strong>
            </div>
            <div class="plan-lines" id="plan-lines" aria-live="polite"></div>
            <p class="plan-method" id="plan-method"></p>
            <p class="plan-note">
              Plans are examples of the options that can appear at a store's checkout. Availability
              depends on the store, the order value and your account, and some financing plans
              charge interest. Confirm the exact terms before you pay.
            </p>
          </div>
        </div>
      </section>

      <section class="order-card" data-rv>
        <div class="card-title-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
          <div>
            <h2>What to buy first</h2>
            <p>Follow the phases for the shortest wait and a smoother first build. Each list updates live with the quantities and choices above.</p>
          </div>
        </div>

        <div class="phase-stack">
          {phases.map((ph, i) => (
            <details class="phase" open={i < 2}>
              <summary>
                <span class="phase-head">
                  <span class="phase-title">{ph.title}</span>
                  <span class="phase-why">{ph.why}</span>
                </span>
                <span class="phase-sub" id={`phase-sub-${ph.n}`}>$0.00</span>
                <svg class="phase-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <ul class="phase-list">
                {ph.ids.map((pid) => {
                  const p = partById.get(pid)!;
                  return (
                    <li data-part={p.id}>
                      <span class="ph-name">
                        {p.name}
                        {!p.essential && <span class="comp-optional-badge">optional</span>}
                      </span>
                      <span class="ph-qty" id={`ph-qty-${p.id}`}>x{p.qty}</span>
                      <span class="ph-total" id={`ph-total-${p.id}`}>${(p.price * p.qty).toFixed(2)}</span>
                    </li>
                  );
                })}
              </ul>
            </details>
          ))}
        </div>
      </section>

      <details class="store-legend" data-rv>
        <summary>
          <span>Which stores offer instalments?</span>
          <svg class="phase-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="store-legend__body">
          <dl>
            <div><dt>Amazon.it</dt><dd>Monthly instalments on eligible orders through Cofidis financing (from 3 up to 24 payments). Interest-free promotions appear regularly; you choose the rate plan at checkout.</dd></div>
            <div><dt>PayPal merchants</dt><dd>PayPal Paga in 3 Rate is interest-free with no fees, offered only where the seller enables it at checkout.</dd></div>
            <div><dt>Scalapay and Klarna stores</dt><dd>Pay in 3, Pay in 4 or longer monthly plans at partner merchants, interest-free when each payment arrives on time.</dd></div>
            <div><dt>eBay.it and AliExpress</dt><dd>Single payment at checkout with card or PayPal. These platforms do not offer instalment plans themselves.</dd></div>
            <div><dt>Google Shopping and Trovaprezzi</dt><dd>Price comparators. You always pay on the merchant's own site, where instalment options vary.</dd></div>
            <div><dt>Local store or 3D print</dt><dd>Cash, card or bank transfer, usually as one payment.</dd></div>
          </dl>
        </div>
      </details>
    </div>
  </div>
</Layout>

<script>
  interface PartRow {
    id: string;
    name: string;
    price: number;
    essential: boolean;
  }

  const slider = document.getElementById('budget-slider') as HTMLInputElement;
  const budgetDisplay = document.getElementById('budget-display');
  const componentsTotal = document.getElementById('components-total');
  const essentialTotalEl = document.getElementById('essential-total');
  const grandTotal = document.getElementById('grand-total');
  const budgetStatus = document.getElementById('budget-status');
  const fitPanel = document.getElementById('budget-fit');
  const fitText = document.getElementById('budget-fit-text');
  const fitList = document.getElementById('budget-fit-list');
  const autoFitBtn = document.getElementById('auto-fit-btn');

  const rows: PartRow[] = [...document.querySelectorAll<HTMLElement>('.component-row[data-price]')].map((row) => ({
    id: row.id || '',
    name: row.querySelector('.comp-info strong')?.textContent?.replace(/optional/g, '').trim() || '',
    price: parseFloat(row.dataset.price || '0'),
    essential: row.dataset.essential === 'true',
  }));

  const phaseIds: Record<number, string[]> = {
    1: ['esp32', 'radio', 'oled', 'gps', 'antenna', 'switches', 'charger', 'buzzer'],
    2: ['cell', 'passives'],
    3: ['case'],
  };

  const planButtons = [...document.querySelectorAll<HTMLButtonElement>('.plan-seg')];
  const planLines = document.getElementById('plan-lines');
  const planMethod = document.getElementById('plan-method');
  const planTotal = document.getElementById('plan-total');
  let currentPlan = 1;

  function refreshPhases() {
    Object.entries(phaseIds).forEach(([phaseStr, ids]) => {
      const phaseNum = parseInt(phaseStr, 10);
      let sub = 0;
      ids.forEach((pid) => {
        const row = document.getElementById('part-' + pid) as HTMLElement | null;
        const li = document.querySelector(`.phase-list li[data-part="${pid}"]`);
        if (!li) return;
        const line = row && rowEnabled(row) ? (parseFloat(row.dataset.price || '0') * qtyOf(row)) : 0;
        sub += line;
        li.classList.toggle('ph-dropped', !row || !rowEnabled(row) || qtyOf(row) === 0);
        const qtyEl = li.querySelector('.ph-qty');
        const totalEl = li.querySelector('.ph-total');
        if (qtyEl) qtyEl.textContent = 'x' + (row ? qtyOf(row) : 0);
        if (totalEl) totalEl.textContent = '$' + line.toFixed(2);
      });
      const subEl = document.getElementById('phase-sub-' + phaseNum);
      if (subEl) subEl.textContent = '$' + sub.toFixed(2);
    });
  }

  function renderPlan() {
    if (!planLines) return;
    const raw = (grandTotal?.textContent || '').replace(/[^0-9.]/g, '');
    const totalCents = Math.round(parseFloat(raw || '0') * 100);
    if (planTotal) planTotal.textContent = '$' + (totalCents / 100).toFixed(2);
    planLines.innerHTML = '';

    const push = (label: string, amount: string) => {
      const line = document.createElement('div');
      line.className = 'plan-line';
      const l = document.createElement('span');
      l.textContent = label;
      const v = document.createElement('strong');
      v.textContent = amount;
      line.appendChild(l);
      line.appendChild(v);
      planLines.appendChild(line);
    };

    if (currentPlan <= 1) {
      push('Pay the full total at checkout', '$' + (totalCents / 100).toFixed(2));
    } else {
      // Split so the first payment absorbs the remainder and no payment is empty
      const base = Math.max(1, Math.ceil(totalCents / currentPlan));
      const first = Math.max(0, totalCents - base * (currentPlan - 1));
      push('First payment, today', '$' + (first / 100).toFixed(2));
      push('Next ' + (currentPlan - 1) + ' payments', 'each $' + (base / 100).toFixed(2));
    }
    if (planTotal) planTotal.textContent = '$' + (totalCents / 100).toFixed(2);
    const descEl = document.getElementById('plan-total-desc');
    if (descEl) {
      descEl.textContent = currentPlan <= 1
        ? 'Total to pay'
        : 'Split into ' + currentPlan + ' payments';
    }

    planButtons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.plan === String(currentPlan) ? 'true' : 'false'));
    planButtons.forEach((b) => b.classList.toggle('is-active', b.dataset.plan === String(currentPlan)));

    if (planMethod) {
      const pl = planButtons.find((b) => b.dataset.plan === String(currentPlan));
      const tag = pl?.querySelector('.plan-seg-tag')?.textContent || 'Pay now';
      planMethod.textContent = currentPlan <= 1
        ? 'One transaction at the store of your choice. Every linked store accepts a single card or PayPal payment.'
        : tag + ': the first payment leaves your account at checkout, and the rest follow on the schedule the provider sets. No interest when each payment arrives on time.';
    }
  }

  function rowEnabled(row: HTMLElement): boolean {
    const toggle = row.querySelector<HTMLInputElement>('.include-toggle');
    if (toggle) return toggle.checked;
    return true;
  }

  function qtyOf(row: HTMLElement): number {
    const input = row.querySelector<HTMLInputElement>('.qty-input');
    const qty = Math.max(0, parseInt(input?.value || '1', 10) || 0);
    // Essential parts can never be zero: they are required for the build
    if (row.dataset.essential === 'true') return Math.max(1, qty);
    return qty;
  }

  function updateTotals(announce = false) {
    let total = 0;
    let essentials = 0;
    rows.forEach((r) => {
      const row = document.getElementById(r.id) as HTMLElement | null;
      if (!row) return;
      const enabled = rowEnabled(row);
      const qty = qtyOf(row);
      const line = r.price * qty;
      total += enabled ? line : 0;
      if (r.essential) essentials += line;
      const totalEl = row.querySelector('.comp-total');
      if (totalEl) totalEl.textContent = '$' + line.toFixed(2);
      row.classList.toggle('is-dropped', !enabled || qty === 0);
    });

    if (componentsTotal) componentsTotal.textContent = '$' + total.toFixed(2);
    if (essentialTotalEl) essentialTotalEl.textContent = '$' + essentials.toFixed(2);
    if (grandTotal) grandTotal.textContent = '$' + total.toFixed(2);
    if (budgetDisplay) budgetDisplay.textContent = '$' + (slider?.value || '30');
    const budgetMin = document.getElementById('budget-min');
    if (budgetMin) budgetMin.textContent = '$' + essentials.toFixed(2);

    if (budgetStatus) {
      const budget = parseInt(slider?.value || '30', 10);
      const over = total - budget;
      if (total <= budget) {
        budgetStatus.textContent = 'Within budget';
        budgetStatus.className = 'budget-status budget-ok';
      } else {
        budgetStatus.textContent = 'Over budget by $' + over.toFixed(2);
        budgetStatus.className = 'budget-status budget-over';
      }
    }

    renderFitPanel();
    refreshPhases();
    renderPlan();
    if (announce) {
      const total = (grandTotal?.textContent || '').replace('$', '');
      const live = document.getElementById('aria-live');
      if (live) live.textContent = 'New total: $' + total;
    }
  }

  function renderFitPanel() {
    const budget = parseInt(slider?.value || '30', 10);
    const total = rows.reduce((sum, r) => {
      const row = document.getElementById(r.id) as HTMLElement | null;
      if (!row || !rowEnabled(row)) return sum;
      return sum + r.price * qtyOf(row);
    }, 0);
    const over = total - budget;
    const optional = rows.filter((r) => !r.essential);
    const optionalTotal = optional.reduce((s, r) => {
      const row = document.getElementById(r.id) as HTMLElement | null;
      if (!row || !rowEnabled(row)) return s;
      return s + r.price * qtyOf(row);
    }, 0);

    if (!fitPanel || !fitText || !fitList) return;
    if (over <= 0) {
      fitPanel.hidden = true;
      fitList.innerHTML = '';
      return;
    }
    fitPanel.hidden = false;
    fitText.innerHTML = '';

    const p1 = document.createElement('span');
    p1.textContent = 'Over budget by ';
    const b = document.createElement('strong');
    b.textContent = '$' + over.toFixed(2);
    fitText.appendChild(p1);
    fitText.appendChild(b);

    if (optionalTotal >= over) {
      const p2 = document.createElement('span');
      p2.textContent = '. Drop the optional extras below to stay inside it.';
      fitText.appendChild(p2);
      const list = document.createElement('ul');
      optional.forEach((r) => {
        const row = document.getElementById(r.id) as HTMLElement | null;
        if (!row || !rowEnabled(row)) return;
        const li = document.createElement('li');
        li.textContent = r.name + ' (saves $' + (r.price * qtyOf(row)).toFixed(2) + ')';
        list.appendChild(li);
      });
      fitList.innerHTML = '';
      fitList.appendChild(list);
      if (autoFitBtn) autoFitBtn.hidden = false;
    } else {
      const p2 = document.createElement('span');
      p2.textContent = '. Even after dropping every optional extra, essentials cost $'
        + (total - optionalTotal).toFixed(2)
        + '. Raise the budget or compare prices on the links below.';
      fitText.appendChild(p2);
      fitList.innerHTML = '';
      if (autoFitBtn) autoFitBtn.hidden = true;
    }
  }

  function autoFit() {
    const budget = parseInt(slider?.value || '30', 10);
    const dropOrder = rows
      .filter((r) => !r.essential)
      .sort((a, b) => {
        const ra = document.getElementById(a.id) as HTMLElement | null;
        const rb = document.getElementById(b.id) as HTMLElement | null;
        const va = ra && rowEnabled(ra) ? a.price * qtyOf(ra) : 0;
        const vb = rb && rowEnabled(rb) ? b.price * qtyOf(rb) : 0;
        return vb - va;
      });

    for (const r of dropOrder) {
      const row = document.getElementById(r.id) as HTMLElement | null;
      if (!row) continue;
      const total = rows.reduce((sum, rr) => {
        const row2 = document.getElementById(rr.id) as HTMLElement | null;
        if (!row2 || !rowEnabled(row2)) return sum;
        return sum + rr.price * qtyOf(row2);
      }, 0);
      if (total <= budget) break;
      const toggle = row.querySelector<HTMLInputElement>('.include-toggle');
      if (toggle) toggle.checked = false;
    }
    updateTotals(true);
  }

  slider?.addEventListener('input', () => updateTotals());
  document.querySelectorAll('.qty-input').forEach((input) =>
    input.addEventListener('change', () => updateTotals(true))
  );
  document.querySelectorAll('.include-toggle').forEach((input) =>
    input.addEventListener('change', () => updateTotals(true))
  );
  autoFitBtn?.addEventListener('click', autoFit);
  planButtons.forEach((b) =>
    b.addEventListener('click', () => {
      currentPlan = parseInt(b.dataset.plan || '1', 10);
      renderPlan();
    })
  );
  updateTotals();
</script>

