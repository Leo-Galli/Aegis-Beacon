---
import Layout from '../layouts/Layout.astro';
---

<Layout title="BOM Builder | Aegis-Beacon" description="Interactive Bill of Materials calculator for Aegis-Beacon">
  <div class="builder-page">
    <div class="builder-header">
      <h1>BOM Builder</h1>
      <p>Calculate the total cost of your Aegis-Beacon build. Adjust quantities and see real-time pricing.</p>
    </div>

    <div class="builder-container">
      <!-- Budget Slider -->
      <div class="budget-card">
        <div class="budget-label">Target Budget</div>
        <div class="budget-value" id="budget-display">$30</div>
        <input type="range" id="budget-slider" min="15" max="60" value="30" class="budget-slider">
        <div class="budget-range">
          <span>$15</span>
          <span>$60</span>
        </div>
      </div>

      <!-- Components List -->
      <div class="components-list">
        <div class="component-header">
          <span>Component</span>
          <span>Source</span>
          <span>Price</span>
          <span>Qty</span>
          <span>Total</span>
        </div>

        <div class="component" data-price="8.50" data-qty="1">
          <div class="comp-info">
            <strong>ESP32-WROOM-32</strong>
            <span>Dual-Core MCU with WiFi/BT</span>
          </div>
          <div class="comp-source">AliExpress</div>
          <div class="comp-price">$8.50</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$8.50</div>
        </div>

        <div class="component" data-price="5.20" data-qty="1">
          <div class="comp-info">
            <strong>E22-400M30S</strong>
            <span>SX1262 LoRa Module +30dBm</span>
          </div>
          <div class="comp-source">AliExpress</div>
          <div class="comp-price">$5.20</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$5.20</div>
        </div>

        <div class="component" data-price="3.80" data-qty="1">
          <div class="comp-info">
            <strong>SSD1309 OLED 2.42"</strong>
            <span>I2C 128x64 Display</span>
          </div>
          <div class="comp-source">AliExpress</div>
          <div class="comp-price">$3.80</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$3.80</div>
        </div>

        <div class="component" data-price="2.90" data-qty="1">
          <div class="comp-info">
            <strong>NEO-6M GPS</strong>
            <span>UART GPS Module</span>
          </div>
          <div class="comp-source">AliExpress</div>
          <div class="comp-price">$2.90</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$2.90</div>
        </div>

        <div class="component" data-price="0.80" data-qty="1">
          <div class="comp-info">
            <strong>TP4056 Charger</strong>
            <span>Li-Ion USB-C Charging Board</span>
          </div>
          <div class="comp-source">AliExpress</div>
          <div class="comp-price">$0.80</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$0.80</div>
        </div>

        <div class="component" data-price="2.50" data-qty="1">
          <div class="comp-info">
            <strong>18650 Battery</strong>
            <span>3.7V 3000mAh Li-Ion Cell</span>
          </div>
          <div class="comp-source">Local Store</div>
          <div class="comp-price">$2.50</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$2.50</div>
        </div>

        <div class="component" data-price="1.20" data-qty="1">
          <div class="comp-info">
            <strong>SMA Connector + Antenna</strong>
            <span>433MHz Rubber Duck Antenna</span>
          </div>
          <div class="comp-source">AliExpress</div>
          <div class="comp-price">$1.20</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$1.20</div>
        </div>

        <div class="component" data-price="0.60" data-qty="4">
          <div class="comp-info">
            <strong>Tactile Switches</strong>
            <span>6x6mm Momentary Push Button</span>
          </div>
          <div class="comp-source">AliExpress</div>
          <div class="comp-price">$0.15</div>
          <div class="comp-qty">
            <input type="number" value="4" min="0" max="20" class="qty-input">
          </div>
          <div class="comp-total">$0.60</div>
        </div>

        <div class="component" data-price="0.40" data-qty="1">
          <div class="comp-info">
            <strong>Passive Buzzer</strong>
            <span>3V Piezo Buzzer</span>
          </div>
          <div class="comp-source">AliExpress</div>
          <div class="comp-price">$0.40</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$0.40</div>
        </div>

        <div class="component" data-price="0.30" data-qty="1">
          <div class="comp-info">
            <strong>Resistors & Capacitors</strong>
            <span>Passive Components Kit</span>
          </div>
          <div class="comp-source">Local Store</div>
          <div class="comp-price">$0.30</div>
          <div class="comp-qty">
            <input type="number" value="1" min="0" max="10" class="qty-input">
          </div>
          <div class="comp-total">$0.30</div>
        </div>
      </div>

      <!-- Total -->
      <div class="total-card">
        <div class="total-row">
          <span>Components Total</span>
          <span id="components-total">$26.20</span>
        </div>
        <div class="total-row">
          <span>Enclosure (3D Print)</span>
          <span>$2.00</span>
        </div>
        <div class="total-row grand">
          <span>Grand Total</span>
          <span id="grand-total">$28.20</span>
        </div>
        <div class="budget-status" id="budget-status">
          Within budget
        </div>
      </div>
    </div>
  </div>

  <script>
    const slider = document.getElementById('budget-slider') as HTMLInputElement;
    const budgetDisplay = document.getElementById('budget-display');
    const componentsTotal = document.getElementById('components-total');
    const grandTotal = document.getElementById('grand-total');
    const budgetStatus = document.getElementById('budget-status');
    const qtyInputs = document.querySelectorAll('.qty-input');

    function updateTotals() {
      let total = 0;
      document.querySelectorAll('.component').forEach(comp => {
        const price = parseFloat(comp.dataset.price || '0');
        const qtyInput = comp.querySelector('.qty-input') as HTMLInputElement;
        const qty = parseInt(qtyInput?.value || '1');
        const compTotal = price * qty;
        total += compTotal;
        const totalEl = comp.querySelector('.comp-total');
        if (totalEl) totalEl.textContent = '$' + compTotal.toFixed(2);
      });

      const grand = total + 2.00;
      if (componentsTotal) componentsTotal.textContent = '$' + total.toFixed(2);
      if (grandTotal) grandTotal.textContent = '$' + grand.toFixed(2);

      const budget = parseInt(slider?.value || '30');
      if (budgetDisplay) budgetDisplay.textContent = '$' + budget;

      if (budgetStatus) {
        if (grand <= budget) {
          budgetStatus.textContent = 'Within budget';
          budgetStatus.className = 'budget-status ok';
        } else {
          budgetStatus.textContent = 'Over budget by $' + (grand - budget).toFixed(2);
          budgetStatus.className = 'budget-status over';
        }
      }
    }

    slider?.addEventListener('input', updateTotals);
    qtyInputs.forEach(input => {
      input.addEventListener('change', updateTotals);
    });
    updateTotals();
  </script>
</Layout>

<style>
  .builder-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .builder-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .builder-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .builder-header p { color: var(--text-secondary); }

  .budget-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .budget-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .budget-value {
    font-size: 2rem;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text);
    margin-bottom: 1rem;
  }
  .budget-slider {
    width: 100%;
    -webkit-appearance: none;
    height: 6px;
    border-radius: 3px;
    background: var(--border);
  }
  .budget-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    background: #f97316;
    border-radius: 50%;
    cursor: pointer;
  }
  .budget-range {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .components-list {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .component-header {
    display: grid;
    grid-template-columns: 2fr 1fr 0.7fr 0.5fr 0.7fr;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--border-subtle);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-bottom: 1px solid var(--border);
  }
  .component {
    display: grid;
    grid-template-columns: 2fr 1fr 0.7fr 0.5fr 0.7fr;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.8125rem;
  }
  .component:last-child { border-bottom: none; }
  .comp-info strong { display: block; font-weight: 600; }
  .comp-info span { font-size: 0.75rem; color: var(--text-muted); }
  .comp-source { font-size: 0.75rem; color: var(--text-muted); }
  .comp-price { font-family: 'JetBrains Mono', monospace; font-size: 0.8125rem; }
  .qty-input {
    width: 100%;
    padding: 0.375rem;
    font-size: 0.8125rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    color: var(--text);
    text-align: center;
  }
  .comp-total {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    text-align: right;
  }

  .total-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
  }
  .total-row {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  .total-row.grand {
    border-top: 1px solid var(--border);
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
  }
  .budget-status {
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-top: 0.75rem;
    padding: 0.5rem;
    border-radius: 6px;
  }
  .budget-status.ok { background: #f0fdf4; color: #166534; }
  .budget-status.over { background: #fef2f2; color: #991b1b; }
  .dark .budget-status.ok { background: rgba(34,197,94,0.1); color: #86efac; }
  .dark .budget-status.over { background: rgba(239,68,68,0.1); color: #fca5a5; }

  @media (max-width: 640px) {
    .component-header { display: none; }
    .component {
      grid-template-columns: 1fr auto;
      gap: 0.75rem;
    }
    .comp-source, .comp-price { display: none; }
  }
</style>
