  let repeaters: Repeater[] = [];
  let markers = new Map<number, L.Marker>();
  let activeBand = 'all';
  let userPos: [number, number] | null = null;
  let userMarker: L.CircleMarker | null = null;
  let userRadiusCircle: L.Circle | null = null;

  function parseFreqs(raw: string): number[] {
    if (!raw) return [];
    const out: number[] = [];
    for (const part of raw.split(/[;,]+/)) {
      const m = part.trim().match(/(\d+(?:\.\d+)?)/);
      if (!m) continue;
      let v = parseFloat(m[1]);
      if (v >= 1_000_000) v = v / 1_000_000;
      if (v >= 25 && v <= 2000) out.push(v);
    }
    return [...new Set(out)];
  }

  function bandOf(mhz: number): string {
    if (mhz >= 50 && mhz < 55) return '6m';
    if (mhz >= 144 && mhz < 148) return '2m';
    if (mhz >= 430 && mhz < 440) return '70cm';
    if (mhz >= 1240 && mhz < 1300) return '23cm';
    return 'other';
  }

  function fmtFreq(mhz: number): string {
    return mhz >= 1000 ? mhz.toFixed(3) : mhz.toFixed(mhz % 1 === 0 ? 0 : mhz < 100 ? 4 : 3);
  }

  function haversine(a: [number, number], b: [number, number]): number {
    const R = 6371;
    const dLat = ((b[0] - a[0]) * Math.PI) / 180;
    const dLon = ((b[1] - a[1]) * Math.PI) / 180;
    const la1 = (a[0] * Math.PI) / 180;
    const la2 = (b[0] * Math.PI) / 180;
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(la1) * Math.cos(la2) * Math.sin(dLon / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  }

  function esc(s: string): string {
    return (s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function setStatus(msg: string, busy = false) {
    const el = document.getElementById('repeaters-status');
    if (el) {
      el.textContent = msg;
      el.classList.toggle('is-busy', busy);
    }
  }

  const iconFor = (band: string) =>
    L.divIcon({
      className: 'repeaters-pin-wrap',
      html: `<span class="repeaters-pin" style="--pin:${BAND_COLORS[band] || BAND_COLORS.other}"></span>`,
      iconSize: [20, 20],
      iconAnchor: [10, 10],
    });

  function renderMarkers() {
    for (const m of markers.values()) m.remove();
    markers.clear();
    for (const r of repeaters) {
      if (activeBand !== 'all' && !r.bands.includes(activeBand)) continue;
      const mainBand = r.bands[0] || 'other';
      const mk = L.marker([r.lat, r.lon], { icon: iconFor(mainBand) })
        .addTo(map)
        .bindPopup(popupHtml(r));
      mk.on('click', () => highlightRow(r.id));
      markers.set(r.id, mk);
    }
    const count = markers.size;
    const el = document.getElementById('repeaters-count');
    if (el) el.textContent = String(count);
    const emptyEl = document.getElementById('repeaters-empty');
    if (emptyEl) emptyEl.hidden = count > 0;
  }

  function popupHtml(r: Repeater): string {
    const freqLines = r.freqs.length
      ? r.freqs
          .map(
            (f) =>
              `<li>${fmtFreq(f)} MHz <span class="repeaters-popup-band">${BAND_LABEL[bandOf(f)]}</span></li>`
          )
          .join('')
      : '<li>frequency not mapped</li>';
    const where = r.distKm !== undefined ? ` &middot; ${r.distKm.toFixed(1)} km away` : '';
    const toneLine = r.tone ? `<div class="repeaters-popup-tone">Tone: <strong>${esc(r.tone)}</strong></div>` : '';
    const name = r.name ? `<span class="repeaters-popup-name">${esc(r.name)}</span>` : '';
    return `
      <div class="repeaters-popup">
        <strong>${esc(r.callsign || 'Unknown callsign')}</strong>
        ${name}
        <ul>${freqLines}</ul>
        ${toneLine}
        <span class="repeaters-popup-meta">${r.lat.toFixed(4)}, ${r.lon.toFixed(4)}${where}</span>
      </div>`;
  }

  function highlightRow(id: number) {
    const row = document.querySelector(`[data-id="${id}"]`);
    if (row) {
      row.classList.add('is-flash');
      setTimeout(() => row.classList.remove('is-flash'), 900);
      row.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
  }

  function renderList() {
    const list = document.getElementById('repeaters-list');
    if (!list) return;
    list.innerHTML = '';
    let visible = repeaters.filter((r) => activeBand === 'all' || r.bands.includes(activeBand));
    if (userPos) {
      visible = [...visible].sort((a, b) => (a.distKm ?? 1e9) - (b.distKm ?? 1e9));
    } else {
      visible = [...visible].sort((a, b) => (a.callsign || '').localeCompare(b.callsign || ''));
    }
    if (visible.length === 0) {
      renderMarkers();
      return;
    }
    for (const r of visible) {
      const row = document.createElement('button');
      row.type = 'button';
      row.className = 'repeaters-item';
      row.dataset.id = String(r.id);
      const toneBadge = r.tone ? `<span class="repeaters-item__tone">${esc(r.tone)}</span>` : '';
      row.innerHTML = `
        <span class="repeaters-item__pin" style="--pin:${BAND_COLORS[r.bands[0] || 'other']}"></span>
        <span class="repeaters-item__main">
          <strong>${esc(r.callsign || 'Repeater')} ${toneBadge}</strong>
          <span class="repeaters-item__name">${esc(r.name || 'Amateur radio repeater')}</span>
        </span>
        <span class="repeaters-item__freqs">${r.freqs.map((f) => `<code>${fmtFreq(f)}</code>`).join('')}</span>
        <span class="repeaters-item__dist">${r.distKm !== undefined ? `${r.distKm.toFixed(1)} km` : ''}</span>
      `;
      row.addEventListener('click', () => {
        map.setView([r.lat, r.lon], Math.max(map.getZoom(), 12), { animate: true });
        markers.get(r.id)?.openPopup();
      });
      list.appendChild(row);
    }
    renderMarkers();
  }

  function getCatalogRepeatersInBounds(s: number, w: number, n: number, e: number): Repeater[] {
    return CATALOG.filter((item) => item.lat >= s && item.lat <= n && item.lon >= w && item.lon <= e).map(
      (item, index) => {
        const bands = [...new Set(item.freqs.map(bandOf))];
        return {
          id: 800000000 + index,
          lat: item.lat,
          lon: item.lon,
          callsign: item.callsign,
          name: item.name,
          freqs: item.freqs,
          bands,
          tone: item.tone,
          distKm: userPos ? haversine(userPos, [item.lat, item.lon]) : undefined,
          isLive: false,
        };
      }
    );
  }

  function getClosestCatalogRepeaters(center: [number, number], limit = 15, maxDistanceKm = 180): Repeater[] {
    const scored = CATALOG.map((item, index) => {
      const d = haversine(center, [item.lat, item.lon]);
      return { item, index, d };
    })
      .filter((entry) => entry.d <= maxDistanceKm)
      .sort((a, b) => a.d - b.d)
      .slice(0, limit);

    return scored.map(({ item, index, d }) => ({
      id: 800000000 + index,
      lat: item.lat,
      lon: item.lon,
      callsign: item.callsign,
      name: item.name,
      freqs: item.freqs,
      bands: [...new Set(item.freqs.map(bandOf))],
      tone: item.tone,
      distKm: d,
      isLive: false,
    }));
  }

  const OVERPASS_ENDPOINTS = [
    'https://overpass-api.de/api/interpreter',
    'https://overpass.private.coffee/api/interpreter',
    'https://maps.mail.ru/osm/tools/overpass/api/interpreter',
  ];

  async function fetchLiveOverpass(bbox: string): Promise<any[]> {
    const query = `[out:json][timeout:12];(node["communication:amateur_radio:repeater"](${bbox});node["communication:amateur_radio"="repeater"](${bbox});node["amateur_radio"="repeater"](${bbox}););out body 250;`;

    for (const ep of OVERPASS_ENDPOINTS) {
      try {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 6000);
        const res = await fetch(ep, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: 'data=' + encodeURIComponent(query),
          signal: ctrl.signal,
        });
        clearTimeout(timer);
        if (!res.ok) continue;
        const data = await res.json();
        if (data && Array.isArray(data.elements)) {
          return data.elements;
        }
      } catch {
        // try GET on same mirror before moving to next
        try {
          const ctrl = new AbortController();
          const timer = setTimeout(() => ctrl.abort(), 5000);
          const getRes = await fetch(ep + '?data=' + encodeURIComponent(query), { signal: ctrl.signal });
          clearTimeout(timer);
          if (getRes.ok) {
            const data = await getRes.json();
            if (data && Array.isArray(data.elements)) {
              return data.elements;
            }
          }
        } catch {
          // move to next mirror
        }
      }
    }
    return [];
  }

  async function searchArea(silent = false) {
    const bounds = map.getBounds();
    const south = bounds.getSouth();
    const west = bounds.getWest();
    const north = bounds.getNorth();
    const east = bounds.getEast();
    const center: [number, number] = [map.getCenter().lat, map.getCenter().lng];
    const bbox = `${south},${west},${north},${east}`;

    if (!silent) setStatus('Searching repeaters in this area...', true);

    // 1. Get verified database repeaters in current bounds
    let catalogResults = getCatalogRepeatersInBounds(south, west, north, east);

    // 2. Fetch live OpenStreetMap data asynchronously with timeout
    let liveElements: any[] = [];
    try {
      liveElements = await fetchLiveOverpass(bbox);
    } catch {
      liveElements = [];
    }

    const merged = new Map<string, Repeater>();

    // Add catalog items first
    for (const item of catalogResults) {
      const key = item.callsign ? item.callsign.toUpperCase() : `${item.lat.toFixed(3)},${item.lon.toFixed(3)}`;
      merged.set(key, item);
    }

    // Merge live OSM nodes
    for (const el of liveElements) {
      const t = el.tags || {};
      const freqKeys = Object.keys(t).filter((k) => k.includes('freq') || k.includes('frequency'));
      const rawFreqs = freqKeys.map((k) => t[k]).join(';');
      const freqs = parseFreqs(rawFreqs);
      const callsign = (
        t['communication:amateur_radio:callsign'] ||
        t['communication:amateur_radio:repeater:callsign'] ||
        t.callsign ||
        t.ref ||
        ''
      ).trim();
      const name = (t.name || t['communication:amateur_radio:name'] || t.description || '').trim();
      const tone = (
        t['communication:amateur_radio:repeater:ctcss'] ||
        t['ctcss'] ||
        t['tone'] ||
        ''
      ).trim();

      if (!freqs.length && !callsign && !name) continue;

      const key = callsign ? callsign.toUpperCase() : `${el.lat.toFixed(3)},${el.lon.toFixed(3)}`;
      const existing = merged.get(key);

      if (existing) {
        if (!existing.freqs.length && freqs.length) {
          existing.freqs = freqs;
          existing.bands = [...new Set(freqs.map(bandOf))];
        }
        if (!existing.tone && tone) existing.tone = tone;
      } else {
        const bands = freqs.length ? [...new Set(freqs.map(bandOf))] : ['other'];
        merged.set(key, {
          id: el.id,
          lat: el.lat,
          lon: el.lon,
          callsign: callsign || name || 'Repeater',
          name: name || 'Amateur radio repeater',
          freqs,
          bands,
          tone,
          distKm: userPos ? haversine(userPos, [el.lat, el.lon]) : haversine(center, [el.lat, el.lon]),
          isLive: true,
        });
      }
    }

    let finalRepeaters = [...merged.values()];

    // If zero repeaters found in view (user zoomed in too close or off-grid spot),
    // automatically find the closest repeaters within 120 km from map center
    if (finalRepeaters.length === 0) {
      const fallback = getClosestCatalogRepeaters(center, 12, 160);
      if (fallback.length > 0) {
        finalRepeaters = fallback;
        setStatus(
          `No repeaters in this tight view - displaying ${fallback.length} nearest repeaters within range`
        );
      } else {
        setStatus('No repeaters in this area. Zoom out or search for a city.');
      }
    } else {
      setStatus(
        `${finalRepeaters.length} repeater${finalRepeaters.length === 1 ? '' : 's'} available in view` +
          (userPos ? ' (sorted by distance from you)' : '')
      );
    }

    repeaters = finalRepeaters;
    renderList();
  }

  async function locateUser() {
    setStatus('Requesting your position...', true);
    try {
      const pos = await new Promise<GeolocationPosition>((resolve, reject) => {
        if (!('geolocation' in navigator)) reject(new Error('Geolocation unsupported'));
        else
          navigator.geolocation.getCurrentPosition(resolve, reject, {
            enableHighAccuracy: true,
            timeout: 12000,
            maximumAge: 300000,
          });
      });

      userPos = [pos.coords.latitude, pos.coords.longitude];

      if (userMarker) userMarker.remove();
      if (userRadiusCircle) userRadiusCircle.remove();

      userRadiusCircle = L.circle(userPos, {
        radius: 20000,
        className: 'repeaters-user-radius',
      }).addTo(map);

      userMarker = L.circleMarker(userPos, {
        radius: 8,
        fillColor: '#3b82f6',
        fillOpacity: 1,
        color: '#ffffff',
        weight: 2,
      }).addTo(map).bindPopup('<strong>Your Location</strong>');

      map.setView(userPos, 10, { animate: true });
      await searchArea();
    } catch (err) {
      console.warn('Geolocation failed, keeping current view:', err);
      setStatus('Could not retrieve GPS position. You can search by city name or click "Search this area".');
      searchArea(true);
    }
  }

  async function handleSearch(query: string) {
    const q = query.trim().toLowerCase();
    if (!q) return;

    setStatus(`Searching for "${query}"...`, true);

    // 1. Direct match with repeater callsign
    const exactMatch = CATALOG.find((r) => r.callsign.toLowerCase() === q);
    if (exactMatch) {
      map.setView([exactMatch.lat, exactMatch.lon], 13, { animate: true });
      await searchArea();
      const matchInList = repeaters.find((r) => r.callsign.toLowerCase() === q);
      if (matchInList) {
        markers.get(matchInList.id)?.openPopup();
        highlightRow(matchInList.id);
      }
      return;
    }

    // 2. Check local city dictionary
    const normKey = q.replace(/[^a-z]/g, '');
    if (QUICK_CITIES[normKey]) {
      const coords = QUICK_CITIES[normKey];
      map.setView(coords, 11, { animate: true });
      await searchArea();
      return;
    }

    // 3. Fallback to OpenStreetMap Nominatim geocoding
    try {
      const res = await fetch(
        `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1`
      );
      if (res.ok) {
        const results = await res.json();
        if (Array.isArray(results) && results.length > 0) {
          const lat = parseFloat(results[0].lat);
          const lon = parseFloat(results[0].lon);
          map.setView([lat, lon], 11, { animate: true });
          await searchArea();
          return;
        }
      }
    } catch (e) {
      console.warn('Nominatim geocoding error:', e);
    }

    // 4. If geocoding had no results, search inside repeater names
    const nameMatch = CATALOG.find((r) => r.name.toLowerCase().includes(q));
    if (nameMatch) {
      map.setView([nameMatch.lat, nameMatch.lon], 11, { animate: true });
      await searchArea();
      return;
    }

    setStatus(`No location found for "${query}". Try another city name or pan the map.`);
  }

  // Event Listeners
  document.getElementById('locate-btn')?.addEventListener('click', locateUser);
  document.getElementById('reload-btn')?.addEventListener('click', () => searchArea());

  const searchForm = document.getElementById('search-form');
  const searchInput = document.getElementById('city-search') as HTMLInputElement;

  searchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (searchInput) handleSearch(searchInput.value);
  });

  document.getElementById('city-search-btn')?.addEventListener('click', () => {
    if (searchInput) handleSearch(searchInput.value);
  });

  for (const btn of document.querySelectorAll<HTMLButtonElement>('.repeaters-filter')) {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.repeaters-filter').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      activeBand = btn.dataset.band || 'all';
      renderList();
    });
  }

  // Initial load
  searchArea(true);
</script>

